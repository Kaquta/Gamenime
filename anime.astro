---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroHeader from "../components/HeroHeader.astro";
import SectionBlock from "../components/SectionBlock.astro";
import Footer from "../components/Footer.astro";
import { getAnimeItems } from "../lib/api";
import { sortByDateDesc } from "../lib/utils";

const animeItems = sortByDateDesc(await getAnimeItems());
---

<BaseLayout title="GameNime — Anime">
  <HeroHeader activeTab="anime" />
  <SectionBlock title="Derniers animés" items={animeItems} />
  <Footer />
</BaseLayout>
