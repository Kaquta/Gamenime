services:
  mariadb:
    image: mariadb:11
    container_name: mariadb
    restart: unless-stopped
    environment:
      TZ: ${TZ}
      MARIADB_ROOT_PASSWORD: ${Rndblouxix7db.}
      MARIADB_DATABASE: ${GAMENIME}
      MARIADB_USER: ${kaqutadb}
      MARIADB_PASSWORD: ${Rndblouxix7db.}
    volumes:
      - ./mariadb/data:/var/lib/mysql
    networks: [internal]

  anime-api:
    build: ./anime-api
    container_name: anime-api
    restart: unless-stopped
    environment:
      DB_HOST: mariadb
      DB_NAME: ${MARIADB_DATABASE=Anime}
      DB_USER: ${=kaqutadb}
      DB_PASS: ${Rndblouxix7db.}
      API_KEY: ${oNEHBdN8L5vWDkd490fb1BWtlsecFdeatK9pUFCR}
      PORT: 3001
    depends_on: [mariadb]
    networks: [internal]

  games-api:
    build: ./games-api
    container_name: games-api
    restart: unless-stopped
    environment:
      DB_HOST: mariadb
      DB_NAME: ${MARIADB_GAMES}
      DB_USER: ${kaqutadb}
      DB_PASS: ${Rndblouxix7db.}
      API_KEY: ${67ffb7c43c2545c08235c01cce45246d}
      PORT: 3002
    depends_on: [mariadb]
    networks: [internal]

  n8n:
    image: n8nio/n8n:latest
    container_name: n8n
    restart: unless-stopped
    environment:
      - TZ=${TZ}
      - N8N_HOST=staging.gamenime.fr
      - N8N_PROTOCOL=https
      - N8N_PORT=5678
      - N8N_PATH=/n8n/
      - WEBHOOK_URL=https://staging.gamenime.fr/n8n/
      - N8N_PROXY_HOPS=1
      - N8N_BASIC_AUTH_ACTIVE=true
      - N8N_BASIC_AUTH_USER=${kaqutan8n}
      - N8N_BASIC_AUTH_PASSWORD=${Rndblouxix7n8n.}
      - N8N_ENCRYPTION_KEY=${4388ff67de81a78e0ddc12ef01bd77c14a32cb343699651e97cb59df5ea2ed4d}
    volumes:
      - ./n8n/data:/home/node/.n8n
    networks: [internal]

  web:
    image: nginx:alpine
    container_name: web
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./nginx/conf.d:/etc/nginx/conf.d:ro
      - ./nginx/htpasswd:/etc/nginx/htpasswd:ro
      - ./nginx/static:/etc/nginx/static:ro
      - ./site/dist:/usr/share/nginx/html:ro
      - ./certbot/www:/var/www/certbot:ro
      - ./certbot/conf:/etc/letsencrypt:ro
    depends_on: [anime-api, games-api, n8n]
    networks: [internal, public]

  certbot:
    image: certbot/certbot
    container_name: certbot
    volumes:
      - ./certbot/www:/var/www/certbot
      - ./certbot/conf:/etc/letsencrypt
    entrypoint: sh -c "trap exit TERM; while :; do sleep 12h & wait $${!}; certbot renew; done"
    networks: [public]

networks:
  public:
  internal:
    internal: true
