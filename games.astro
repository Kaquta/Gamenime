---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroHeader from "../components/HeroHeader.astro";
import SectionBlock from "../components/SectionBlock.astro";
import Footer from "../components/Footer.astro";
import { getGameItems } from "../lib/api";
import { sortByDateDesc } from "../lib/utils";

const gameItems = sortByDateDesc(await getGameItems());
---

<BaseLayout title="GameNime — Jeux">
  <HeroHeader activeTab="games" />
  <SectionBlock title="Derniers jeux vidéo" items={gameItems} />
  <Footer />
</BaseLayout>
