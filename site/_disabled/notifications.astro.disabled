---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroHeader from "../components/HeroHeader.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout title="Notifications — GameNime">
  <HeroHeader />

  <div class="notif-page container">
    <div class="notif-page__header">
      <h2 class="notif-page__title"><svg class="pg-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9M13.7 21a2 2 0 0 1-3.4 0"/></svg>Notifications</h2>
      <div class="nt-acts" style="margin:0;max-width:380px">
        <button id="notifPageReadAll" class="nt-act" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Tout marquer lu</button>
        <button id="notifPageDelRead" class="nt-act nt-act--del" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>Supprimer les lus <span class="nt-n" id="notifPageNRead"></span></button>
      </div>
    </div>
    <p class="notif-page__count" id="notifPageCount"></p>

    <div id="notifPageNotLogged" class="notif-page__empty hidden">
      <p>Connecte-toi pour voir tes notifications</p>
      <a href="/signin" class="auth-card__btn" style="display:inline-block;text-align:center;text-decoration:none;max-width:240px;">Se connecter</a>
    </div>

    <div id="notifPageLoading" class="notif-page__empty">
      <p>Chargement...</p>
    </div>

    <div id="notifPageEmpty" class="notif-page__empty hidden">
      <p>Aucune notification pour le moment.</p>
      <p>Ajoute des anime ou jeux en favoris pour recevoir des alertes !</p>
    </div>

    <div id="notifPageList" class="notif-page__list"></div>
  </div>

  <Footer />
</BaseLayout>

<script>
  var apiBase = "/api";
  var pageList = document.getElementById("notifPageList");
  var pageLoading = document.getElementById("notifPageLoading");
  var pageEmpty = document.getElementById("notifPageEmpty");
  var pageNotLogged = document.getElementById("notifPageNotLogged");
  var pageCount = document.getElementById("notifPageCount");
  var pageReadAll = document.getElementById("notifPageReadAll");

  function escapeHtml(v) {
    return String(v).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  }

  function timeAgo(dateStr) {
    if (!dateStr) return "";
    var now = new Date();
    var d = new Date(dateStr);
    var diff = Math.floor((now.getTime() - d.getTime()) / 1000);
    if (diff < 60) return "À l'instant";
    if (diff < 3600) return Math.floor(diff / 60) + " min";
    if (diff < 86400) return Math.floor(diff / 3600) + "h";
    if (diff < 604800) return Math.floor(diff / 86400) + "j";
    return new Intl.DateTimeFormat("fr-FR", { day: "2-digit", month: "short", year: "numeric" }).format(d);
  }

  function eventIcon(eventType) {
    // Pastille typee, alignee sur le tiroir et la cloche.
    var s = String(eventType || "");
    var d, c;
    if (s.indexOf("platform") !== -1) { c = "plat"; d = '<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>'; }
    else if (s.indexOf("trailer") !== -1) { c = "trail"; d = '<circle cx="12" cy="12" r="9"/><path d="m10 8 6 4-6 4Z"/>'; }
    else if (s.indexOf("release_date") !== -1) { c = "date"; d = '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18"/>'; }
    else if (s.indexOf("episode") !== -1) { c = "ep"; d = '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="M2 9h20M7 4v5M17 4v5"/>'; }
    else { c = "def"; d = '<path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9M13.7 21a2 2 0 0 1-3.4 0"/>'; }
    return '<span class="ev-badge ev-' + c + '"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' + d + '</svg></span>';
  }

  function eventLabel(item) {
    var p = item.payload || {};
    var title = p.title || "Mise à jour";
    var label = p.label || item.eventType;
    var detail = p.newValue || "";
    return { title: title, label: label, detail: detail };
  }

  function renderNotifCard(item) {
    // Hierarchie inversee : le titre de l'oeuvre passe devant le motif.
    // Sur six alertes du meme lot, on lit ce qui distingue avant ce qui se repete.
    var p = item.payload || {};
    var titre = p.title || "Mise a jour";
    var motif = p.label || item.eventType || "";
    var detail = p.newValue || "";
    var ty = typeOf(item.eventType);
    var lu = item.isRead ? " is-read" : " is-unread";
    var cov = p.cover
      ? '<span class="nt-cov"><img src="' + escapeHtml(p.cover) + '" alt="" loading="lazy" /></span>'
      : '<span class="nt-cov">\u65b0</span>';
    return '<button class="nt-row' + lu + '" data-notif-id="' + item.id + '" type="button">'
      + '<span class="nt-th">' + cov + '<span class="nt-pin t-' + ty.k + '"><svg viewBox="0 0 24 24">' + ty.d + '</svg></span></span>'
      + '<span class="nt-b"><span class="nt-t">' + escapeHtml(titre) + '</span>'
      + '<span class="nt-m"><span class="nt-tag t-' + ty.k + '">' + escapeHtml(ty.lib || motif) + '</span>'
      + (detail ? '<span class="nt-sub">' + escapeHtml(detail) + '</span>' : '') + '</span></span>'
      + '<span class="nt-w">' + timeAgo(item.eventAt || item.createdAt) + '</span>'
      + '<span class="nt-x" data-notif-id="' + item.id + '" title="Supprimer">\u2715</span>'
      + '</button>';
  }
  function typeOf(t) {
    var s = String(t || "");
    if (s.indexOf("platform") !== -1) return { k:"plat", lib:"Plateforme", d:'<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>' };
    if (s.indexOf("trailer") !== -1) return { k:"trail", lib:"Trailer", d:'<circle cx="12" cy="12" r="9"/><path d="m10 8 6 4-6 4Z"/>' };
    if (s.indexOf("release_date") !== -1) return { k:"date", lib:"Date", d:'<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18"/>' };
    if (s.indexOf("episode") !== -1) return { k:"ep", lib:"\u00c9pisode", d:'<rect x="2" y="4" width="20" height="16" rx="2"/><path d="M2 9h20M7 4v5M17 4v5"/>' };
    if (s.indexOf("new") !== -1) return { k:"new", lib:"Nouveaut\u00e9", d:'<path d="M12 5v14M5 12h14"/>' };
    return { k:"def", lib:"", d:'<path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9M13.7 21a2 2 0 0 1-3.4 0"/>' };
  }

  var notifications = [];
  var unreadCount = 0;

  async function loadNotifications() {
    try {
      var authRes = await fetch(apiBase + "/auth/me", { credentials: "include", headers: { Accept: "application/json" } });
      if (authRes.status === 401 || !authRes.ok) {
        if (pageLoading) pageLoading.classList.add("hidden");
        if (pageNotLogged) pageNotLogged.classList.remove("hidden");
        return;
      }

      var res = await fetch(apiBase + "/notifications/", { credentials: "include", headers: { Accept: "application/json" } });
      if (!res.ok) throw new Error("HTTP " + res.status);
      var data = await res.json();
      notifications = data.items || [];
      unreadCount = Number(data.unreadCount || 0);

      if (pageLoading) pageLoading.classList.add("hidden");

      if (notifications.length === 0) {
        if (pageEmpty) pageEmpty.classList.remove("hidden");
        if (pageCount) pageCount.textContent = "0 notification";
        return;
      }

      if (pageCount) pageCount.textContent = unreadCount > 0
        ? unreadCount + " non lue" + (unreadCount > 1 ? "s" : "") + " sur " + notifications.length
        : notifications.length + " notification" + (notifications.length > 1 ? "s" : "") + " — tout lu";

      if (pageList) pageList.innerHTML = notifications.map(renderNotifCard).join("");
    } catch(e) {
      console.error("Erreur notifications:", e);
      if (pageLoading) pageLoading.classList.add("hidden");
      if (pageList) pageList.innerHTML = '<p class="notif-page__empty">Erreur de chargement.</p>';
    }
  }

  // Marquer une notif comme lue
  if (pageList) pageList.addEventListener("click", async function(e) {
    var card = e.target.closest(".notif-page-card");
    if (!card) return;
    var id = Number(card.dataset.notifId || 0);
    if (id <= 0) return;
    try {
      var res = await fetch(apiBase + "/notifications/" + id + "/read", { method: "POST", credentials: "include", headers: { Accept: "application/json" } });
      if (res.ok) {
        card.classList.remove("notif-page-card--unread");
        var dot = card.querySelector(".notif-page-card__dot");
        if (dot) dot.remove();
        var wasUnread = false;
        notifications = notifications.map(function(n) {
          if (n.id === id && !n.isRead) { wasUnread = true; return Object.assign({}, n, { isRead: true }); }
          return n;
        });
        if (wasUnread && unreadCount > 0) unreadCount--;
        if (pageCount) pageCount.textContent = unreadCount > 0
          ? unreadCount + " non lue" + (unreadCount > 1 ? "s" : "") + " sur " + notifications.length
          : notifications.length + " notification" + (notifications.length > 1 ? "s" : "") + " — tout lu";
      }
    } catch(err) { console.error("Erreur read:", err); }
  });

  // Tout marquer comme lu
  if (pageReadAll) pageReadAll.addEventListener("click", async function() {
    try {
      var res = await fetch(apiBase + "/notifications/read-all", { method: "POST", credentials: "include", headers: { "Content-Type": "application/json", Accept: "application/json" }, body: JSON.stringify({}) });
      if (res.ok) {
        notifications = notifications.map(function(n) { return Object.assign({}, n, { isRead: true }); });
        unreadCount = 0;
        if (pageList) pageList.innerHTML = notifications.map(renderNotifCard).join("");
        if (pageCount) pageCount.textContent = notifications.length + " notification" + (notifications.length > 1 ? "s" : "") + " — tout lu";
        majActions();
      }
    } catch(err) { console.error("Erreur read-all:", err); }
  });

  // Suppression en masse des lues — pendant de read-all.
  var pageDelRead = document.getElementById("notifPageDelRead");
  var pageNRead = document.getElementById("notifPageNRead");
  function majActions() {
    var lus = notifications.filter(function(n){ return n.isRead; }).length;
    var nonLus = notifications.length - lus;
    if (pageReadAll) pageReadAll.disabled = nonLus === 0;
    if (pageDelRead) pageDelRead.disabled = lus === 0;
    if (pageNRead) pageNRead.textContent = lus > 0 ? "(" + lus + ")" : "";
  }
  if (pageDelRead) pageDelRead.addEventListener("click", async function() {
    try {
      var res = await fetch(apiBase + "/notifications/read", { method: "DELETE", credentials: "include", headers: { Accept: "application/json" } });
      if (res.ok) {
        notifications = notifications.filter(function(n) { return !n.isRead; });
        if (pageList) pageList.innerHTML = notifications.map(renderNotifCard).join("");
        if (pageCount) pageCount.textContent = notifications.length
          ? notifications.length + " notification" + (notifications.length > 1 ? "s" : "")
          : "";
        if (notifications.length === 0 && pageEmpty) pageEmpty.classList.remove("hidden");
        majActions();
      }
    } catch(err) { console.error("Erreur delete-read:", err); }
  });

  loadNotifications();
</script>
