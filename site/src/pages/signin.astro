---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Connexion — GameNime">
  <div class="auth-page">
    <div class="auth-card">
      <h1 class="auth-card__title">Connexion</h1>
      <p class="auth-card__subtitle">Connecte-toi pour suivre tes anime et jeux favoris</p>

      <div id="authError" class="auth-card__error hidden"></div>

      <div class="auth-card__field">
        <label for="loginEmail">Email</label>
        <input type="email" id="loginEmail" placeholder="ton@email.com" autocomplete="email" />
      </div>

      <div class="auth-card__field">
        <label for="loginPassword">Mot de passe</label>
        <input type="password" id="loginPassword" placeholder="••••••••" autocomplete="current-password" />
      </div>

      <button id="loginBtn" class="auth-card__btn" type="button">Se connecter</button>

      <p class="auth-card__forgot">
        <a href="#" id="forgotPasswordLink">Mot de passe oublié ?</a>
      </p>

      <p class="auth-card__switch">
        Pas encore de compte ? <a href="/register">Créer un compte</a>
      </p>

      <div id="forgotForm" class="auth-card__forgot-form hidden">
        <p class="auth-card__forgot-intro">Saisis ton email, tu recevras un lien de réinitialisation :</p>
        <div class="auth-card__field">
          <label for="forgotEmail">Email</label>
          <input type="email" id="forgotEmail" placeholder="ton@email.com" autocomplete="email" />
        </div>
        <button id="forgotBtn" class="auth-card__btn" type="button">Envoyer le lien</button>
        <p id="forgotMsg" class="auth-card__forgot-msg hidden"></p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  var apiBase = "/api";
  var emailInput = document.getElementById("loginEmail");
  var passwordInput = document.getElementById("loginPassword");
  var loginBtn = document.getElementById("loginBtn");
  var errorDiv = document.getElementById("authError");

  function showError(msg) {
    if (!errorDiv) return;
    errorDiv.textContent = msg;
    errorDiv.classList.remove("hidden");
  }

  async function doLogin() {
    if (!emailInput || !passwordInput) return;
    var email = emailInput.value.trim();
    var password = passwordInput.value;
    if (!email || !password) { showError("Remplis tous les champs."); return; }

    try {
      loginBtn.disabled = true;
      loginBtn.textContent = "Connexion...";
      var res = await fetch(apiBase + "/auth/login", {
        method: "POST", credentials: "include",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify({ email: email, password: password })
      });
      var data = await res.json();
      if (!res.ok) { showError(data.error || "Erreur de connexion"); loginBtn.disabled = false; loginBtn.textContent = "Se connecter"; return; }
      window.location.href = "/";
    } catch (e) {
      showError("Impossible de se connecter."); loginBtn.disabled = false; loginBtn.textContent = "Se connecter";
    }
  }

  if (loginBtn) loginBtn.addEventListener("click", doLogin);
  if (passwordInput) passwordInput.addEventListener("keydown", function(e) { if (e.key === "Enter") doLogin(); });

  // ── Forgot password flow ──
  var forgotLink = document.getElementById("forgotPasswordLink");
  var forgotForm = document.getElementById("forgotForm");
  var forgotEmail = document.getElementById("forgotEmail");
  var forgotBtn = document.getElementById("forgotBtn");
  var forgotMsg = document.getElementById("forgotMsg");

  if (forgotLink && forgotForm) {
    forgotLink.addEventListener("click", function(e) {
      e.preventDefault();
      forgotForm.classList.toggle("hidden");
      if (!forgotForm.classList.contains("hidden") && forgotEmail) {
        if (emailInput && emailInput.value && !forgotEmail.value) {
          forgotEmail.value = emailInput.value;
        }
        forgotEmail.focus();
      }
    });
  }

  if (forgotBtn) {
    forgotBtn.addEventListener("click", async function() {
      if (!forgotEmail || !forgotEmail.value.trim()) {
        if (forgotMsg) {
          forgotMsg.textContent = "Saisis ton email.";
          forgotMsg.className = "auth-card__forgot-msg auth-card__forgot-msg--error";
        }
        return;
      }
      forgotBtn.disabled = true;
      forgotBtn.textContent = "Envoi…";
      try {
        var res = await fetch(apiBase + "/auth/request-password-reset", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email: forgotEmail.value.trim() })
        });
        var data = await res.json();
        if (forgotMsg) {
          if (res.ok && data.ok) {
            forgotMsg.textContent = "✅ Si cet email existe, un lien a été envoyé.";
            forgotMsg.className = "auth-card__forgot-msg auth-card__forgot-msg--success";
            forgotEmail.value = "";
          } else if (res.status === 429) {
            forgotMsg.textContent = "Trop de demandes. Réessaie dans 15 minutes.";
            forgotMsg.className = "auth-card__forgot-msg auth-card__forgot-msg--error";
          } else {
            forgotMsg.textContent = data.error || "Erreur. Réessaie.";
            forgotMsg.className = "auth-card__forgot-msg auth-card__forgot-msg--error";
          }
        }
      } catch (err) {
        if (forgotMsg) {
          forgotMsg.textContent = "Erreur réseau. Réessaie.";
          forgotMsg.className = "auth-card__forgot-msg auth-card__forgot-msg--error";
        }
      } finally {
        forgotBtn.disabled = false;
        forgotBtn.textContent = "Envoyer le lien";
      }
    });
  }
</script>
