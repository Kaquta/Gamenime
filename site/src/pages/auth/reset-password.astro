---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroHeader from "../../components/HeroHeader.astro";
import "../../styles/reset-password.css";
---

<BaseLayout title="Réinitialiser mon mot de passe — GameNime">
  <HeroHeader />

  <main class="reset-page container">
    <div class="reset-card">
      <h1 class="reset-title">Réinitialiser mon mot de passe</h1>
      <p class="reset-sub">Choisis un nouveau mot de passe (8 caractères minimum).</p>

      <div id="resetTokenError" class="reset-msg reset-msg--error hidden">
        Lien invalide ou expiré.
      </div>

      <form id="resetForm">
        <label class="reset-label">
          Nouveau mot de passe
          <div class="reset-input-wrap">
            <input type="password" id="newPassword" minlength="8" required autocomplete="new-password" />
            <button type="button" class="reset-toggle-eye" id="toggleEye1" aria-label="Afficher le mot de passe">👁</button>
          </div>
          <div class="reset-strength" id="strengthMeter">
            <div class="reset-strength__bar"></div>
          </div>
          <span class="reset-strength__label" id="strengthLabel"></span>
        </label>

        <label class="reset-label">
          Confirme le mot de passe
          <div class="reset-input-wrap">
            <input type="password" id="newPasswordConfirm" minlength="8" required autocomplete="new-password" />
            <button type="button" class="reset-toggle-eye" id="toggleEye2" aria-label="Afficher le mot de passe">👁</button>
          </div>
        </label>

        <button type="submit" class="reset-btn" id="resetSubmit">Mettre à jour mon mot de passe</button>

        <div id="resetMsg" class="reset-msg hidden"></div>

        <div id="resetFallback" class="reset-fallback hidden">
          <a href="/signin?forgot=1">Demander un nouveau lien</a>
        </div>
      </form>

      <p class="reset-back">
        <a href="/">← Retour à l'accueil</a>
      </p>
    </div>
  </main>

  <script is:inline>
    (function(){
      var params = new URLSearchParams(window.location.search);
      var token = params.get("token") || "";
      var formEl = document.getElementById("resetForm");
      var tokenErrorEl = document.getElementById("resetTokenError");
      var msgEl = document.getElementById("resetMsg");
      var fallbackEl = document.getElementById("resetFallback");
      var submitBtn = document.getElementById("resetSubmit");
      var pwInput = document.getElementById("newPassword");
      var pwcInput = document.getElementById("newPasswordConfirm");
      var meterEl = document.getElementById("strengthMeter");
      var labelEl = document.getElementById("strengthLabel");

      // Token must be present and look like a real token
      if (!token || token.length < 20) {
        if (tokenErrorEl) tokenErrorEl.classList.remove("hidden");
        if (formEl) formEl.style.display = "none";
        if (fallbackEl) fallbackEl.classList.remove("hidden");
        return;
      }

      // ── Eye toggle (show/hide password) ──
      function bindEyeToggle(btnId, inputEl) {
        var btn = document.getElementById(btnId);
        if (!btn || !inputEl) return;
        btn.addEventListener("click", function() {
          var isPwd = inputEl.type === "password";
          inputEl.type = isPwd ? "text" : "password";
          btn.textContent = isPwd ? "🙈" : "👁";
          btn.setAttribute("aria-label", isPwd ? "Cacher le mot de passe" : "Afficher le mot de passe");
        });
      }
      bindEyeToggle("toggleEye1", pwInput);
      bindEyeToggle("toggleEye2", pwcInput);

      // ── Password strength estimation ──
      function estimateStrength(pw) {
        if (!pw || pw.length < 8) return { level: 0, label: "" };
        var score = 0;
        if (pw.length >= 8) score++;
        if (pw.length >= 12) score++;
        if (/[a-z]/.test(pw) && /[A-Z]/.test(pw)) score++;
        if (/\d/.test(pw)) score++;
        if (/[^a-zA-Z0-9]/.test(pw)) score++;
        if (score <= 2) return { level: 1, label: "Faible" };
        if (score <= 3) return { level: 2, label: "Moyen" };
        return { level: 3, label: "Fort" };
      }

      function updateStrength() {
        var pw = pwInput.value;
        var s = estimateStrength(pw);
        meterEl.classList.remove("reset-strength--weak", "reset-strength--medium", "reset-strength--strong");
        labelEl.textContent = s.label;
        if (s.level === 1) meterEl.classList.add("reset-strength--weak");
        else if (s.level === 2) meterEl.classList.add("reset-strength--medium");
        else if (s.level === 3) meterEl.classList.add("reset-strength--strong");
      }
      pwInput.addEventListener("input", updateStrength);

      // ── Show messages ──
      function showMessage(text, isError) {
        if (!msgEl) return;
        msgEl.textContent = text;
        msgEl.classList.remove("hidden", "reset-msg--error");
        if (isError) msgEl.classList.add("reset-msg--error");
      }

      // ── Submit ──
      formEl.addEventListener("submit", async function(e) {
        e.preventDefault();
        var pw = pwInput.value;
        var pwc = pwcInput.value;

        if (pw.length < 8) { showMessage("Mot de passe trop court (8 caractères minimum).", true); return; }
        if (pw !== pwc) { showMessage("Les deux mots de passe ne correspondent pas.", true); return; }

        submitBtn.disabled = true;
        submitBtn.textContent = "Envoi…";

        try {
          var res = await fetch("/api/auth/reset-password", {
            method: "POST",
            credentials: "include",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ token: token, newPassword: pw })
          });
          var data = await res.json();

          if (res.ok && data.ok) {
            showMessage("✅ Mot de passe mis à jour. Redirection vers la connexion…", false);
            setTimeout(function(){ window.location.href = "/signin"; }, 2000);
          } else {
            showMessage("❌ " + (data.error || "Erreur"), true);
            if (data.error && (String(data.error).includes("expir") || String(data.error).includes("invalide") || String(data.error).includes("utilis"))) {
              if (fallbackEl) fallbackEl.classList.remove("hidden");
            }
            submitBtn.disabled = false;
            submitBtn.textContent = "Mettre à jour mon mot de passe";
          }
        } catch (err) {
          showMessage("❌ Erreur réseau. Réessaie.", true);
          submitBtn.disabled = false;
          submitBtn.textContent = "Mettre à jour mon mot de passe";
        }
      });
    })();
  </script>
</BaseLayout>
