---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroHeader from "../../components/HeroHeader.astro";
---

<BaseLayout title="Mes préférences — GameNime">
  <HeroHeader />

  <main class="prefs-page container">
    <div class="prefs-breadcrumb">
      <a href="/account">← Mon abonnement</a>
    </div>

    <h1 class="prefs-page__title">Mes préférences d'alertes</h1>
    <p class="prefs-page__sub">Tu seras alerté dès qu'une nouveauté correspond à tes préférences.</p>
    <div class="prefs-summary" id="prefsSummary">
      <span class="prefs-summary__label">⚡ Mes alertes</span>
      <div class="prefs-summary__rings">
        <div class="prefs-summary__item">
          <div class="prefs-summary__ring prefs-summary__ring--genres">
            <span class="prefs-summary__num" id="sumGenres">3</span>
          </div>
          <span class="prefs-summary__cap">genres</span>
        </div>
        <div class="prefs-summary__item">
          <div class="prefs-summary__ring prefs-summary__ring--platforms">
            <span class="prefs-summary__num" id="sumPlatforms">2</span>
          </div>
          <span class="prefs-summary__cap">plateformes</span>
        </div>
        <div class="prefs-summary__item">
          <div class="prefs-summary__ring prefs-summary__ring--reminders">
            <span class="prefs-summary__num" id="sumReminders">2</span>
          </div>
          <span class="prefs-summary__cap">rappels</span>
        </div>
      </div>
    </div>

    <div id="prefsLoading" class="prefs-state">Chargement...</div>

    <div id="prefsNotPremium" class="prefs-state hidden">
      <p>Cette fonctionnalité est réservée aux membres Premium.</p>
      <a href="/premium" class="prefs-cta-btn">✨ Découvrir Premium</a>
    </div>

      <!-- Section Agenda unifiee : Free = base + invite / Premium = avance -->
    <form id="prefsForm">
      <section class="prefs-card prefs-card--genres">
        <div class="prefs-card__head">
          <span class="prefs-card__num">1</span>
          <div class="prefs-card__titles">
            <h2 class="prefs-card__title">Genres</h2>
            <p class="prefs-card__sub">Ce que tu aimes regarder et jouer</p>
          </div>
        </div>
        <div class="prefs-seg" data-for="genres">
          <button type="button" class="prefs-seg__btn active" data-val="all">Tout</button>
          <button type="button" class="prefs-seg__btn" data-val="anime">🎬 Animes</button>
          <button type="button" class="prefs-seg__btn" data-val="game">🎮 Jeux</button>
        </div>
        <div id="genresGrid"></div>
      </section>

      <section class="prefs-card prefs-card--platforms">
        <div class="prefs-card__head">
          <span class="prefs-card__num">2</span>
          <div class="prefs-card__titles">
            <h2 class="prefs-card__title">Plateformes</h2>
            <p class="prefs-card__sub">Où tu regardes et joues</p>
          </div>
        </div>
        <div class="prefs-seg" data-for="platforms">
          <button type="button" class="prefs-seg__btn active" data-val="all">Tout</button>
          <button type="button" class="prefs-seg__btn" data-val="anime">🎬 Animes</button>
          <button type="button" class="prefs-seg__btn" data-val="game">🎮 Jeux</button>
        </div>
        <div id="platformsGrid"></div>
      </section>

      <section id="channelsSection" class="prefs-card prefs-card--notify">
      <div class="prefs-card__head">
        <span class="prefs-card__num">3</span>
        <div class="prefs-card__titles">
          <h2 class="prefs-card__title">Canaux de notification</h2>
          <p class="prefs-card__sub">Comment veux-tu être prévenu</p>
        </div>
      </div>
      <div id="channelsLoading" class="prefs-state">Chargement...</div>
      <div id="channelsControls" class="prefs-channels-grid hidden">
        <label class="prefs-channel-row">
          <div class="prefs-channel-info">
            <span class="prefs-channel-icon">🔔</span>
            <div>
              <strong>Notifications in-app</strong>
              <small>Cloche en haut à droite + page Notifications</small>
            </div>
          </div>
          <label class="prefs-switch">
            <input type="checkbox" id="toggleInApp" />
            <span class="prefs-switch-slider"></span>
          </label>
        </label>
        <label class="prefs-channel-row" id="emailChannelRow">
          <div class="prefs-channel-info">
            <span class="prefs-channel-icon">📧</span>
            <div>
              <strong>Notifications par email</strong>
              <small id="emailSubLabel">Reminders + alertes envoyés sur ton email</small>
            </div>
          </div>
          <label class="prefs-switch">
            <input type="checkbox" id="toggleEmail" />
            <span class="prefs-switch-slider"></span>
          </label>
        </label>
        <div id="channelsMsg" class="prefs-msg hidden"></div>
      </div>
    </section>
      <section class="prefs-card prefs-card--notify">
        <div class="prefs-card__head">
          <span class="prefs-card__num">4</span>
          <div class="prefs-card__titles">
            <h2 class="prefs-card__title">Rappels avant sortie</h2>
            <p class="prefs-card__sub">Quand te prévenir avant chaque sortie</p>
          </div>
        </div>
        <div id="reminderGrid"></div>
      </section>

      <section class="prefs-card prefs-card--agenda">
        <div class="prefs-card__head">
          <span class="prefs-card__num">5</span>
          <div class="prefs-card__titles">
            <h2 class="prefs-card__title">📅 Mon agenda</h2>
            <p class="prefs-card__sub">Synchronise tes sorties dans ton calendrier</p>
          </div>
        </div>
        <div id="agendaLoading" class="prefs-state">Chargement...</div>
        <div id="agendaControls" class="hidden">

          <div class="agenda-url-row">
            <input id="agendaUrl" class="agenda-url-input" type="text" readonly value="" />
            <button id="agendaCopyBtn" class="agenda-copy-btn" type="button">Copier</button>
          </div>

          <div class="agenda-sync-info">💡 Une fois ton lien ajouté à ton agenda, tu n'as plus besoin de le recopier. Ton agenda se met à jour automatiquement à la prochaine synchronisation de ton application (Google, Apple...) — généralement quelques heures.</div>

          <details class="agenda-help">
            <summary>Comment l'ajouter à mon agenda ?</summary>
            <ul class="agenda-steps">
              <li><strong>Google Agenda :</strong> Autres agendas → ＋ → « À partir de l'URL » → colle le lien</li>
              <li><strong>Apple Calendar :</strong> Fichier → Nouvel abonnement → colle le lien</li>
              <li><strong>Outlook :</strong> Ajouter un agenda → « S'abonner à partir du web » → colle le lien</li>
              <li>La première synchronisation peut prendre quelques heures côté Google. C'est normal.</li>
            </ul>
          </details>
          <div id="agendaMsg" class="prefs-msg hidden"></div>
        </div>
      </section>
      <button type="submit" class="prefs-save-btn">Enregistrer mes préférences</button>
      <div id="prefsMsg" class="prefs-msg hidden"></div>
    </form>

  </main>

  <script is:inline>
    (function(){
      var apiBase = "";

      // ═══ SECTION CANAUX DE NOTIFICATION (Free + Premium) ═══
      var chLoadingEl = document.getElementById("channelsLoading");
      var chControlsEl = document.getElementById("channelsControls");
      var toggleInApp = document.getElementById("toggleInApp");
      var toggleEmail = document.getElementById("toggleEmail");
      var emailChannelRow = document.getElementById("emailChannelRow");
      var emailSubLabel = document.getElementById("emailSubLabel");
      var channelsMsg = document.getElementById("channelsMsg");
      var userIsPremium = false;

      async function loadChannels() {
        try {
          var res = await fetch(apiBase + "/api/auth/me", { credentials: "include" });
          if (res.status === 401) {
            if (chLoadingEl) chLoadingEl.textContent = "Connecte-toi pour gérer tes canaux de notification.";
            return;
          }
          if (!res.ok) throw new Error("HTTP " + res.status);
          var data = await res.json();
          var user = data.user || data;
          userIsPremium = !!(user.isPremium);
          if (toggleInApp) toggleInApp.checked = !!user.notificationsEnabled;
          if (toggleEmail) toggleEmail.checked = !!user.emailNotificationsEnabled;
          // FREE LAUNCH : email activable par tous (plus de restriction Premium)
          if (chLoadingEl) chLoadingEl.classList.add("hidden");
          if (chControlsEl) chControlsEl.classList.remove("hidden");
        } catch (e) {
          if (chLoadingEl) chLoadingEl.textContent = "Erreur de chargement.";
        }
      }

      async function saveChannel(field, value) {
        try {
          var body = {};
          body[field] = value;
          var res = await fetch(apiBase + "/api/me/notification-channels", {
            method: "PATCH",
            credentials: "include",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(body)
          });
          var data = await res.json();
          if (!res.ok) throw new Error(data.error || "Erreur");
          if (channelsMsg) {
            channelsMsg.textContent = "✅ Préférence enregistrée";
            channelsMsg.classList.remove("hidden", "prefs-msg--error");
            setTimeout(function(){ if(channelsMsg) channelsMsg.classList.add("hidden"); }, 2500);
          }
        } catch (e) {
          if (channelsMsg) {
            channelsMsg.textContent = "❌ Erreur : " + (e.message || "réseau");
            channelsMsg.classList.remove("hidden");
            channelsMsg.classList.add("prefs-msg--error");
          }
        }
      }

      if (toggleInApp) toggleInApp.addEventListener("change", function(){
        saveChannel("notificationsEnabled", toggleInApp.checked);
      });
      if (toggleEmail) toggleEmail.addEventListener("change", function(){
        if (toggleEmail.disabled) return;
        saveChannel("emailNotificationsEnabled", toggleEmail.checked);
      });

      loadChannels();

      // ── Agenda (export calendrier ICS) ──
      var agendaBaseWebcal = "";
      function refreshAgendaUrl() {
        var urlInput = document.getElementById("agendaUrl");
        if (urlInput) urlInput.value = agendaBaseWebcal;
      }

      async function loadAgenda() {
        var loading = document.getElementById("agendaLoading");
        var controls = document.getElementById("agendaControls");
        var urlInput = document.getElementById("agendaUrl");
        var copyBtn = document.getElementById("agendaCopyBtn");
        try {
          var res = await fetch(apiBase + "/api/me/calendar-token", { credentials: "include" });
          if (!res.ok) throw new Error("not_auth");
          var data = await res.json();
          agendaBaseWebcal = data.webcal || data.url || "";
          if (urlInput) urlInput.value = agendaBaseWebcal;
          if (loading) loading.classList.add("hidden");
          if (controls) controls.classList.remove("hidden");

          if (copyBtn) {
            copyBtn.addEventListener("click", function() {
              var val = urlInput ? urlInput.value : "";
              if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(val);
              } else if (urlInput) {
                urlInput.select();
                try { document.execCommand("copy"); } catch (e) {}
              }
              copyBtn.textContent = "✓ Copié";
              setTimeout(function(){ copyBtn.textContent = "Copier"; }, 1500);
            });
          }
        } catch (e) {
          if (loading) loading.textContent = "Connecte-toi pour obtenir ton lien d'agenda.";
        }
      }
      loadAgenda();
      // ═══ FIN SECTION CANAUX ═══

      var loadingEl = document.getElementById("prefsLoading");
      var notPremEl = document.getElementById("prefsNotPremium");
      var formEl = document.getElementById("prefsForm");
      var genresGrid = document.getElementById("genresGrid");
      var platformsGrid = document.getElementById("platformsGrid");
      var reminderGrid = document.getElementById("reminderGrid");
      var msgEl = document.getElementById("prefsMsg");

      var GENRES_ANIME = ["Action", "Fantasy", "Comedy", "Drama", "Romance", "Adventure", "Supernatural", "Slice of Life", "Sci-Fi", "Mystery", "School", "Psychological", "Isekai", "Sports", "Thriller", "Horror", "Shounen", "Music", "Magical Girl", "Mecha", "Magic", "Seinen"];
      var GENRES_GAMES = ["Indie", "Adventure", "RPG", "Strategy", "Action", "Simulation", "Puzzle", "Shooter", "Platformer", "Sports", "Board Games", "Arcade", "Visual Novel", "Tactical", "Racing", "Point-and-click", "Hack and slash", "Music", "Fighting"];
      var PLATFORMS_ANIME = ["Crunchyroll", "Netflix", "YouTube", "Disney+", "Hulu", "Amazon Prime Video", "Bilibili TV", "iQ", "Tencent Video", "HIDIVE"];
      var PLATFORMS_GAMES = ["PC", "PlayStation", "Xbox", "Nintendo", "iOS", "Android"];
      var genresContentFilter = "all";
      var platformsContentFilter = "all";
      var selectedGenres = [];
      var selectedPlatforms = [];

      // ── W2 : met a jour les anneaux (header + numeros de cartes) selon les vraies selections ──
      function setRing(el, frac) {
        if (el) el.style.setProperty("--ring", String(Math.max(0, Math.min(1, frac))));
      }
      function updateSummary() {
        var totalGenres = GENRES_ANIME.length + GENRES_GAMES.length;
        var totalPlatforms = PLATFORMS_ANIME.length + PLATFORMS_GAMES.length;
        // compter les rappels coches
        var remCount = 0;
        if (reminderGrid) {
          reminderGrid.querySelectorAll("input[type=checkbox]:checked").forEach(function(){ remCount++; });
        }
        var nG = selectedGenres.length, nP = selectedPlatforms.length;
        // chiffres du header
        var sg = document.getElementById("sumGenres"); if (sg) sg.textContent = String(nG);
        var sp = document.getElementById("sumPlatforms"); if (sp) sp.textContent = String(nP);
        var sr = document.getElementById("sumReminders"); if (sr) sr.textContent = String(remCount);
        // anneaux du header
        setRing(document.querySelector(".prefs-summary__ring--genres"), nG / totalGenres);
        setRing(document.querySelector(".prefs-summary__ring--platforms"), nP / totalPlatforms);
        setRing(document.querySelector(".prefs-summary__ring--reminders"), remCount / 2);
        // anneaux des numeros de cartes
        var cardG = document.querySelector(".prefs-card--genres .prefs-card__num"); setRing(cardG, nG / totalGenres);
        var cardP = document.querySelector(".prefs-card--platforms .prefs-card__num"); setRing(cardP, nP / totalPlatforms);
      }
      var REMINDERS = [
        { value: 7, label: "7 jours avant" },
        
        { value: 0, label: "Le jour même" }
      ];

      function chipDot(val, checked) {
        return '<label class="prefs-chipC' + (checked ? ' active' : '') + '"><input type="checkbox" value="' + val.replace(/"/g, '&quot;') + '" ' + (checked ? 'checked' : '') + ' /><span class="prefs-chipC__dot"></span>' + val + '</label>';
      }
      function renderGroupedChips(container, animeList, gamesList, filter, selected) {
        var html = "";
        if (filter === "all" || filter === "anime") {
          if (filter === "all") html += '<div class="prefs-grp-sub">🎬 Anime</div>';
          html += '<div class="prefs-chipset">' + animeList.map(function(g){ return chipDot(g, selected.indexOf(g) !== -1); }).join("") + '</div>';
        }
        if (filter === "all" || filter === "game") {
          if (filter === "all") html += '<div class="prefs-grp-sub">🎮 Jeux</div>';
          html += '<div class="prefs-chipset">' + gamesList.map(function(g){ return chipDot(g, selected.indexOf(g) !== -1); }).join("") + '</div>';
        }
        container.innerHTML = html;
        container.querySelectorAll("input[type=checkbox]").forEach(function(cb){
          cb.addEventListener("change", function(){
            var label = cb.closest(".prefs-chipC");
            if (cb.checked) {
              if (label) label.classList.add("active");
              if (selected.indexOf(cb.value) === -1) selected.push(cb.value);
            } else {
              if (label) label.classList.remove("active");
              var idx = selected.indexOf(cb.value);
              if (idx !== -1) selected.splice(idx, 1);
            }
            updateSummary();
          });
        });
      }
      function renderGenres() {
        renderGroupedChips(genresGrid, GENRES_ANIME, GENRES_GAMES, genresContentFilter, selectedGenres);
      }
      function renderPlatforms2() {
        renderGroupedChips(platformsGrid, PLATFORMS_ANIME, PLATFORMS_GAMES, platformsContentFilter, selectedPlatforms);
      }
      function renderReminders(selected) {
        reminderGrid.innerHTML = '<div class="prefs-chipset">' + REMINDERS.map(function(r){
          var checked = selected.indexOf(r.value) !== -1;
          return '<label class="prefs-chipC' + (checked ? ' active' : '') + '"><input type="checkbox" value="' + r.value + '" ' + (checked ? 'checked' : '') + ' /><span class="prefs-chipC__dot"></span>' + r.label + '</label>';
        }).join("") + '</div>';
        reminderGrid.querySelectorAll("input[type=checkbox]").forEach(function(cb){
          cb.addEventListener("change", function(){
            var label = cb.closest(".prefs-chipC");
            if (cb.checked) { if (label) label.classList.add("active"); }
            else { if (label) label.classList.remove("active"); }
            updateSummary();
          });
        });
      }
      function wireContentPills(groupSelector, onChange) {
        var grp = document.querySelector(groupSelector);
        if (!grp) return;
        grp.querySelectorAll(".prefs-seg__btn").forEach(function(btn){
          btn.addEventListener("click", function(){
            grp.querySelectorAll(".prefs-seg__btn").forEach(function(b){ b.classList.remove("active"); });
            btn.classList.add("active");
            onChange(btn.getAttribute("data-val"));
          });
        });
      }

      async function load() {
        try {
          var res = await fetch(apiBase + "/api/premium/preferences", { credentials: "include" });
          if (res.status === 401) {
            if (loadingEl) loadingEl.textContent = "Connecte-toi pour accéder à tes préférences.";
            return;
          }
          if (res.status === 403) {
            // Full gratuit : on affiche quand meme le form (plus de gating Premium)
            if (loadingEl) loadingEl.classList.add("hidden");
            if (formEl) formEl.classList.remove("hidden");
            return;
          }
          if (!res.ok) throw new Error("HTTP " + res.status);
          var data = await res.json();
          if (loadingEl) loadingEl.classList.add("hidden");
          if (formEl) formEl.classList.remove("hidden");

          selectedGenres = (data.alertGenres || []).slice();
          selectedPlatforms = (data.alertPlatforms || []).slice();
          renderGenres();
          renderPlatforms2();
          renderReminders(data.reminderDaysBefore || [7, 0]);
          updateSummary();
          wireContentPills(".prefs-seg[data-for=genres]", function(v){ genresContentFilter = v; renderGenres(); });
          wireContentPills(".prefs-seg[data-for=platforms]", function(v){ platformsContentFilter = v; renderPlatforms2(); });
        } catch (e) {
          if (loadingEl) loadingEl.textContent = "Erreur de chargement.";
        }
      }

      async function save(e) {
        e.preventDefault();
        var alertGenres = selectedGenres.slice();
        var alertPlatforms = selectedPlatforms.slice();
        var reminderDaysBefore = Array.from(reminderGrid.querySelectorAll("input:checked")).map(function(i){ return Number(i.value); });

        try {
          var res = await fetch(apiBase + "/api/premium/preferences", {
            method: "PATCH",
            credentials: "include",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ alertGenres: alertGenres, alertPlatforms: alertPlatforms, reminderDaysBefore: reminderDaysBefore })
          });
          var data = await res.json();
          if (res.ok) {
            if (msgEl) {
              msgEl.textContent = "✅ Préférences enregistrées";
              msgEl.classList.remove("hidden", "prefs-msg--error");
            }
          } else {
            if (msgEl) {
              msgEl.textContent = "❌ " + (data.error || "Erreur");
              msgEl.classList.remove("hidden");
              msgEl.classList.add("prefs-msg--error");
            }
          }
        } catch (err) {
          if (msgEl) {
            msgEl.textContent = "❌ Erreur réseau";
            msgEl.classList.remove("hidden");
            msgEl.classList.add("prefs-msg--error");
          }
        }
      }

      if (formEl) formEl.addEventListener("submit", save);
      load();
    })();
  </script>
</BaseLayout>

<style is:global>
  .prefs-channels { margin-bottom: 32px; }
  .prefs-channels-grid { display: flex; flex-direction: column; gap: 12px; }
  .prefs-channel-row { 
    display: flex; align-items: center; justify-content: space-between; 
    padding: 16px 18px; background: rgba(255, 255, 255, 0.04); 
    border: 1px solid rgba(255, 173, 97, 0.14); border-radius: 14px; 
    cursor: pointer; transition: background 0.15s;
  }
  .prefs-channel-row:hover { background: rgba(255, 255, 255, 0.06); }
  .prefs-channel-row.prefs-channel-disabled { opacity: 0.6; cursor: not-allowed; }
  .prefs-channel-info { display: flex; align-items: center; gap: 14px; flex: 1; }
  .prefs-channel-icon { font-size: 1.6rem; }
  .prefs-channel-info strong { display: block; color: rgba(255, 244, 232, 0.96); font-size: 1.02rem; font-weight: 700; }
  .prefs-channel-info small { display: block; color: rgba(255, 226, 205, 0.72); font-size: 0.9rem; margin-top: 2px; }
  .prefs-channel-info small a { color: #ffad61; text-decoration: underline; }
  .prefs-switch { position: relative; display: inline-block; width: 50px; height: 28px; flex-shrink: 0; }
  .prefs-switch input { opacity: 0; width: 0; height: 0; }
  .prefs-switch-slider {
    position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(255, 255, 255, 0.12); border-radius: 999px; transition: 0.2s;
  }
  .prefs-switch-slider::before {
    position: absolute; content: ""; height: 22px; width: 22px; left: 3px; bottom: 3px;
    background: white; border-radius: 999px; transition: 0.2s;
  }
  .prefs-switch input:checked + .prefs-switch-slider { background: #ffad61; }
  .prefs-switch input:checked + .prefs-switch-slider::before { transform: translateX(22px); }
  .prefs-switch input:disabled + .prefs-switch-slider { cursor: not-allowed; opacity: 0.5; }

/* ── Section Agenda (export ICS) ── */
.prefs-agenda-badge {
  display: inline-block; font-size: 10px; font-weight: 800; letter-spacing: 0.5px;
  background: rgba(100,200,120,0.15); color: #7ed99a;
  border: 1px solid rgba(126,217,154,0.3); border-radius: 999px;
  padding: 2px 8px; margin-left: 8px; vertical-align: middle; text-transform: uppercase;
}
.agenda-url-row { display: flex; gap: 8px; margin-bottom: 14px; }
.agenda-url-input {
  flex: 1; min-width: 0;
  background: rgba(0,0,0,0.35);
  border: 1px solid rgba(255,171,93,0.25);
  border-radius: 10px; padding: 11px 14px;
  color: #e8d5c4; font-size: 13px; font-family: ui-monospace, monospace;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.agenda-copy-btn {
  flex-shrink: 0;
  background: linear-gradient(135deg, #b85c5c 0%, #a04848 50%, #8b3a3a 100%);
  border: 1px solid rgba(255,180,180,0.35);
  border-radius: 10px; padding: 11px 18px;
  color: #fff; font-size: 14px; font-weight: 700; cursor: pointer;
  box-shadow: 0 3px 10px rgba(120,50,50,0.3), inset 0 1px 0 rgba(255,200,200,0.3);
  transition: transform 180ms ease, filter 180ms ease;
}
.agenda-copy-btn:hover { transform: translateY(-1px); filter: brightness(1.08); }
.agenda-copy-btn:active { transform: translateY(0); }
.agenda-help { border-top: 1px solid rgba(255,171,93,0.12); padding-top: 14px; }
.agenda-help summary {
  cursor: pointer; color: #ffb87a; font-size: 13px; font-weight: 600;
  list-style: none; user-select: none;
}
.agenda-help summary::-webkit-details-marker { display: none; }
.agenda-help summary::before { content: "▸ "; }
.agenda-help[open] summary::before { content: "▾ "; }
