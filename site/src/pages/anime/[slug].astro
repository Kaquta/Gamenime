---
/**
 * Page indexable d'un anime : /anime/{slug}
 *
 * Les fiches ne vivaient que dans un modal, sans URL : Google n'avait rien a
 * indexer — quatre pages pour un catalogue de plus de mille titres. Chaque
 * fiche a desormais son adresse, avec son HTML complet des le premier octet.
 *
 * La fiche est celle du modal (lib/fiche : ficheHtml), en mode « page » :
 * titre h1, bande-annonce et description cote a cote. Le HTML livre est rendu
 * au build (pour Google) ; a l'ouverture, la page se recharge avec les donnees
 * en direct (rafraichirFiche) : apres un F5, on retrouve le modal a jour.
 * Design du site (Vitre · Cameleon, jeton « fiche » : bloc FICHE-VITRE de
 * global.css) ; la page prend la couleur de la jaquette (lib/teinte).
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroHeader from "../../components/HeroHeader.astro";
import Footer from "../../components/Footer.astro";
import { displayTitle } from "../../lib/api";
import { dateLabel, ficheHtml } from "../../lib/fiche";

export async function getStaticPaths() {
  // Declaree ici : Astro appelle getStaticPaths avant d'evaluer le reste
  // du frontmatter, donc une constante de module ne serait pas encore definie.
  const API = "https://gamenime.fr/api";
  const res = await fetch(`${API}/feed/slugs?type=anime`);
  if (!res.ok) throw new Error(`/feed/slugs a repondu ${res.status}`);
  const { items } = await res.json();
  return await Promise.all(
    items.map(async (it) => {
      const r = await fetch(`${API}/anime/items/${it.id}`);
      if (!r.ok) throw new Error(`item ${it.id} : HTTP ${r.status}`);
      return { params: { slug: it.slug }, props: { item: await r.json() } };
    })
  );
}

const { item } = Astro.props;
const titre = displayTitle(item);
const url = `https://gamenime.fr/anime/${Astro.params.slug}/`;
const titreOnglet = `${titre} — date de sortie, plateformes | GameNime`;

const synopsis = String(item.description || "").replace(/\[[A-Z]+:[^\]]*\]/g, "").replace(/<[^>]+>/g, "").trim();
const meta = synopsis ? `${dateLabel(item)}. ${synopsis.slice(0, 150)}…` : `${titre} — date de sortie et plateformes.`;
const alt = [item.titleNative, item.title].filter((t, i, a) => t && t !== titre && a.indexOf(t) === i);
const genres = String(item.genre || "").split(",").map((g) => g.trim()).filter(Boolean);
const domaine = "anime";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "TVSeries",
  name: titre,
  alternateName: alt,
  url,
  ...(item.cover ? { image: item.cover } : {}),
  ...(synopsis ? { description: synopsis.slice(0, 500) } : {}),
  // la date donnee a Google (20 octobre 2026) : au mois (« 2027-10 ») ou a l'annee (« 2027 ») quand le jour n'est pas
  // connu, jamais un 1er invente (format ISO 8601 a precision reduite)
  ...(item.releaseDate
    ? { startDate: item.releasePrecision === "year" ? String(item.releaseDate).slice(0, 4) : item.releasePrecision === "month" ? String(item.releaseDate).slice(0, 7) : item.releaseDate }
    : {}),
  ...(genres.length ? { genre: genres } : {}),
  inLanguage: "ja",
};
---

<BaseLayout
  title={titreOnglet}
  description={meta}
  canonical={url}
  image={item.cover || "https://gamenime.fr/og-image.jpg?v=2"}
  ogType="video.tv_show"
  jetons="fiche"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

  <HeroHeader activeTab="anime" />

  <div class="container">
    <nav class="fiche-fil" aria-label="Fil d'Ariane">
      <a href="/">Accueil</a><span>›</span><a href="/anime">Animés</a><span>›</span>{titre}
    </nav>

    <article class="fiche-sheet" data-domain={domaine} data-id={String(item.id)}>
      <div class="fiche-vive" set:html={ficheHtml(item, domaine, "page")}></div>

      <p class="fiche-retour">
        <a href="/anime">← Tous les animés</a> · <a href="/upcoming">Prochaines sorties</a>
      </p>
    </article>
  </div>

  <Footer />
</BaseLayout>

<script>
  // Votes, galerie et bande-annonce ; puis les donnees en direct (le HTML livre date du build).
  import { brancherFiche, rafraichirFiche } from "../../lib/fiche";
  import { teinteImage, teinter } from "../../lib/teinte";
  const fiche = document.querySelector(".fiche-sheet") as HTMLElement | null;
  const zone = fiche ? (fiche.querySelector(".fiche-vive") as HTMLElement | null) : null;
  // La couleur de la jaquette sur toute la page (Cameleon) : deja connue (memoire du navigateur, partagee
  // avec les autres pages), posee d'emblee ; calculee apres coup, en fondu depuis le neutre.
  const jaquette = fiche ? (fiche.querySelector(".detail-cover img") as HTMLImageElement | null) : null;
  const src = jaquette ? jaquette.getAttribute("src") : null;
  if (src) {
    const racine = document.documentElement;
    let tout = true;
    teinteImage(src, (h) => {
      if (h === null) return;
      if (!tout) racine.classList.add("ep-pret");
      teinter(racine, h);
    });
    tout = false;
  }
  if (fiche && zone) {
    const dom = fiche.dataset.domain || "anime";
    const id = fiche.dataset.id || "";
    brancherFiche(zone, dom, id);
    rafraichirFiche(zone, dom, id);
  }
</script>

<style>
  .fiche-fil {
    display: flex; align-items: center; gap: 7px;
    padding: 10px 0 14px; font-size: .76rem; flex-wrap: wrap;
  }
  .fiche-fil a { text-decoration: none; }
  .fiche-fil a:hover { text-decoration: underline; }
  .fiche-fil span { opacity: .5; }

  /* La fiche du modal, posee dans la page : memes blocs. Son HTML vient de
     ficheHtml (set:html) : les selecteurs internes passent donc par :global().
     Les matieres et les couleurs (panneau de verre, accent de la jaquette)
     sont dans le bloc FICHE-VITRE de global.css. */
  .fiche-sheet {
    padding: 24px; margin-bottom: 28px;
  }
  .fiche-sheet :global(.detail-info h1) {
    margin: 0 0 8px; font-size: 1.8rem; line-height: 1.2;
  }
  /* Bande-annonce a gauche, description a droite (la zone vide d'avant). */
  .fiche-sheet :global(.fiche-duo) {
    display: grid; grid-template-columns: minmax(0, 480px) minmax(0, 1fr);
    gap: 26px; align-items: start; margin: 0 0 20px;
  }
  .fiche-sheet :global(.fiche-duo.seule) { grid-template-columns: minmax(0, 1fr); }
  .fiche-sheet :global(.fiche-duo .detail-trailer),
  .fiche-sheet :global(.fiche-duo .detail-gallery),
  .fiche-sheet :global(.fiche-duo .detail-description) { margin-bottom: 0; }
  .fiche-sheet :global(.detail-description h2) {
    margin: 0 0 10px; font-size: 1.3rem;
  }

  /* Vignette plutot qu'iframe : YouTube chargerait plusieurs centaines de
     kilo-octets a l'ouverture, et Google mesure la vitesse des pages. Au clic,
     la video se lance a la meme place (brancherFiche). */
  .fiche-sheet :global(.fiche-trailer) {
    position: relative; display: block; aspect-ratio: 16 / 9;
    border-radius: 14px; overflow: hidden;
  }
  .fiche-sheet :global(.fiche-trailer img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .fiche-sheet :global(.fiche-play) {
    position: absolute; top: 50%; left: 50%;
    transform: translate(-50%,-50%);
    width: 58px; height: 58px; border-radius: 50%;
    display: grid; place-items: center;
    transition: transform 180ms ease;
  }
  .fiche-sheet :global(.fiche-trailer:hover .fiche-play) { transform: translate(-50%,-50%) scale(1.08); }
  .fiche-sheet :global(.fiche-play svg) { width: 24px; height: 24px; margin-left: 3px; }
  .fiche-sheet :global(.fiche-trailer-lab) {
    position: absolute; bottom: 11px; left: 13px;
    font-size: .72rem; font-weight: 700; padding: 4px 10px; border-radius: 7px;
  }

  @media (max-width: 760px) {
    .fiche-sheet { padding: 18px 16px; }
    .fiche-sheet :global(.fiche-duo) { grid-template-columns: minmax(0, 1fr); gap: 18px; }
  }
  @media (max-width: 640px) {
    .fiche-sheet :global(.detail-info h1) { font-size: 1.42rem; margin: 0 0 6px; }
  }
  .fiche-retour {
    margin: 4px 0 0; padding-top: 16px;
    border-top: 1px solid transparent;
    font-size: .84rem;
  }
  .fiche-retour a { text-decoration: none; }
  .fiche-retour a:hover { text-decoration: underline; }
</style>
