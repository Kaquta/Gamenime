---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroHeader from "../components/HeroHeader.astro";
import SectionBlock from "../components/SectionBlock.astro";
import WeekRadar from "../components/WeekRadar.astro";
import Footer from "../components/Footer.astro";
---


<BaseLayout title="GameNime — Accueil" accueil>
  <HeroHeader activeTab="home" />

  <div class="search-bar-home container">
    <input type="text" id="homeSearch" class="search-input" placeholder="Rechercher un anime ou jeu..." />
    <button id="homeSearchBtn" class="search-btn">↵</button>
  </div>

  <div id="homeSearchResults" class="container" style="display:none;">
    <section class="section-block">
      <div class="section-head"><h2>Résultats</h2></div>
      <div class="items-row" id="homeSearchRow"></div>
    </section>
  </div>

  <!-- Accueil (session 35, maquette validee le 3 octobre) : « Cette semaine »
       en grande case a gauche, les deux derniers sortis a droite, les deux
       Top 25 en dessous. Ce sont les memes SectionBlock qu'avant — seules la
       mise en page et le corps des cartes changent, par variant. Les cartes
       restent rendues au build, donc les liens vers les fiches sont dans le
       HTML livre. -->
  <div class="acc-haut container">
    <WeekRadar />
    <SectionBlock title="Derniers sortis · Jeux" source="games" limit={25} href="/games"
                  variant="slider" duree={4600} decal={0} />
    <SectionBlock title="Derniers sortis · Anime" source="anime" limit={25} href="/anime"
                  variant="slider" duree={4600} decal={2300} />
  </div>

  <div class="acc-bas container">
    <SectionBlock title="Top 25 Anime" source="top-anime" limit={25} variant="rang" />
    <SectionBlock title="Top 25 Jeux" source="top-games" limit={25} variant="rang" />
  </div>
<!-- TOP25-SWITCH-DEBUT : le switch Anime / Jeux des deux Top 25 (top25-podium.sh, 6 octobre 2026) -->
<script is:inline>
/* TOP 25 — le switch Anime / Jeux (sous 1060 px les deux tops s'empilent : un seul a la fois) */
(function () {
  var bas = document.querySelector(".acc-bas");
  if (!bas) return;
  var secs = { anime: bas.querySelector('section[data-source="top-anime"]'), jeux: bas.querySelector('section[data-source="top-games"]') };
  if (!secs.anime || !secs.jeux) return;
  bas.setAttribute("data-top", "anime");
  ["anime", "jeux"].forEach(function (k) {
    var h = secs[k].querySelector(".section-head"), t = h && h.querySelector("h2");
    if (!h || !t) return;
    var m = t.textContent.match(/^(.*\S)\s+(\S+)$/);
    if (m) { t.textContent = m[1]; var q = document.createElement("span"); q.className = "top-q"; q.textContent = m[2]; t.appendChild(q); }
    var sw = document.createElement("div");
    sw.className = "top-switch"; sw.setAttribute("role", "tablist"); sw.setAttribute("aria-label", "Top 25");
    [["anime", "Anime"], ["jeux", "Jeux"]].forEach(function (x) {
      var b = document.createElement("button");
      b.type = "button"; b.textContent = x[1]; b.setAttribute("role", "tab");
      b.setAttribute("aria-selected", x[0] === k ? "true" : "false");
      if (x[0] === k) b.className = "on";
      b.addEventListener("click", function () { bas.setAttribute("data-top", x[0]); });
      sw.appendChild(b);
    });
    h.appendChild(sw);
  });
})();
</script>
<!-- TOP25-SWITCH-FIN -->

  <Footer />
</BaseLayout>

<script>
import { getAnimeItems, getGameItems, displayTitle } from "../lib/api";
// Meme rendu que le catalogue : renderSearchCard avait son propre corps de
// carte, plus pauvre (deux paragraphes au lieu du bloc date, des pastilles
// de plateformes et du badge). Un seul gabarit evite qu'ils redivergent.
import { dateBox, platChips, hypePill } from "../lib/fiche";
import type { ContentItem } from "../lib/api";

function formatDate(v) {
  if (!v) return "Date inconnue";
  var d = new Date(v);
  if (Number.isNaN(d.getTime())) return v;
  return new Intl.DateTimeFormat("fr-FR", { day: "2-digit", month: "long", year: "numeric" }).format(d);
}

function getStatusLabel(item) {
  if (!item.releaseDate) return "À surveiller";
  if (item.releasePrecision === "year") return "À venir";
  var now = new Date(); now.setHours(0,0,0,0);
  var rel = new Date(item.releaseDate); rel.setHours(0,0,0,0);
  var diff = Math.round((rel.getTime() - now.getTime()) / 86400000);
  if (diff === 0) return "Aujourd'hui";
  if (diff > 0) return "À venir";
  // Calcule depuis la date plutot que lu en base : is_recently_released
  // n'etait ecrit qu'a l'ingestion et jamais recalcule, donc un item entre
  // comme "a venir" restait a 0 apres sa sortie (Sekiro, sorti le jour meme,
  // affichait "Sorti" au lieu de "Recent").
  if (diff >= -30) return "Récent";
  return "Sorti";
}

function ytId(url) {
  if (!url) return null;
  var m = url.match(/(?:v=|youtu\.be\/)([a-zA-Z0-9_-]{11})/);
  return m ? m[1] : null;
}

function parseScreenshots(item) {
  if (!item.screenshots) return [];
  try { var arr = JSON.parse(item.screenshots); return Array.isArray(arr) ? arr : []; }
  catch(e) { return []; }
}
function simplifyPlatform(p) {
  // La base garde le detail ("PlayStation 5", "Xbox Series X|S").
  // Certaines lignes melangent generique et precis :
  //   "PC, PlayStation, Xbox, PlayStation 5, Xbox Series X|S"
  // Regle : des qu'une version precise existe pour une famille,
  // le generique de cette famille disparait.
  if (!p) return "";
  var LABELS = {
    "playstation 6": "PS6",
    "playstation 5": "PS5",
    "playstation 4": "PS4",
    "playstation 3": "PS3",
    "xbox series x|s": "Xbox X|S",
    "xbox series s/x": "Xbox X|S",
    "xbox series": "Xbox X|S",
    "xbox one": "Xbox One",
    "nintendo switch 2": "Switch 2",
    "nintendo switch": "Switch",
    "pc (microsoft windows)": "PC",
    "apple macintosh": "Mac"
  };
  var FAMILIES = [
    { generic: "playstation", precise: /^playstation \d/ },
    { generic: "xbox", precise: /^xbox (series|one)/ },
    { generic: "nintendo", precise: /^nintendo (switch|3ds|ds|wii)/ }
  ];
  var parts = String(p).split(",").map(function (x) { return x.trim(); }).filter(Boolean);
  var lower = parts.map(function (x) { return x.toLowerCase(); });
  var out = [];
  for (var i = 0; i < parts.length; i++) {
    var fam = null;
    for (var f = 0; f < FAMILIES.length; f++) {
      if (lower[i] === FAMILIES[f].generic) { fam = FAMILIES[f]; break; }
    }
    if (fam) {
      var precisExiste = false;
      for (var k = 0; k < lower.length; k++) {
        if (fam.precise.test(lower[k])) { precisExiste = true; break; }
      }
      if (precisExiste) continue;
    }
    var label = LABELS[lower[i]] || parts[i];
    if (out.indexOf(label) === -1) out.push(label);
  }
  return out.join(", ");
}
function getHypeLabel(item) {
  if (!item) return null;
  var score = Number(item.popularity || 0);
  if (score < 70) return null;
  var today = new Date().toISOString().slice(0, 10);
  if (item.releaseDate && item.releaseDate <= today) return "Populaire";
  if (item.releaseDate && item.releaseDate > today) return "Très attendu";
  return null;
}

function renderSearchCard(item, domain) {
  var status = getStatusLabel(item);
  var media = item.cover ? "<img src=\"" + item.cover + "\" alt=\"" + displayTitle(item) + "\" loading=\"lazy\" />" : "<div class=\"item-placeholder\">Aucune image</div>";
  var info = (typeof simplifyPlatform === "function" ? simplifyPlatform(item.platform) : item.platform) || item.genre || "Information à venir";
  var hasTrailer = item.trailerUrl && ytId(item.trailerUrl);
  var videoId = hasTrailer ? ytId(item.trailerUrl) : null;
  var screens = parseScreenshots(item);
  var screensAttr = !hasTrailer && screens.length ? " data-screens='" + JSON.stringify(screens) + "'" : "";
  var hype = typeof getHypeLabel === "function" ? getHypeLabel(item) : null;
  var hypeBadge = "";
  if (hype === "Populaire") hypeBadge = "<span class=\"item-badge popular\">Populaire</span>";
  else if (hype === "Très attendu") hypeBadge = "<span class=\"item-badge anticipated\">Très attendu</span>";
  return "<article class=\"item-card" + (hasTrailer ? " has-trailer" : "") + "\"" +
    " data-id=\"" + item.id + "\" data-domain=\"" + domain + "\" data-type=\"" + (domain === "games" ? "game" : "anime") + "\" data-release-date=\"" + (item.releaseDate || "") + "\"" +
    (videoId ? " data-yt=\"" + videoId + "\"" : "") + screensAttr + ">" +
    "<div class=\"item-media\">" + media + "</div>" +
    "<div class=\"item-hover-video\"></div>" +
    (hasTrailer ? "<div class=\"trailer-band top\" data-band-id=\"" + item.id + "\" data-band-domain=\"" + domain + "\"></div><div class=\"trailer-band bottom\" data-band-id=\"" + item.id + "\" data-band-domain=\"" + domain + "\"></div>" : "") +
    "<div class=\"item-hover-slides\"></div>" +
    "<div class=\"item-overlay\"></div>" +
    "<button class=\"fav-heart\" data-fav-id=\"" + item.id + "\" data-fav-type=\"" + domain + "\" aria-label=\"Favori\">♡</button>" +
    "<div class=\"item-body\">" +
    "<h3>" + displayTitle(item) + "</h3>" +
    dateBox(item) + platChips(item, domain) + hypePill(item, domain) +
    "</div></article>";
}

var input = document.getElementById("homeSearch");
var btn = document.getElementById("homeSearchBtn");
var resultsDiv = document.getElementById("homeSearchResults");
var row = document.getElementById("homeSearchRow");

async function doSearch() {
  var q = input ? input.value.trim() : '';
  if (!q || !resultsDiv || !row) return;
  resultsDiv.style.display = "block";
  row.innerHTML = '<p class="section-loading">Recherche…</p>';
  try {
    // /feed/search interroge les trois colonnes de titre et decoupe la
    // requete en mots. getAnimeItems('search=') ne fait ni l'un ni l'autre.
    var res = await fetch('/api/feed/search?q=' + encodeURIComponent(q) + '&type=all');
    var data = await res.json();
    var all = (data.items || []).map(function(i) {
      return Object.assign({}, i, { _d: i.type === 'game' ? 'games' : 'anime' });
    });
    row.innerHTML = all.length ? all.map(function(i) { return renderSearchCard(i, i._d); }).join('') : '<p class="section-empty">Aucun résultat.</p>';
  } catch(e) { row.innerHTML = '<p class="section-empty">Erreur.</p>'; }
}

input?.addEventListener("input", function() {
  if (!input.value.trim() && resultsDiv) resultsDiv.style.display = "none";
});

btn?.addEventListener("click", doSearch);
input?.addEventListener("keydown", function(e) { if (e.key === "Enter") doSearch(); });
</script>

<!-- DESIGN-BLEU-FOND-DEBUT : le personnage de « Cette semaine » en haut a droite, et la couleur de l'episode -->
<script>
/* ═══ LE PERSONNAGE DE « CETTE SEMAINE » EN HAUT A DROITE, ET LA COULEUR DE L'EPISODE (Caméléon) ═══
   Ce script pose, en haut a droite, l'illustration de l'episode affiche dans « Cette semaine »
   (la meme image que la diapositive : la jaquette agrandie par IA, donc nette),
   et le numero de l'episode en japonais (第24話). Fondu enchaine quand la
   diapositive change, comme le fond precedent.
     > 1060 px : boite de 50 % de large (900 px au plus), du haut de page
                 jusqu'a 120 px sous le haut de « Cette semaine »
     <= 1060 px : 74 % de large, du haut de page jusqu'au haut de « Cette semaine »
   Cadrage : la jaquette est cadree sur le visage du personnage principal
   (data-foyer="x y l" sur la diapositive : centre du visage et largeur, en %
   de l'image, calcules la nuit par detection de visage) ; sans visage, sur le
   haut du centre. Le CSS donne la cible : --gc-fx, --gc-fy (ou poser le visage
   dans la boite) et --gc-fw (largeur du visage, en part de la boite).
   Tout l'habillage (bichromie, fondus, cadre) est dans le CSS. */
(function () {
  var shell = document.querySelector(".page-shell");
  var acc = document.querySelector(".acc-haut");
  if (!shell || !acc || !document.getElementById("weekRadar")) return;

  var gc = document.createElement("div");
  gc.className = "gc";
  gc.setAttribute("aria-hidden", "true");
  gc.innerHTML = '<div class="gc-box"><i></i><i></i><b class="gc-ep"></b></div>';
  shell.parentNode.insertBefore(gc, shell);
  var box = gc.querySelector(".gc-box"), calques = box.querySelectorAll("i"), ep = box.querySelector(".gc-ep");
  var TEL = window.matchMedia("(max-width: 1060px)");
  var url = "";

  // ── couleur de l'episode (design Caméléon) ─────────────────────────────────
  // La teinte dominante de l'image de l'episode affiche (0 a 360) : lue sur
  // data-couleur si le serveur la fournit, sinon calculee ici sur l'image (une
  // vignette de 48 px, une fois par image, gardee en memoire et dans le
  // navigateur). Le script en tire les couleurs --ep-* posees sur <html>.
  // La DENSITE est reglee par le CSS du design (--ep-k-fond, --ep-k-lueur,
  // --ep-k-verre, --ep-k-voile : 0 a 1) : la couleur de l'episode dans la
  // nuit, la lumiere, le verre des panneaux et les voiles. Les accents gardent
  // toujours leur pleine couleur. Sans teinte (image illisible) : tout est neutre.
  var racine = document.documentElement, cle = null;
  function nb(x) { return Math.round(x * 10) / 10; }
  function hsl(h, s, l, a) { return (a === undefined ? "hsl(" : "hsla(") + h + ", " + nb(s) + "%, " + nb(l) + "%" + (a === undefined ? ")" : ", " + nb(a * 100) / 100 + ")"); }
  function rgb(h, s, l) {
    s /= 100; l /= 100;
    var c = (1 - Math.abs(2 * l - 1)) * s, x = c * (1 - Math.abs((h / 60) % 2 - 1)), m = l - c / 2, r = 0, g = 0, b = 0;
    if (h < 60) { r = c; g = x; } else if (h < 120) { r = x; g = c; } else if (h < 180) { g = c; b = x; }
    else if (h < 240) { g = x; b = c; } else if (h < 300) { r = x; b = c; } else { r = c; b = x; }
    return [r, g, b].map(function (v) { return Math.round((v + m) * 255); }).join(", ");
  }
  function reglage(n) { var v = parseFloat(getComputedStyle(racine).getPropertyValue(n)); return isNaN(v) ? 1 : Math.max(0, Math.min(1, v)); }
  function teinter(v) {
    var h = v === null || v === "" || isNaN(Number(v)) ? null : ((Math.round(Number(v)) % 360) + 360) % 360;
    var kf = reglage("--ep-k-fond"), kl = reglage("--ep-k-lueur"), kv = reglage("--ep-k-verre"), kw = reglage("--ep-k-voile");
    var c = [h, kf, kl, kv, kw].join(" ");
    if (c === cle) return;
    cle = c;
    var t = h === null ? 0 : h, s = h === null ? 0 : 1, st = racine.style;
    st.setProperty("--ep-a", hsl(t, 85 * s, 72));             // accent clair (pastilles, onglet actif)
    st.setProperty("--ep-b", hsl(t, 70 * s, 56));             // accent profond (bas du degrade)
    st.setProperty("--ep-c", hsl(t, 80 * s, 58, .3 * kl));    // lumiere
    st.setProperty("--ep-c2", hsl(t, 80 * s, 58, .16 * kl));  // lumiere douce
    st.setProperty("--ep-d", hsl(t, 16 * s * kf, 9));         // nuit teintee (haut)
    st.setProperty("--ep-e", hsl(t, 12 * s * kf, 4));         // nuit teintee (bas)
    st.setProperty("--ep-f", hsl(t, 70 * s, 72, .34));        // filets et bords teintes
    st.setProperty("--ep-g", hsl(t, 75 * s, 87));             // texte pale teinte
    st.setProperty("--ep-h", hsl(t, 80 * s, 76, .55));        // reflet teinte (aretes)
    st.setProperty("--ep-p1", hsl(t, 20 * s * kv, 16, .5));   // verre teinte (haut)
    st.setProperty("--ep-p2", hsl(t, 16 * s * kv, 7, .8));    // verre teinte (bas)
    st.setProperty("--ep-rgb", rgb(t, 16 * s * kw, 6));       // voile sur les images, en r, g, b
  }

  // teinte dominante : histogramme des teintes (24 cases) pondere par la
  // vivacite, puis la fenetre de 45 degres la plus lourde et sa moyenne
  // circulaire. Les gris et les noirs ne comptent pas.
  function teinteDominante(d) {
    var poids = [], sx = [], sy = [], k;
    for (k = 0; k < 24; k++) { poids[k] = 0; sx[k] = 0; sy[k] = 0; }
    for (var i = 0; i < d.length; i += 4) {
      var r = d[i] / 255, g = d[i + 1] / 255, b = d[i + 2] / 255, mx = Math.max(r, g, b), mn = Math.min(r, g, b);
      var v = mx, s = mx ? (mx - mn) / mx : 0;
      if (v < 0.2 || s < 0.18) continue;
      var c = mx - mn, h = mx === r ? ((g - b) / c) % 6 : mx === g ? (b - r) / c + 2 : (r - g) / c + 4;
      h /= 6; if (h < 0) h += 1;
      var w = s * v * v;
      k = Math.floor(h * 24) % 24;
      poids[k] += w; sx[k] += w * Math.cos(2 * Math.PI * h); sy[k] += w * Math.sin(2 * Math.PI * h);
    }
    var best = -1, lourd = 0;
    for (k = 0; k < 24; k++) {
      var t = poids[(k + 23) % 24] + poids[k] + poids[(k + 1) % 24];
      if (t > lourd) { lourd = t; best = k; }
    }
    if (best < 0) return null;
    var x = 0, y = 0;
    [(best + 23) % 24, best, (best + 1) % 24].forEach(function (j) { x += sx[j]; y += sy[j]; });
    return Math.round((Math.atan2(y, x) * 180 / Math.PI + 360) % 360);
  }
  var MEMO = {}, GARDE = "gn-teintes", garde = {};
  try { garde = JSON.parse(localStorage.getItem(GARDE) || "{}") || {}; } catch (e) { garde = {}; }
  function teinteImage(src, fin) {
    if (Object.prototype.hasOwnProperty.call(MEMO, src)) { fin(MEMO[src]); return; }
    if (typeof garde[src] === "number") { MEMO[src] = garde[src]; fin(garde[src]); return; }
    var im = new Image();
    im.crossOrigin = "anonymous";          // l'image doit autoriser la lecture (CORS) ; sinon : neutre
    im.onload = function () {
      var h = null;
      try {
        var w = 48, hh = Math.max(1, Math.round(48 * im.naturalHeight / im.naturalWidth));
        var cv = document.createElement("canvas"); cv.width = w; cv.height = hh;
        var cx = cv.getContext("2d");
        cx.imageSmoothingEnabled = true; cx.imageSmoothingQuality = "high";
        cx.drawImage(im, 0, 0, w, hh);
        h = teinteDominante(cx.getImageData(0, 0, w, hh).data);
      } catch (e) { h = null; }
      MEMO[src] = h;
      if (h !== null && src.length < 400) {   // adresses courtes seulement (pas d'image en data:)
        try {
          if (Object.keys(garde).length > 300) garde = {};
          garde[src] = h; localStorage.setItem(GARDE, JSON.stringify(garde));
        } catch (e) { /* stockage plein ou interdit : tant pis */ }
      }
      fin(h);
    };
    im.onerror = function () { MEMO[src] = null; fin(null); };
    // image d'un autre site : adresse a part, pour ne pas reprendre la copie deja
    // en cache sans autorisation de lecture (celle de la diapositive)
    var u = src;
    try {
      if (/^https?:/i.test(src) && new URL(src, location.href).origin !== location.origin) u = src + (src.indexOf("?") < 0 ? "?" : "&") + "gn-teinte=1";
    } catch (e) { u = src; }
    im.src = u;
  }
  function couleur(carte, src) {
    var v = carte.getAttribute("data-couleur");
    if (v !== null && v !== "") { teinter(v); return; }
    if (!src) { teinter(null); return; }
    teinteImage(src, function (h) { if (url === src) teinter(h); });
  }

  function piste() {
    var jours = document.querySelectorAll("#weekRadar .wr-jour");
    for (var k = 0; k < jours.length; k++) {
      if (jours[k].getBoundingClientRect().width > 0) return jours[k].querySelector(".sl-track");
    }
    return null;
  }

  function cadrer(i) {
    var W = Number(i.dataset.w), H = Number(i.dataset.h);
    if (!W || !H) return;
    var f = (i.dataset.foyer || "").split(" ").map(Number), cs = getComputedStyle(box);
    var bw = box.clientWidth, bh = box.clientHeight;
    var tx = parseFloat(cs.getPropertyValue("--gc-fx")) || 0.62, ty = parseFloat(cs.getPropertyValue("--gc-fy")) || 0.4;
    var tw = parseFloat(cs.getPropertyValue("--gc-fw")) || 0.16;
    var vu = f.length === 3 && f[2] > 0, fx = vu ? f[0] / 100 : 0.5, fy = vu ? f[1] / 100 : 0.3;
    var s = Math.max(bw / W, bh / H, vu ? tw * bw / (f[2] / 100 * W) : 0), iw = W * s, ih = H * s;
    var x = Math.min(0, Math.max(bw - iw, tx * bw - fx * iw)), y = Math.min(0, Math.max(bh - ih, ty * bh - fy * ih));
    i.style.backgroundSize = iw + "px " + ih + "px";
    i.style.backgroundPosition = x + "px " + y + "px";
  }

  function placer() {
    var a = acc.getBoundingClientRect(), y = a.top + scrollY, l, h;
    if (TEL.matches) { l = Math.round(innerWidth * 0.68); h = Math.max(220, y); }
    else { l = Math.min(900, Math.round(innerWidth * 0.5)); h = y + 120; }
    box.style.cssText = "width:" + l + "px;height:" + h + "px";
    gc.style.height = h + "px";
    for (var k = 0; k < calques.length; k++) cadrer(calques[k]);
  }

  function fondu(src, n, w, h, foyer) {
    var on = box.querySelector("i.on");
    var suiv = on === calques[0] ? calques[1] : calques[0];
    suiv.dataset.w = w; suiv.dataset.h = h; suiv.dataset.foyer = foyer || "";
    suiv.style.backgroundImage = 'url("' + src.replace(/"/g, "%22") + '")';
    cadrer(suiv);
    suiv.classList.add("on");
    if (on) on.classList.remove("on");
    ep.innerHTML = n ? "第<span>" + n + "</span>話" : "";
  }

  function appliquer() {
    var p = piste();
    if (!p) return;
    var cartes = p.querySelectorAll(":scope > .item-card");
    if (!cartes.length) return;
    var k = Math.max(0, Math.min(cartes.length - 1, Math.round(p.scrollLeft / Math.max(1, p.clientWidth))));
    var img = cartes[k].querySelector(".item-media img");
    var src = img ? (img.currentSrc || img.src) : "";
    var b = cartes[k].querySelector(".se-m b");
    var n = b ? (b.textContent.match(/\d+/) || [""])[0] : "";
    var foyer = cartes[k].getAttribute("data-foyer") || "";
    if (src === url) return;
    url = src;
    couleur(cartes[k], src);
    placer();
    if (!src) return;
    if (img.complete && img.naturalWidth) { fondu(src, n, img.naturalWidth, img.naturalHeight, foyer); return; }
    var pre = new Image();
    pre.onload = function () { if (url === src) fondu(src, n, pre.naturalWidth, pre.naturalHeight, foyer); };
    pre.src = src;
  }

  var largeur = innerWidth;
  function redimensionner() {
    if (TEL.matches && innerWidth === largeur) return;
    largeur = innerWidth;
    placer();
  }
  document.addEventListener("scroll", appliquer, true);
  addEventListener("resize", redimensionner);
  if (TEL.addEventListener) TEL.addEventListener("change", placer);
  if (window.ResizeObserver) { var ro = new ResizeObserver(placer); ro.observe(acc); }

  // bichromie bleue (variante 1, 3, 4) : un filtre SVG, partage par la page
  var svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
  svg.setAttribute("width", "0"); svg.setAttribute("height", "0"); svg.setAttribute("aria-hidden", "true");
  svg.style.position = "absolute";
  svg.innerHTML =
    '<filter id="gn-duo" color-interpolation-filters="sRGB">' +
    '<feColorMatrix type="matrix" values="0.30 0.59 0.11 0 0  0.30 0.59 0.11 0 0  0.30 0.59 0.11 0 0  0 0 0 1 0"/>' +
    '<feComponentTransfer><feFuncR type="table" tableValues="0.008 0.05 0.36 0.86"/>' +
    '<feFuncG type="table" tableValues="0.04 0.16 0.6 0.95"/>' +
    '<feFuncB type="table" tableValues="0.13 0.42 0.95 1"/></feComponentTransfer></filter>' +
    '<filter id="gn-onde" x="0" y="0" width="100%" height="100%">' +
    '<feTurbulence type="fractalNoise" baseFrequency="0.006 0.09" numOctaves="2" seed="7" result="t"/>' +
    '<feDisplacementMap in="SourceGraphic" in2="t" scale="14" xChannelSelector="R" yChannelSelector="G"/></filter>';
  document.body.appendChild(svg);

  setInterval(appliquer, 400);
  appliquer();
  // apres le premier affichage, les couleurs glissent d'un episode a l'autre (CSS : .ep-pret)
  requestAnimationFrame(function () { requestAnimationFrame(function () { racine.classList.add("ep-pret"); }); });
})();
</script>
