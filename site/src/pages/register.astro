---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroHeader from "../components/HeroHeader.astro";
---

<BaseLayout noindex title="Inscription — GameNime" jetons="braise connexion">
  <HeroHeader activeTab="none" lienAccueil />
  <div class="auth-page">
    <div class="auth-card">
      <h1 class="auth-card__title">Créer un compte</h1>
      <p class="auth-card__subtitle">Rejoins GameNime pour suivre tes anime et jeux favoris</p>

      <div id="authError" class="auth-card__error hidden" role="alert"></div>

      <!-- Google et Discord (patch du 4 novembre 2026, copie de la maquette validée) : tout passe par l'API -->
      <div class="auth-social"><a class="auth-social__btn auth-social__btn--google" href="/api/auth/google?depuis=register" data-fournisseur="google"><span class="auth-social__logo" aria-hidden="true"><img src="data:image/svg+xml;base64," alt="" width="20" height="20"></span>Continuer avec Google</a><a class="auth-social__btn auth-social__btn--discord" href="/api/auth/discord?depuis=register" data-fournisseur="discord"><span class="auth-social__logo" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.317 4.37a19.79 19.79 0 0 0-4.885-1.515a.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0a12.64 12.64 0 0 0-.617-1.25a.077.077 0 0 0-.079-.037A19.74 19.74 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057a19.9 19.9 0 0 0 5.993 3.03a.078.078 0 0 0 .084-.028a14.09 14.09 0 0 0 1.226-1.994a.076.076 0 0 0-.041-.106a13.107 13.107 0 0 1-1.872-.892a.077.077 0 0 1-.008-.128a10.2 10.2 0 0 0 .372-.292a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127a12.299 12.299 0 0 1-1.873.892a.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028a19.839 19.839 0 0 0 6.002-3.03a.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.956-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.955-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.946 2.418-2.157 2.418z"/></svg></span>Continuer avec Discord</a></div><div class="auth-sep">ou avec ton e-mail</div>

      <div class="auth-card__field">
        <label for="regName">Pseudo</label>
        <input type="text" id="regName" placeholder="Ton pseudo" autocomplete="username" />
      </div>

      <div class="auth-card__field">
        <label for="regEmail">Email</label>
        <input type="email" id="regEmail" placeholder="ton@email.com" autocomplete="email" />
      </div>

      <div class="auth-card__field">
        <label for="regPassword">Mot de passe</label>
        <input type="password" id="regPassword" placeholder="8 caractères minimum" autocomplete="new-password" />
      </div>

      <button id="registerBtn" class="auth-card__btn" type="button">Créer mon compte</button>

      <p class="auth-card__switch">
        Déjà un compte ? <a href="/signin" id="lienConnexion">Se connecter</a>
      </p>
      <p class="auth-legal">En créant ton compte, tu acceptes les <a href="/cgu">conditions d'utilisation</a> et la <a href="/confidentialite">politique de confidentialité</a>.</p>
    </div>
  </div>
</BaseLayout>

<script>
  var apiBase = "/api";
  var nameInput = document.getElementById("regName") as HTMLInputElement | null;
  var emailInput = document.getElementById("regEmail") as HTMLInputElement | null;
  var passwordInput = document.getElementById("regPassword") as HTMLInputElement | null;
  var registerBtn = document.getElementById("registerBtn") as HTMLButtonElement | null;
  var errorDiv = document.getElementById("authError");
  var NOMS: Record<string, string> = { google: "Google", discord: "Discord" };

  // ── où revenir une fois le compte créé : ?retour=… (un chemin du site), sinon la page d'où l'on vient, sinon l'accueil ──
  function cheminSur(v: any) {
    return typeof v === "string" && v.length <= 300 && v.charAt(0) === "/" && v.charAt(1) !== "/" && !/[\\\u0000-\u001f\u007f]/.test(v) &&
      !/^\/(signin|register)(\/|\?|#|$)/.test(v) ? v : null;
  }
  function retourDe() {
    try { var p = cheminSur(new URL(location.href).searchParams.get("retour")); if (p) return p; } catch (e) {}
    try {
      if (document.referrer) {
        var r = new URL(document.referrer);
        if (r.origin === location.origin) { var c = cheminSur(r.pathname + r.search + r.hash); if (c) return c; }
      }
    } catch (e) {}
    return "/";
  }
  var RETOUR = retourDe();
  var SUITE = RETOUR !== "/" ? "&retour=" + encodeURIComponent(RETOUR) : "";
  var lienConnexion = document.getElementById("lienConnexion") as HTMLAnchorElement | null;
  if (lienConnexion && RETOUR !== "/") lienConnexion.href = "/signin?retour=" + encodeURIComponent(RETOUR);

  function showError(html: string) {
    if (!errorDiv) return;
    errorDiv.innerHTML = html;
    errorDiv.classList.remove("hidden");
  }
  function hideError() { if (errorDiv) { errorDiv.classList.add("hidden"); errorDiv.innerHTML = ""; } }
  function esc(s: any) { return String(s == null ? "" : s).replace(/[&<>"]/g, function (c) { return ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" } as any)[c]; }); }
  // l'erreur sous le bon champ
  function champKo(input: HTMLInputElement | null, msg: string) {
    if (!input) return;
    input.classList.add("champ-ko");
    var p = input.nextElementSibling;
    if (!p || !p.classList.contains("champ-msg")) { p = document.createElement("p"); p.className = "champ-msg"; input.insertAdjacentElement("afterend", p); }
    p.textContent = msg;
  }
  function champOk(input: HTMLInputElement | null) {
    if (!input) return;
    input.classList.remove("champ-ko");
    var p = input.nextElementSibling;
    if (p && p.classList.contains("champ-msg")) p.remove();
  }
  [nameInput, emailInput, passwordInput].forEach(function (i) { if (i) i.addEventListener("input", function () { champOk(i); }); });

  // ── Google et Discord : le bouton dit ce qui se passe ──
  var sociaux = Array.prototype.slice.call(document.querySelectorAll(".auth-social__btn")) as HTMLAnchorElement[];
  sociaux.forEach(function (a) {
    var f = a.dataset.fournisseur || "";
    a.href = apiBase + "/auth/" + f + "?depuis=register" + SUITE;
    a.addEventListener("click", function () {
      var t = a.lastChild;
      if (t) t.textContent = "Ouverture de " + NOMS[f] + "…";
      a.classList.add("est-en-cours");
    });
  });
  function remettreSociaux() {
    sociaux.forEach(function (a) {
      a.classList.remove("est-en-cours");
      var t = a.lastChild;
      if (t) t.textContent = "Continuer avec " + NOMS[a.dataset.fournisseur || ""];
    });
  }
  window.addEventListener("pageshow", function (e) { if (e.persisted) { remettreSociaux(); finEnvoi(); } });

  // ── ce que l'API annonce quand Google ou Discord n'a pas abouti (?erreur=<code>-<fournisseur>) ──
  (function () {
    try {
      var u = new URL(location.href), g = u.searchParams.get("erreur");
      if (g === null) return;
      u.searchParams.delete("erreur");
      history.replaceState(history.state, "", u.pathname + u.search + u.hash);
      var m = /^(annule|echec|email|indisponible|trop)-(google|discord)$/.exec(g);
      if (!m) return;
      var f = NOMS[m[2]];
      var MSG: Record<string, string> = {
        annule: "Connexion avec " + f + " annulée : rien n'a été changé.",
        echec: "La connexion avec " + f + " n'a pas abouti. Réessaie dans un instant.",
        email: m[2] === "discord" ? "Ton compte Discord n'a pas d'e-mail vérifié. Vérifie-le dans Discord, ou crée ton compte avec ton e-mail."
                                  : "Ton adresse Google n'est pas vérifiée. Vérifie-la chez Google, ou crée ton compte avec ton e-mail.",
        indisponible: "La connexion avec " + f + " n'est pas encore disponible : utilise ton e-mail.",
        trop: "Trop d'essais : réessaie dans 15 minutes."
      };
      showError(esc(MSG[m[1]]));
    } catch (e) {}
  })();

  // ── avec l'e-mail ──
  function finEnvoi() {
    if (!registerBtn) return;
    registerBtn.disabled = false;
    registerBtn.classList.remove("est-en-cours");
    registerBtn.textContent = "Créer mon compte";
  }
  var EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  var CHAMPS: Record<string, HTMLInputElement | null> = { displayName: nameInput, email: emailInput, password: passwordInput };
  var INVALIDE: Record<string, string> = { displayName: "Ce pseudo n'est pas valide.", email: "Cette adresse e-mail n'est pas valide.", password: "Ce mot de passe n'est pas valide." };
  async function doRegister() {
    if (!registerBtn || registerBtn.disabled) return;
    var name = nameInput ? nameInput.value.trim().replace(/\s+/g, " ") : "";
    var email = emailInput ? emailInput.value.trim() : "";
    var password = passwordInput ? passwordInput.value : "";
    hideError(); champOk(nameInput); champOk(emailInput); champOk(passwordInput);
    var bon = true;
    if (name && name.length < 2) { champKo(nameInput, "Ton pseudo doit faire au moins 2 caractères."); bon = false; }
    else if (name.length > 80) { champKo(nameInput, "Ton pseudo doit faire 80 caractères au plus."); bon = false; }
    if (!email) { champKo(emailInput, "Saisis ton e-mail."); bon = false; }
    else if (!EMAIL.test(email) || email.length > 190) { champKo(emailInput, "Cette adresse e-mail n'est pas valide."); bon = false; }
    if (!password) { champKo(passwordInput, "Choisis un mot de passe."); bon = false; }
    else if (password.length < 8) { var n = 8 - password.length; champKo(passwordInput, "8 caractères minimum : il en manque " + n + "."); bon = false; }
    else if (password.length > 100) { champKo(passwordInput, "100 caractères au plus."); bon = false; }
    if (!bon) return;

    registerBtn.disabled = true;
    registerBtn.classList.add("est-en-cours");
    registerBtn.textContent = "Création…";
    try {
      var res = await fetch(apiBase + "/auth/register", {
        method: "POST", credentials: "include",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify({ email: email, password: password, displayName: name || null })
      });
      var data: any = await res.json().catch(function () { return {}; });
      if (res.ok && data && data.ok) {
        if ((window as any).gnRetourPlusTard) (window as any).gnRetourPlusTard("Bienvenue sur GameNime", { detail: "Confirme ton e-mail avec le lien qu'on vient de t'envoyer" });
        window.location.href = RETOUR;
        return;
      }
      finEnvoi();
      if (res.status === 409) {
        showError(esc(data.error || "Un compte existe déjà avec cet e-mail.") + ' <a href="' + esc(lienConnexion ? lienConnexion.getAttribute("href") : "/signin") + '">Se connecter</a>');
      } else if (res.status === 400) {
        // le champ refusé, d'après la réponse de l'API
        var vus = 0;
        (Array.isArray(data.details) ? data.details : []).forEach(function (d: any) {
          var k = d && d.path && d.path[0];
          if (k && CHAMPS[k]) { champKo(CHAMPS[k], INVALIDE[k]); vus++; }
        });
        if (!vus) showError(esc("Vérifie les champs : une valeur n'est pas valide."));
      } else if (res.status === 429) {
        showError(esc(data.error || "Trop de tentatives. Réessaie dans 15 minutes."));
      } else {
        showError(esc("Le serveur ne répond pas. Réessaie dans un instant."));
      }
    } catch (e) {
      finEnvoi();
      showError(esc("Le serveur ne répond pas. Réessaie dans un instant."));
    }
  }

  if (registerBtn) registerBtn.addEventListener("click", doRegister);
  if (passwordInput) passwordInput.addEventListener("keydown", function(e) { if (e.key === "Enter") doRegister(); });
</script>
