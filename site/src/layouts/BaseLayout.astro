---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "GameNime",
  description = "Nouveautés animés et jeux vidéo : trailers, plateformes, dates.",
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <div class="page-shell">
      <slot />
    </div>
  </body>
</html>
