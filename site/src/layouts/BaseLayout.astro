---
import "../styles/global.css";
import "../styles/notification-drawer.css";
import "../styles/auth-user-menu.css";

interface Props {
  title?: string;
  description?: string;
  /** URL canonique de la page. Sans elle, toutes les pages declaraient
   *  l'accueil comme canonique — Google aurait ignore les fiches. */
  canonical?: string;
  /** Image de partage : la jaquette sur une fiche, le visuel du site ailleurs. */
  image?: string;
  /** "video.tv_show" ou "video.other" sur une fiche, "website" ailleurs. */
  ogType?: string;
  /** Accueil : la recherche se place dans la ligne des onglets (design Encre). */
  accueil?: boolean;
  /** Pages Anime, Jeux, A venir : design de l'accueil (Vitre · Cameleon) + bloc « CATALOGUE ». */
  catalogue?: boolean;
  /** Mes preferences, Connexion, Inscription : design de l'accueil (Vitre · Cameleon) + jetons de la page
   *  (bloc « PAGES » de global.css), par exemple « braise prefs ». */
  jetons?: string;
}
const {
  title = "GameNime",
  description = "Nouveautés animés et jeux vidéo : trailers, plateformes, dates.",
  canonical = "https://gamenime.fr",
  image = "https://gamenime.fr/og-image.jpg?v=2",
  ogType = "website",
  accueil = false,
  catalogue = false,
  jetons = "",
} = Astro.props;
// Design Encre · Noir et or (maquette validee le 4 octobre 2026) : les jetons
// lus par le bloc « DESIGN-ENCRE » de global.css. L'accueil seul porte la
// recherche dans la ligne des onglets.
// Accueil : design « Vitre », couleurs « Caméléon très léger » (maquettes validees le 5 octobre 2026),
// lu par le bloc « DESIGN-BLEU » de global.css. Les autres pages : Encre · Noir et or.
// Pages Anime, Jeux, A venir (prop catalogue) : le design de l'accueil (Vitre · Cameleon) et le bloc
// « CATALOGUE » de global.css, cartes « C · Jaquettes » (maquette validee le 6 octobre 2026).
// Mes preferences, Connexion, Inscription (prop jetons) : le design de l'accueil et le bloc « PAGES » de global.css,
// boutons et icones en braise (maquettes validees le 6 octobre 2026).
const gn = accueil ? "fond encre verre bleu vitre cameleon" : catalogue ? "fond encre verre bleu vitre cameleon catalogue" : jetons ? "fond encre verre bleu vitre cameleon " + jetons : "fond encre noir-or onglets";
---
<!doctype html>
<html lang="fr" data-gn={gn}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="GameNime" />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#d9a978" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="GameNime" />
    <script>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", function() {
          navigator.serviceWorker.register("/sw.js").catch(function(){});
        });
      }
    </script>
  {!accueil && !catalogue && !jetons && <link rel="preload" href="/fonts/shippori-mincho-b1-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin />}
  {!accueil && !catalogue && !jetons && <link rel="preload" href="/fonts/shippori-mincho-b1-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />}
  {!accueil && !catalogue && !jetons && <link rel="preload" href="/fonts/gn-pinceau.woff2" as="font" type="font/woff2" crossorigin />}
  {(accueil || catalogue || jetons) && <link rel="preload" href="/fonts/poppins-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />}
  {(accueil || catalogue || jetons) && <link rel="preload" href="/fonts/inter-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />}
</head>
  <body>
    <div class="page-shell">
      <slot />
    </div>
    <script>
      // Tracking visiteurs GameNime (anonyme, sans cookie)
      (function () {
        function track(isPing) {
          fetch('/api/track', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(isPing ? { ping: true } : { path: location.pathname, ref: document.referrer }),
            keepalive: true
          }).catch(function () {});
        }
        track(false);
        setInterval(function () { track(true); }, 30000);
      })();
    </script>
    <!-- REFLET-DEBUT : bloc ajoute par bandeau-reflet.sh (maquette « A · Reflet leger » validee le 8 octobre 2026) -->
    <script is:inline>
      /* Sur ordinateur, l'image du coin en haut a droite (Accueil, Anime, Jeux, A venir) se prolonge a gauche
         en miroir : copie retournee de ses calques, juste a sa gauche. L'habillage est dans global.css (bloc
         REFLET). Le coin est cree par le script de la page : tout de suite (Anime, Jeux, A venir) ou juste
         apres la lecture de la page (accueil) ; sans coin, rien. */
      (function () {
        function reflet() {
          var box = document.querySelector(".gc-box");
          if (!box || box.parentNode.querySelector(".gc-reflet")) return;
          var r = document.createElement("div");
          r.className = "gc-reflet";
          r.innerHTML = "<i></i><i></i>";
          box.parentNode.insertBefore(r, box);
          var de = box.querySelectorAll("i"), vers = r.querySelectorAll("i");
          function copie() {
            r.style.width = box.style.width; r.style.height = box.style.height; r.style.right = box.style.width;
            for (var k = 0; k < de.length && k < vers.length; k++) {
              vers[k].style.backgroundImage = de[k].style.backgroundImage;
              vers[k].style.backgroundSize = de[k].style.backgroundSize;
              vers[k].style.backgroundPosition = de[k].style.backgroundPosition;
              vers[k].className = de[k].className;
            }
          }
          new MutationObserver(copie).observe(box, { subtree: true, attributes: true, attributeFilter: ["style", "class"] });
          copie();
        }
        if (document.querySelector(".gc-box")) reflet();
        else document.addEventListener("DOMContentLoaded", reflet);
      })();
    </script>
    <!-- REFLET-FIN -->
  </body>
</html>
