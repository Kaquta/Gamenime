---
import "../styles/global.css";
import "../styles/notification-drawer.css";
import "../styles/auth-user-menu.css";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "GameNime",
  description = "Nouveautés animés et jeux vidéo : trailers, plateformes, dates.",
} = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://gamenime.fr/og-image.jpg?v=2" />
    <meta property="og:url" content="https://gamenime.fr" />
    <meta property="og:site_name" content="GameNime" />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://gamenime.fr/og-image.jpg?v=2" />
    <link rel="canonical" href="https://gamenime.fr" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#d9a978" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="GameNime" />
    <script>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", function() {
          navigator.serviceWorker.register("/sw.js").catch(function(){});
        });
      }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet" />
</head>
  <body>
    <div class="page-shell">
      <slot />
    </div>
    <script>
      // Tracking visiteurs GameNime (anonyme, sans cookie)
      (function () {
        function track(isPing) {
          fetch('/api/track', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(isPing ? { ping: true } : { path: location.pathname, ref: document.referrer }),
            keepalive: true
          }).catch(function () {});
        }
        track(false);
        setInterval(function () { track(true); }, 30000);
      })();
    </script>
  </body>
</html>
