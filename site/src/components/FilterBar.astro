---
interface Props {
  domain: "anime" | "games" | "both";
}
const { domain } = Astro.props;
const months = [
  "Janvier", "Février", "Mars", "Avril", "Mai", "Juin",
  "Juillet", "Août", "Septembre", "Octobre", "Novembre", "Décembre"
];
const genres = domain === "games"
  ? ["Action", "Adventure", "RPG", "Strategy", "Simulation", "Puzzle", "Shooter", "Platformer", "Indie", "Sports", "Racing", "Arcade", "Visual Novel", "Tactical", "Fighting"]
  : domain === "anime"
  ? ["Action", "Fantasy", "Comedy", "Drama", "Romance", "Adventure", "Supernatural", "Slice of Life", "Sci-Fi", "Mystery", "School", "Psychological", "Isekai", "Sports", "Horror"]
  : ["Action", "Adventure", "Fantasy", "Comedy", "Drama", "Romance", "Sci-Fi", "RPG", "Strategy", "Simulation", "Shooter", "Puzzle", "Supernatural", "Slice of Life", "Mystery", "Indie", "Platformer", "Sports", "Horror", "Isekai"];
const platforms = domain === "games"
  ? ["PC", "PlayStation", "Xbox", "Nintendo", "iOS", "Android"]
  : domain === "anime"
  ? ["Crunchyroll", "Netflix", "Muse Asia", "Ani-One Asia", "Disney+", "Hulu", "Amazon Prime Video", "Bilibili TV", "iQ", "Tencent Video", "HIDIVE"]
  : ["PC", "PlayStation", "Xbox", "Nintendo", "iOS", "Android", "Crunchyroll", "Netflix", "Muse Asia", "Ani-One Asia", "Disney+", "Hulu", "Amazon Prime Video", "Bilibili TV", "iQ", "Tencent Video", "HIDIVE"];
---
<div class="filter-bar container" data-domain={domain}>
  <div class="gn-panel" id="filterPanel">
    <div class="gn-panel-clip">
      <div class="gn-panel-body">
        <div class="gn-grp">
          <p class="gn-grp-label">Période</p>
          <div class="gn-duo">
            <select class="gn-select" id="filterMonth">
              <option value="">Mois</option>
              {months.map((m, i) => (<option value={String(i + 1).padStart(2, "0")}>{m}</option>))}
            </select>
            <select class="gn-select" id="filterYear">
              <option value="">Année</option>
              <option value="2026">2026</option>
              <option value="2027">2027</option>
            </select>
          </div>
        </div>
        <div class="gn-grp">
          <p class="gn-grp-label">Genres</p>
          <div class="gn-chips">
            {genres.map((g) => (
              <label class="gn-chip"><input type="checkbox" value={g} class="genre-check" /><span>{g}</span></label>
            ))}
          </div>
        </div>
        <div class="gn-grp">
          <p class="gn-grp-label">Plateformes</p>
          <div class="gn-chips">
            {platforms.map((pf) => (
              <label class="gn-chip"><input type="checkbox" value={pf} class="platform-check" /><span>{pf}</span></label>
            ))}
          </div>
        </div>
        <div class="gn-grp">
          <p class="gn-grp-label">Recherche</p>
          <input type="text" class="gn-input" id="filterSearch" placeholder="Titre…" />
        </div>
        <div class="gn-actions">
          <button class="gn-apply" id="filterApply" type="button">Filtrer</button>
          <button class="gn-reset" id="filterReset" type="button">Réinitialiser</button>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
  const panel = document.getElementById("filterPanel");
  const toggle = document.getElementById("filterToggle");
  const badge = document.getElementById("filterBadge");
  const applyBtn = document.getElementById("filterApply");
  const resetBtn = document.getElementById("filterReset");

  function getFilters() {
    const month = (document.getElementById("filterMonth") as HTMLSelectElement)?.value;
    const year = (document.getElementById("filterYear") as HTMLSelectElement)?.value;
    const search = (document.getElementById("filterSearch") as HTMLInputElement)?.value.trim();
    const genres = Array.from(document.querySelectorAll(".genre-check:checked")).map(
      (el) => (el as HTMLInputElement).value
    );
    const platforms = Array.from(document.querySelectorAll(".platform-check:checked")).map(
      (el) => (el as HTMLInputElement).value
    );
    return { month, year, search, genres, platforms };
  }
  function buildFilterParams(filters: ReturnType<typeof getFilters>): string {
    const params: string[] = [];
    if (filters.search) params.push(`search=${encodeURIComponent(filters.search)}`);
    if (filters.genres.length) params.push(`genre=${encodeURIComponent(filters.genres.join(","))}`);
    if (filters.platforms.length) params.push(`platform=${encodeURIComponent(filters.platforms.join(","))}`);
    if (filters.year && filters.month) {
      const lastDay = new Date(parseInt(filters.year), parseInt(filters.month), 0).getDate();
      params.push(`releasedAfter=${filters.year}-${filters.month}-01`);
      params.push(`releasedBefore=${filters.year}-${filters.month}-${lastDay}`);
    } else if (filters.year) {
      params.push(`releasedAfter=${filters.year}-01-01`);
      params.push(`releasedBefore=${filters.year}-12-31`);
    } else if (filters.month) {
      params.push(`releasedAfter=2026-${filters.month}-01`);
      const lastDay = new Date(2026, parseInt(filters.month), 0).getDate();
      params.push(`releasedBefore=2026-${filters.month}-${lastDay}`);
    }
    return params.join("&");
  }
  function refreshBadge() {
    if (!badge) return;
    const f = getFilters();
    const n = (f.month ? 1 : 0) + (f.year ? 1 : 0) + (f.search ? 1 : 0) + f.genres.length + f.platforms.length;
    badge.textContent = String(n);
    (badge as HTMLElement).hidden = n === 0;
  }
  function setOpen(open: boolean) {
    panel?.classList.toggle("open", open);
    toggle?.classList.toggle("open", open);
    toggle?.setAttribute("aria-expanded", open ? "true" : "false");
  }
  function applyFilters() {
    document.dispatchEvent(new CustomEvent("applyFilters", { detail: buildFilterParams(getFilters()) }));
    refreshBadge();
    setOpen(false);
  }
  function resetFilters() {
    (document.getElementById("filterMonth") as HTMLSelectElement).value = "";
    (document.getElementById("filterYear") as HTMLSelectElement).value = "";
    (document.getElementById("filterSearch") as HTMLInputElement).value = "";
    document.querySelectorAll(".genre-check, .platform-check").forEach((el) => {
      (el as HTMLInputElement).checked = false;
    });
    refreshBadge();
    document.dispatchEvent(new CustomEvent("applyFilters", { detail: "" }));
  }

  toggle?.addEventListener("click", () => setOpen(!panel?.classList.contains("open")));
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") setOpen(false); });
  document.querySelectorAll(".genre-check, .platform-check").forEach((el) =>
    el.addEventListener("change", refreshBadge)
  );
  document.getElementById("filterMonth")?.addEventListener("change", refreshBadge);
  document.getElementById("filterYear")?.addEventListener("change", refreshBadge);
  document.getElementById("filterSearch")?.addEventListener("input", refreshBadge);
  document.getElementById("filterSearch")?.addEventListener("keydown", (e) => {
    if ((e as KeyboardEvent).key === "Enter") applyFilters();
  });
  applyBtn?.addEventListener("click", applyFilters);
  resetBtn?.addEventListener("click", resetFilters);
  refreshBadge();
</script>
