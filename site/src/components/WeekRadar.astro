---
// « Cette semaine » — maquette validee le 3 octobre (session 35).
//
// Grande case gauche de l'accueil. Rendu CLIENT : le compte a rebours et le
// repere « aujourd'hui » doivent etre justes a l'heure de la VISITE, pas a
// celle du build. L'API renvoie de l'UTC -> conversion Europe/Paris a
// l'affichage.
//
// Les diapositives sont les .item-card du site, fabriquees par
// renderCardSemaine : le survol bande-annonce, le clic vers la modale et les
// favoris sont donc geres par les ecouteurs delegues de SectionBlock, sans une
// ligne de plus ici. Seul le defilement est a nous (lib/slider).
---
<section class="section-block" id="weekRadar" hidden>
  <div class="se-barre">
    <div class="se-tit"><h2>Cette semaine</h2><span class="se-plage" id="semPlage"></span></div>
    <div class="jours" id="semJours"></div>
  </div>
  <div class="wr-zone" id="semZone"></div>
</section>
 
<script>
import { getFeedWeek } from "../lib/api";
import { renderCardSemaine } from "../lib/fiche";
import { monterFenetre } from "../lib/slider";
 
const TZ = "Europe/Paris";
const MOIS = ["janv.","févr.","mars","avr.","mai","juin","juil.","août","sept.","oct.","nov.","déc."];
const JOURS_LONG = { Lun:"Lundi", Mar:"Mardi", Mer:"Mercredi", Jeu:"Jeudi", Ven:"Vendredi", Sam:"Samedi", Dim:"Dimanche" };
 
let DATA = null;
let jourSel = 0;
const FENETRES = [];

// IMAGES-HD-DEBUT — images HD de « Cette semaine » (patch images-hd, 5 octobre 2026)
// La jaquette d'AniList ne fait que 460 px de large : la case et le coin du
// personnage l'agrandissaient jusqu'a 3 fois, d'ou le flou. La tache gn-hd du
// serveur (toutes les heures) l'agrandit 4 fois par IA pour chaque nouvelle
// jaquette de la semaine et publie /hd/manifeste.json : pour chaque jaquette,
// ses images HD (960 et 1600 px de large), le visage du personnage (f : centre
// et largeur, en % de l'image) et sa teinte dominante (h, de 0 a 360).
// La diapositive prend l'image HD a la taille utile a l'ecran (la case et le
// coin prennent la meme : une seule image a telecharger), se cadre sur le
// visage (--fx, --fy), et donne au coin son cadrage (data-foyer) et sa couleur
// (data-couleur). Sans manifeste, ou pour une jaquette pas encore faite : la
// jaquette d'AniList, exactement comme avant.
let HD = null;
const HD_PRET = chargerHD();      // lance tout de suite, en meme temps que le flux

function chargerHD() {
  const ctl = typeof AbortController === "function" ? new AbortController() : null;
  const minuterie = ctl ? setTimeout(() => ctl.abort(), 2000) : 0;   // jamais plus de 2 s d'attente
  return fetch("/hd/manifeste.json", ctl ? { signal: ctl.signal } : {})
    .then((r) => (r.ok ? r.json() : null))
    .then((m) => (m && m.images && typeof m.images === "object" ? m : null))
    .catch(() => null)
    .finally(() => clearTimeout(minuterie));
}

// La plus petite image qui couvre le coin (la plus grande des deux zones), en
// pixels de l'ecran : 1600 px seulement quand 960 ne suffit pas.
function largeurHD(liste) {
  const tel = window.matchMedia("(max-width: 1060px)").matches;
  const besoin = (tel ? window.innerWidth : Math.min(900, window.innerWidth / 2)) * (window.devicePixelRatio || 1);
  const l = liste.filter((x) => Number.isInteger(x) && x > 0).sort((a, b) => a - b);
  return l.find((x) => x >= besoin * 0.9) || l[l.length - 1];
}

function imageHD(cover) {
  const e = HD && cover && Object.prototype.hasOwnProperty.call(HD.images, cover) ? HD.images[cover] : null;
  return e && typeof e.n === "string" && /^[\w-]+$/.test(e.n) ? e : null;
}

function coverHD(cover) {
  const e = imageHD(cover);
  const l = e ? largeurHD(Array.isArray(e.l) && e.l.length ? e.l : HD.largeurs || [960, 1600]) : 0;
  return e && l ? "/hd/" + e.n + "-" + l + ".webp" : cover || null;
}

// Apres le dessin d'un jour : cadrage sur le visage, couleur de l'episode.
function annoterHD(bloc, episodes) {
  if (!HD) return;
  const cartes = bloc.querySelectorAll(".sl-track > .item-card");
  episodes.forEach((ep, k) => {
    const e = imageHD(ep.cover), c = cartes[k];
    if (!e || !c) return;
    const f = e.f;
    if (Array.isArray(f) && f.length === 3 && f.every((x) => typeof x === "number" && isFinite(x)) && f[2] > 0) {
      c.setAttribute("data-foyer", f.join(" "));
      c.style.setProperty("--fx", f[0] + "%");
      c.style.setProperty("--fy", f[1] + "%");
    }
    if (typeof e.h === "number" && isFinite(e.h)) c.setAttribute("data-couleur", String(e.h));
  });
}
// IMAGES-HD-FIN
 
const E = (id) => document.getElementById(id);
const heure = (iso) =>
  new Date(iso).toLocaleTimeString("fr-FR", { timeZone: TZ, hour: "2-digit", minute: "2-digit" });
 
// Date YYYY-MM-DD EN HEURE DE PARIS, pas en UTC. Sans ca, un episode diffuse a
// 00h30 a Paris (22h30 UTC la veille) porterait la date de la veille et la
// carte annoncerait « hier » au lieu d'« aujourd'hui ». fr-CA produit
// directement le format attendu.
function dateParis(iso) {
  return new Intl.DateTimeFormat("fr-CA", {
    timeZone: TZ, year: "numeric", month: "2-digit", day: "2-digit"
  }).format(new Date(iso));
}
 
// « dans 2 h 14 », « demain », « diffusé » : le compte a rebours fait d'un
// programme une raison de revenir.
function relatif(iso) {
  const ms = new Date(iso).getTime() - Date.now();
  if (ms <= 0) return ["diffusé", true];
  const min = Math.round(ms / 60000);
  if (min < 60) return ["dans " + min + " min", false];
  const h = Math.floor(min / 60), m = min % 60;
  if (h < 24) return ["dans " + h + " h " + String(m).padStart(2, "0"), false];
  const j = Math.round(h / 24);
  return [j === 1 ? "demain" : "dans " + j + " jours", false];
}
 
// Un episode vu comme un item de catalogue. titleEnglish et popularity sont
// bien renvoyes par /feed/week : sans eux la carte afficherait le titre romaji,
// alors que tout le reste du site montre l'anglais.
// accLibelle et accEpisode sont lus par renderCardSemaine.
function versItem(e, jour) {
  const plates = String(e.platform || "").split(",").map((x) => x.trim()).filter(Boolean);
  return {
    id: e.id,
    slug: e.slug || null,
    title: e.title,
    titleEnglish: e.titleEnglish || null,
    cover: coverHD(e.cover),
    platform: e.platform || null,
    popularity: e.popularity || 0,
    releaseDate: dateParis(e.airingAt),
    releaseDatetime: e.airingAt,
    releasePrecision: "day",
    description: e.episodeNumber ? "[NEXT_EP:" + e.episodeNumber + "]" : "",
    trailerUrl: e.trailerUrl || null,
    accLibelle: libelleJour(jour) + " · " + heure(e.airingAt),
    accEpisode: e.episodeNumber || null,
    accPlateforme: plates[0] || null,
  };
}
 
function libelleJour(d) {
  if (d.date === DATA.today) return "Aujourd'hui";
  return (JOURS_LONG[d.dayName] || d.dayName) + " " + d.dayNum + " " + MOIS[Number(d.date.slice(5, 7)) - 1];
}
 
// Le compte a rebours, rafraichi toutes les 30 secondes dans la carte deja
// construite. On ne la refabrique pas : refaire le HTML couperait une
// bande-annonce en cours de lecture.
function majCompteurs() {
  if (!DATA) return;
  DATA.days.forEach((d, j) => {
    const zone = E("semZone").children[j];
    if (!zone) return;
    const cartes = zone.querySelectorAll(".item-card");
    d.episodes.forEach((e, k) => {
      const cd = cartes[k] && cartes[k].querySelector(".dcd");
      if (!cd) return;
      const [txt, passe] = relatif(e.airingAt);
      cd.textContent = txt;
      cd.classList.toggle("fait", passe);
    });
  });
}
 
function dessinerJours() {
  const zone = E("semJours");
  zone.innerHTML = DATA.days.map((d, j) => {
    const cls = "jr" + (j === jourSel ? " sel" : "")
      + (d.date === DATA.today ? " ajd" : "")
      + (d.date < DATA.today ? " passe" : "");
    const nom = JOURS_LONG[d.dayName] || d.dayName;
    return '<button type="button" class="' + cls + '" data-j="' + j + '"'
      + ' aria-label="' + nom + " " + d.dayNum + ", " + d.count + (d.count > 1 ? " épisodes" : " épisode") + '">'
      + '<span class="nj">' + (d.date === DATA.today ? "Auj." : (d.dayName || "")) + "</span>"
      + '<span class="dj">' + d.dayNum + "</span>"
      + (d.count ? '<span class="ep">' + d.count + "</span>" : "")
      + "</button>";
  }).join("");
  zone.querySelectorAll(".jr").forEach((b) => {
    b.addEventListener("click", () => choisirJour(Number(b.dataset.j)));
  });
  // Sur mobile la bande des jours glisse : on amene le jour choisi dans le champ.
  const actif = zone.querySelector(".jr.sel");
  if (actif && zone.scrollWidth > zone.clientWidth) {
    zone.scrollTo({ left: actif.offsetLeft - (zone.clientWidth - actif.offsetWidth) / 2, behavior: "smooth" });
  }
  const a = DATA.days[0], z = DATA.days[DATA.days.length - 1];
  E("semPlage").textContent =
    a.dayNum + " " + MOIS[Number(a.date.slice(5, 7)) - 1] + " – " +
    z.dayNum + " " + MOIS[Number(z.date.slice(5, 7)) - 1];
}
 
function coquille(diapos, points) {
  return '<div class="sl">'
    + '<div class="sl-track" tabindex="0">' + diapos + "</div>"
    + '<button type="button" class="sl-fl g" aria-label="Épisode précédent">‹</button>'
    + '<button type="button" class="sl-fl d" aria-label="Épisode suivant">›</button>'
    + '<div class="sl-pied"><span class="sl-cpt"></span></div>'
    + '<div class="pts">' + points + "</div>"
    + "</div>";
}
 
function dessinerSemaine() {
  const zone = E("semZone");
  zone.innerHTML = "";
  DATA.days.forEach((d, j) => {
    const bloc = document.createElement("div");
    bloc.className = "wr-jour" + (j === jourSel ? " on" : "");
    if (!d.episodes.length) {
      bloc.innerHTML = '<p class="section-empty">Aucun épisode ce jour-là.</p>';
      zone.appendChild(bloc);
      FENETRES.push(null);
      return;
    }
    const diapos = d.episodes.map((e) => renderCardSemaine(versItem(e, d), "anime")).join("");
    const points = d.episodes.map((e) =>
      '<button type="button" class="pt" aria-label="' + (e.titleEnglish || e.title) + ", " + heure(e.airingAt) + '">'
      + heure(e.airingAt) + "</button>").join("");
    bloc.innerHTML = coquille(diapos, points);
    annoterHD(bloc, d.episodes);
    zone.appendChild(bloc);
 
    const sl = bloc.querySelector(".sl");
    const f = monterFenetre(sl, {
      duree: 6500,
      actif: j === jourSel,
      vignettes: Array.prototype.slice.call(bloc.querySelectorAll(".pt")),
    });
    FENETRES.push(f);
    // Aujourd'hui, on ouvre sur le prochain episode a venir plutot que sur un
    // episode deja diffuse ce matin.
    if (f && d.date === DATA.today) {
      const k = d.episodes.findIndex((e) => new Date(e.airingAt).getTime() > Date.now());
      if (k > 0) f.aller(k, true);
    }
  });
  majCompteurs();
}
 
function choisirJour(j) {
  jourSel = j;
  E("semJours").querySelectorAll(".jr").forEach((b, k) => b.classList.toggle("sel", k === j));
  E("semZone").querySelectorAll(".wr-jour").forEach((b, k) => b.classList.toggle("on", k === j));
  FENETRES.forEach((f, k) => { if (f) f.actif(k === j); });
}
 
async function demarrer() {
  let data;
  try {
    data = await getFeedWeek();
  } catch (e) {
    return;                       // bloc absent plutot que bloc casse
  }
  HD = await HD_PRET;             // IMAGES-HD : le manifeste (null s'il manque : jaquettes d'AniList)
  if (!data || !data.days || !data.days.length) return;
  const total = data.days.reduce((n, d) => n + (d.episodes ? d.episodes.length : 0), 0);
  if (!total) return;
 
  DATA = data;
  const i = DATA.days.findIndex((d) => d.date === DATA.today);
  jourSel = i >= 0 ? i : 0;
 
  E("weekRadar").hidden = false;
  dessinerJours();
  dessinerSemaine();
  setInterval(majCompteurs, 30000);
}
 
demarrer();
</script>
