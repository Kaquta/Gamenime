---
const apiBase = import.meta.env.PUBLIC_API_BASE ?? "";
---

<div class="notif-root" data-api-base={apiBase}>
  <button id="notifBell" class="notif-bell" aria-label="Notifications" type="button">
    <span class="notif-bell__icon"><svg class="pg-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9M13.7 21a2 2 0 0 1-3.4 0"/></svg></span>
    <span id="notifBadge" class="notif-bell__badge hidden">0</span>
  </button>

  <div id="notifOverlay" class="notif-overlay"></div>

  <aside id="notifDrawer" class="notif-drawer" aria-hidden="true">
    <div class="notif-drawer__header">
      <h2><svg class="dp-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9M13.7 21a2 2 0 0 1-3.4 0"/></svg>Notifications</h2>
      <button id="notifClose" class="notif-drawer__close" aria-label="Fermer" type="button">✕</button>
    </div>

    <div class="nt-acts">
      <button id="notifReadAll" class="nt-act" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Tout marquer lu</button>
      <button id="notifDelRead" class="nt-act nt-act--del" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>Supprimer les lus <span class="nt-n" id="notifNRead"></span></button>
    </div>

    <div id="notifMeta" class="notif-drawer__section-label"></div>

    <div id="notifContent" class="notif-drawer__content">
      <div class="notif-state">Chargement...</div>
    </div>
  </aside>
</div>

<script is:inline>
  (function () {
    var root = document.currentScript && document.currentScript.previousElementSibling;
    while (root && !root.classList.contains('notif-root')) {
      root = root.previousElementSibling;
    }
    if (!root) return;

    var apiBase = root.dataset.apiBase || "";

    var bell = root.querySelector("#notifBell");
    var badge = root.querySelector("#notifBadge");
    var drawer = root.querySelector("#notifDrawer");
    var overlay = root.querySelector("#notifOverlay");
    var closeBtn = root.querySelector("#notifClose");
    var readAllBtn = root.querySelector("#notifReadAll");
    var meta = root.querySelector("#notifMeta");
    var content = root.querySelector("#notifContent");

    var isOpen = false;
    var isLoading = false;
    var unreadCount = 0;
    var notifications = [];

    function endpoint(path) {
      return "" + apiBase + path;
    }

    function escapeHtml(value) {
      return String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    function timeAgo(s) {
      if (!s) return "";
      var d = Math.floor((Date.now() - new Date(s).getTime()) / 1000);
      if (d < 60) return "À l'instant";
      if (d < 3600) return Math.floor(d / 60) + " min";
      if (d < 86400) return Math.floor(d / 3600) + "h";
      if (d < 604800) return Math.floor(d / 86400) + "j";
      return new Intl.DateTimeFormat("fr-FR", { day: "2-digit", month: "short" }).format(new Date(s));
    }

    function evIcon(t){
    // Pastille typee : chaque evenement a sa couleur, on identifie sa nature
    // avant de lire. Rendu identique sur tous les appareils, contrairement
    // aux emojis qui changent de dessin selon le systeme.
    var s=String(t||"");
    var d,c;
    if(s.indexOf("platform")!==-1){c="plat";d='<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>';}
    else if(s.indexOf("trailer")!==-1){c="trail";d='<circle cx="12" cy="12" r="9"/><path d="m10 8 6 4-6 4Z"/>';}
    else if(s.indexOf("release_date")!==-1){c="date";d='<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18"/>';}
    else{c="def";d='<path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9M13.7 21a2 2 0 0 1-3.4 0"/>';}
    return '<span class="ev-badge ev-'+c+'"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">'+d+'</svg></span>';
  }

    function renderBadge() {
      if (!badge) return;
      if (unreadCount > 0) {
        badge.textContent = String(unreadCount);
        badge.classList.remove("hidden");
      } else {
        badge.textContent = "0";
        badge.classList.add("hidden");
      }
    }

    function renderMeta() {
      if (!meta) return;
      if (!notifications.length) {
        meta.textContent = "";
        return;
      }
      meta.textContent =
        unreadCount > 0
          ? unreadCount + " notification" + (unreadCount > 1 ? "s" : "") + " non lue" + (unreadCount > 1 ? "s" : "")
          : "Tout est lu";
    }

    function renderContent() {
      if (!content) return;

      if (isLoading) {
        content.innerHTML = '<div class="notif-state">Chargement...</div>';
        return;
      }

      if (!notifications.length) {
        content.innerHTML = '<div class="notif-state">Aucune notification pour le moment.</div>';
        return;
      }

      content.innerHTML = notifications
        .map(function (item) {
          var p = item.payload || {};
          var title = p.title || "Mise à jour";
          var label = p.label || item.eventType;
          var detail = p.newValue || "";
          var icon = evIcon(item.eventType);
          var cls = item.isRead ? " is-read" : " is-unread";
          var ty = ntType(item.eventType);
          var thumb = p.cover
            ? '<img src="' + p.cover + '" alt="" loading="lazy" />'
            : '<span style="font-size:1.3rem;display:flex;align-items:center;justify-content:center;height:100%">' + icon + '</span>';

          return (
            '<div class="nt-row notif-card' + cls + '" data-id="' + item.id + '" data-item-type="' + (item.itemType || "") + '" data-item-id="' + (item.itemId || "") + '" style="cursor:pointer;position:relative">' +
              '<span class="nt-th"><span class="nt-cov">' + thumb + '</span><span class="nt-pin t-' + ty.k + '"><svg viewBox="0 0 24 24">' + ty.d + '</svg></span></span>' +
              '<span class="nt-b">' +
                '<span class="nt-t">' + escapeHtml(title) + '</span>' +
                '<span class="nt-m"><span class="nt-tag t-' + ty.k + '">' + escapeHtml(ty.lib || label) + '</span>' +
                (detail ? '<span class="nt-sub">' + escapeHtml(detail) + '</span>' : '') + '</span>' +
                '</span>' +
              '<span class="nt-w">' + timeAgo(item.eventAt || item.createdAt) + '</span>' +
              '<button class="nt-x notif-card__remove" data-notif-id="' + item.id + '" title="Supprimer" type="button">✕</button>' +
            '</div>'
          );
        })
        .join("");
      majNtActions();
    }

    function ntType(t) {
      var v = String(t || "");
      if (v.indexOf("platform") !== -1) return { k:"plat", lib:"Plateforme", d:'<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>' };
      if (v.indexOf("trailer") !== -1) return { k:"trail", lib:"Trailer", d:'<circle cx="12" cy="12" r="9"/><path d="m10 8 6 4-6 4Z"/>' };
      if (v.indexOf("release_date") !== -1) return { k:"date", lib:"Date", d:'<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18"/>' };
      if (v.indexOf("episode") !== -1) return { k:"ep", lib:"\u00c9pisode", d:'<rect x="2" y="4" width="20" height="16" rx="2"/><path d="M2 9h20M7 4v5M17 4v5"/>' };
      if (v.indexOf("new") !== -1) return { k:"new", lib:"Nouveaut\u00e9", d:'<path d="M12 5v14M5 12h14"/>' };
      return { k:"def", lib:"", d:'<path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9M13.7 21a2 2 0 0 1-3.4 0"/>' };
    }
    function majNtActions() {
      var lus = notifications.filter(function (x) { return x.isRead; }).length;
      var b1 = root.querySelector("#notifReadAll");
      var b2 = root.querySelector("#notifDelRead");
      var cn = root.querySelector("#notifNRead");
      if (b1) b1.disabled = (notifications.length - lus) === 0;
      if (b2) b2.disabled = lus === 0;
      if (cn) cn.textContent = lus > 0 ? "(" + lus + ")" : "";
    }
    async function supprimerLues() {
      try {
        var r = await fetch(endpoint("/notifications/read"), { method: "DELETE", credentials: "include", headers: { Accept: "application/json" } });
        if (!r.ok) return;
        notifications = notifications.filter(function (x) { return !x.isRead; });
        // renderContent ne rafraichit ni le badge ni le texte du haut :
        // ce sont deux fonctions separees, il faut les appeler aussi.
        renderContent();
        renderMeta();
        renderBadge();
      } catch (e) {}
    }
    async function fetchNotifications() {
      isLoading = true;
      renderContent();

      try {
        var res = await fetch(endpoint("/notifications"), {
          method: "GET",
          credentials: "include",
          headers: { Accept: "application/json" }
        });

        if (res.status === 401) {
          notifications = [];
          unreadCount = 0;
          renderBadge();
          renderMeta();
          if (content) {
            content.innerHTML = '<div class="notif-state">Connecte-toi pour voir tes notifications.</div>';
          }
          return;
        }

        if (!res.ok) throw new Error("HTTP " + res.status);

        var data = await res.json();
        notifications = Array.isArray(data.items) ? data.items : [];
        unreadCount = Number(data.unreadCount || 0);

        renderBadge();
        renderMeta();
        renderContent();
      } catch (error) {
        console.error("Erreur notifications:", error);
        if (content) {
          content.innerHTML = '<div class="notif-state">Impossible de charger les notifications.</div>';
        }
      } finally {
        isLoading = false;
        renderContent();
      }
    }

    async function markAllAsRead() {
      try {
        var res = await fetch(endpoint("/notifications/read-all"), {
          method: "POST",
          credentials: "include",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify({})
        });
        if (!res.ok) throw new Error("HTTP " + res.status);

        notifications = notifications.map(function (item) {
          return Object.assign({}, item, { isRead: true });
        });
        unreadCount = 0;
        renderBadge();
        renderMeta();
        renderContent();
      } catch (error) {
        console.error("Erreur read-all:", error);
      }
    }

    async function markOneAsRead(notificationId) {
      try {
        var res = await fetch(endpoint("/notifications/" + notificationId + "/read"), {
          method: "POST",
          credentials: "include",
          headers: { Accept: "application/json" }
        });
        if (!res.ok) throw new Error("HTTP " + res.status);

        var wasUnread = false;
        notifications = notifications.map(function (item) {
          if (item.id !== notificationId) return item;
          if (!item.isRead) wasUnread = true;
          return Object.assign({}, item, { isRead: true });
        });
        if (wasUnread && unreadCount > 0) unreadCount -= 1;
        renderBadge();
        renderMeta();
        renderContent();
      } catch (error) {
        console.error("Erreur read one:", error);
      }
    }

    async function openDrawer() {
      if (!drawer || !overlay) return;
      isOpen = true;
      drawer.classList.add("is-open");
      overlay.classList.add("is-open");
      drawer.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      await fetchNotifications();
    }

    // Expose l'ouverture du drawer pour le re-ouvrir apres fermeture d'un modal
    (window).__openNotifDrawer = function () { openDrawer(); };
    function closeDrawer() {
      if (!drawer || !overlay) return;
      isOpen = false;
      drawer.classList.remove("is-open");
      overlay.classList.remove("is-open");
      drawer.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    }

    if (bell) {
      bell.addEventListener("click", function () {
        if (isOpen) closeDrawer();
        else void openDrawer();
      });
    }
    if (closeBtn) closeBtn.addEventListener("click", closeDrawer);
    if (overlay) overlay.addEventListener("click", closeDrawer);
    if (readAllBtn) readAllBtn.addEventListener("click", function () { void markAllAsRead(); });
    var delReadBtn = root.querySelector("#notifDelRead");
    if (delReadBtn) delReadBtn.addEventListener("click", function () { void supprimerLues(); });

    if (content) {
      content.addEventListener("click", async function (event) {
        var target = event.target;
        // Cas 1: clic sur bouton ✕ supprimer (avant le card !)
        var rmBtn = target && target.closest ? target.closest(".notif-card__remove") : null;
        if (rmBtn) {
          event.stopPropagation();
          var nid = Number(rmBtn.dataset.notifId || 0);
          if (nid > 0) {
            try {
              var dr = await fetch(endpoint("/notifications/" + nid), { method: "DELETE", credentials: "include" });
              if (dr.ok) {
                var rc = rmBtn.closest(".notif-card");
                if (rc && rc.parentNode) rc.parentNode.removeChild(rc);
                notifications = notifications.filter(function(n) { return n.id !== nid; });
                renderMeta();
                if (!notifications.length && content) content.innerHTML = '<div class="notif-state">Aucune notification.</div>';
              }
            } catch (e) {}
          }
          return;
        }
        // Cas 2: clic sur la card -> marquer lue + ouvrir modal
        var card = target && target.closest ? target.closest(".notif-card") : null;
        if (!card) return;
        var id = Number(card.dataset.id || 0);
        if (id > 0) void markOneAsRead(id);
        var itemType = card.dataset.itemType;
        var itemId = card.dataset.itemId;
        if (itemType && itemId) {
          var domain = itemType === "game" ? "games" : "anime";
          (window).__reopenNotifDrawer = true;
          closeDrawer();
          if (typeof (window).__openItemModal === "function") {
            (window).__openItemModal(domain, itemId);
          } else {
            var targetPage = itemType === "anime" ? "/anime" : "/games";
            window.location.href = targetPage + "#item-" + itemId;
          }
        }
      });
    }

    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") closeDrawer();
    });

    async function pollBadge() {
      try {
        var res = await fetch(endpoint("/notifications?unreadOnly=1&limit=1"), {
          credentials: "include", headers: { Accept: "application/json" }
        });
        if (!res.ok) return;
        var data = await res.json();
        unreadCount = Number(data.unreadCount || 0);
        renderBadge();
      } catch(e) {}
    }

    // Real-time strategy: SSE for Premium, polling for Free users
    var sseSource = null;
    var pollInterval = null;
    var reconnectTimer = null;

    function startPolling() {
      if (pollInterval) return;
      pollInterval = setInterval(pollBadge, 60000);
    }

    function stopPolling() {
      if (pollInterval) {
        clearInterval(pollInterval);
        pollInterval = null;
      }
    }

    function startSSE() {
      if (sseSource) return;
      try {
        sseSource = new EventSource(endpoint("/notifications/stream"), { withCredentials: true });
        sseSource.addEventListener("notification", function(ev) {
          try {
            var notif = JSON.parse(ev.data);
            unreadCount = (unreadCount || 0) + 1;
            renderBadge();
            if (isOpen) {
              void fetchNotifications();
            }
          } catch(e) {}
        });
        sseSource.onerror = function() {
          try { sseSource.close(); } catch(e) {}
          sseSource = null;
          // Reconnect after 5s
          if (reconnectTimer) clearTimeout(reconnectTimer);
          reconnectTimer = setTimeout(function() {
            void initRealtimeStrategy();
          }, 5000);
        };
      } catch(e) {
        sseSource = null;
        startPolling(); // Fallback to polling
      }
    }

    function stopSSE() {
      if (sseSource) {
        try { sseSource.close(); } catch(e) {}
        sseSource = null;
      }
      if (reconnectTimer) {
        clearTimeout(reconnectTimer);
        reconnectTimer = null;
      }
    }

    async function initRealtimeStrategy() {
      try {
        var res = await fetch(endpoint("/auth/me"), { credentials: "include" });
        if (!res.ok) {
          // Not logged in, no notifications
          stopPolling();
          stopSSE();
          return;
        }
        var data = await res.json();
        var isPremium = !!(data.user && data.user.isPremium);

        if (isPremium) {
          stopPolling();
          startSSE();
        } else {
          stopSSE();
          startPolling();
        }
      } catch(e) {
        // Fallback to polling on error
        stopSSE();
        startPolling();
      }
    }

    void fetchNotifications();
    void initRealtimeStrategy();

    // Re-check strategy if page becomes visible again (handles premium upgrades/downgrades)
    document.addEventListener("visibilitychange", function() {
      if (!document.hidden) {
        void initRealtimeStrategy();
      }
    });
  })();
</script>
