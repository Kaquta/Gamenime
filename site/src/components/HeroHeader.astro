    </div>
    <div class="hero-topbar__right">
      <AuthUserMenu />
    </div>
  </div>
  <div class="hero-glow"></div>
  <h1 class="brand-mark">
    <span class="brand-text">GameNime</span>
    <span class="brand-kanji brand-n1"><span class="n1-fond" aria-hidden="true"></span><span class="n1-shin"><span>新</span></span><span class="n1-verre" aria-hidden="true"></span><span class="n1-reflets" aria-hidden="true"></span></span>
    {lienAccueil && <a class="brand-home" href="/" aria-label="GameNime : accueil"></a>}
  </h1>
  <div class="brand-line"></div>
  <p class="brand-subtitle">Animés et jeux : les sorties les plus attendues</p>
  <div class="brand-pills">
    <span class="brand-pill"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><polygon points="5 3 19 12 5 21 5 3"/></svg>Trailers</span>
    <span class="brand-pill"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>Plateformes</span>
    <span class="brand-pill"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>Dates de sortie</span>
  </div>
  <nav class="top-tabs" aria-label="Navigation principale">
    <div class="tabs-track">
      <span class="tab-indicator" aria-hidden="true"></span>
      <a class={activeTab === "home" ? "tab active" : "tab"} href="/">Accueil</a>
      <a class={activeTab === "anime" ? "tab active" : "tab"} href="/anime/">Anime</a>
      <a class={activeTab === "games" ? "tab active" : "tab"} href="/games/">Jeux</a>
      <a class={activeTab === "upcoming" ? "tab active" : "tab"} href="/upcoming/">À venir</a>
      <a class={activeTab === "calendar" ? "tab active" : "tab"} href="/calendrier/">Calendrier</a>
    </div>
    {activeTab !== "home" && activeTab !== "none" && activeTab !== "calendar" && (
      <>
        <span class="tabs-seam" aria-hidden="true"></span>
        <button type="button" class="tabs-filter" id="filterToggle" aria-label="Filtres" aria-expanded="false" aria-controls="filterPanel">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" width="16" height="16"><path d="M3 5h18M6 12h12M10 19h4"/></svg>
          <span class="tabs-filter-badge" id="filterBadge" hidden></span>
        </button>
      </>
    )}
  </nav>
</header>

<script is:inline>
  (function () {
    function place() {
      var nav = document.querySelector(".top-tabs");
      if (!nav) return;
      var ind = nav.querySelector(".tab-indicator");
      var act = nav.querySelector(".tab.active");
      if (!ind || !act) return;
      ind.style.transition = "none";
      ind.style.width = act.offsetWidth + "px";
      ind.style.transform = "translateX(" + act.offsetLeft + "px)";
      ind.style.opacity = "1";
    }
    place();
    window.addEventListener("resize", place);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(place);
    document.addEventListener("astro:page-load", place);
    document.addEventListener("DOMContentLoaded", function () {
      place();
      var btn = document.getElementById("filterToggle");
      if (btn && !document.getElementById("filterPanel")) btn.remove();
    });
  })();
</script>

<script is:inline>
  // Discord, TikTok et Instagram sur un seul rond au telephone (patch du 5 novembre 2026, copie de la maquette validee) :
  // le logo change toutes les 2 s ; un appui ouvre le reseau affiche, ou celui d'avant si le logo vient de changer
  // (moins de 0,4 s : celui qu'on visait). Sur ordinateur, le rond reste Discord (TikTok et Instagram sont en colonne).
  (function () {
    var a = document.querySelector(".hero-topbar__left .discord-link[data-reseaux]");
    if (!a || !window.matchMedia) return;
    var ics = a.querySelectorAll(".res-ic");
    var R = [
      { href: a.getAttribute("href"), titre: a.getAttribute("title"), label: a.getAttribute("aria-label") },
      { href: "https://www.tiktok.com/@gamenime.fr", titre: "Suivre GameNime sur TikTok", label: "Suivre GameNime sur TikTok" },
      { href: "https://www.instagram.com/gamenime.fr/", titre: "Suivre GameNime sur Instagram", label: "Suivre GameNime sur Instagram" }
    ];
    if (ics.length !== R.length) return;
    var tel = window.matchMedia("(max-width: 760px)");
    var i = 0, avant = 0, quand = 0, minuterie = null, relance = null;
    function montrer(k) {
      i = k;
      for (var j = 0; j < ics.length; j++) ics[j].classList.toggle("est-la", j === k);
      a.setAttribute("href", R[k].href);
      a.setAttribute("title", R[k].titre);
      a.setAttribute("aria-label", R[k].label);
    }
    function arreter() {
      if (minuterie) { clearInterval(minuterie); minuterie = null; }
      if (relance) { clearTimeout(relance); relance = null; }
    }
    function demarrer() {
      arreter();
      if (!tel.matches) { montrer(0); return; }
      if (document.hidden) return;
      minuterie = setInterval(function () { avant = i; quand = Date.now(); montrer((i + 1) % R.length); }, 2000);
    }
    // l'appui arrete la rotation ; si le logo vient de changer, le reseau d'avant revient (c'est lui qui s'ouvre)
    a.addEventListener("pointerdown", function () {
      if (!tel.matches) return;
      arreter();
      if (Date.now() - quand < 400) montrer(avant);
    });
    a.addEventListener("pointerup", function () { if (tel.matches) { arreter(); relance = setTimeout(demarrer, 1000); } });
    a.addEventListener("pointercancel", demarrer);
    if (tel.addEventListener) tel.addEventListener("change", demarrer); else if (tel.addListener) tel.addListener(demarrer);
    document.addEventListener("visibilitychange", demarrer);
    demarrer();
  })();
</script>
