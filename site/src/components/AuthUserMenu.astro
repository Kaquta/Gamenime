    if(pseudoInput){pseudoInput.addEventListener("keydown",function(e){if(e.key==="Enter")enregistrerPseudo();});pseudoInput.addEventListener("input",function(){champOk(pseudoInput,pseudoLigne);});}

    // Change password
    var cur=document.getElementById("currentPw"),nw=document.getElementById("newPw"),savePw=document.getElementById("savePw");
    async function changerMdp(){
      if(!cur||!nw||!savePw||savePw.disabled)return;
      champOk(cur);champOk(nw);
      var bon=true;
      if(!cur.value){champKo(cur,"Saisis ton mot de passe actuel.");bon=false;}
      if(!nw.value){champKo(nw,"Choisis le nouveau mot de passe.");bon=false;}
      else if(nw.value.length<8){champKo(nw,"8 caractères minimum : il en manque "+(8-nw.value.length)+".");bon=false;}
      else if(nw.value.length>100){champKo(nw,"100 caractères au plus.");bon=false;}
      if(!bon)return;
      var rate=function(t){retour(t,{type:"ko",detail:"Ton mot de passe reste le même",action:"Réessayer",surAction:changerMdp});};
      enCours(savePw,true);
      try{var res=await fetch(authEndpoint("/auth/password"),{method:"PATCH",credentials:"include",headers:{"Content-Type":"application/json",Accept:"application/json"},body:JSON.stringify({currentPassword:cur.value,newPassword:nw.value})});var data=await res.json().catch(function(){return {};});
      enCours(savePw,false);
      if(res.ok){cur.value="";nw.value="";var pf=document.getElementById("pwForm");if(pf)pf.classList.add("hidden");retour("Mot de passe changé",{detail:"Tes autres appareils sont déconnectés"});return;}
      if(res.status===401&&data.error&&data.error!=="Non authentifié"){champKo(cur,String(data.error));return;}
      if(res.status===401){sessionFinie();return;}
      if(res.status===400&&data.error){champKo(nw,String(data.error));return;}
      if((res.status===429||res.status===409)&&data.error){retour(String(data.error),{type:"ko"});return;}
      rate(echecDe(res,data,"Pas changé"));
      }catch(e){enCours(savePw,false);rate("Pas changé : le serveur ne répond pas");}
    }
    if(savePw)savePw.addEventListener("click",changerMdp);
    if(nw)nw.addEventListener("keydown",function(e){if(e.key==="Enter")changerMdp();});
    [cur,nw].forEach(function(i){if(i)i.addEventListener("input",function(){champOk(i);});});

    // Mot de passe oublie, ou a creer : un lien envoye a l'adresse du compte
    async function envoyerLien(btn,pourCreer){
      if(!btn||!currentUser||btn.classList.contains("est-en-cours"))return;
      var mail=currentUser.email;
      var rate=function(t){retour(t,{type:"ko",detail:"Aucun lien n'est parti",action:"Réessayer",surAction:function(){envoyerLien(btn,pourCreer);}});};
      enCours(btn,true);
      try{var res=await fetch(authEndpoint("/auth/request-password-reset"),{method:"POST",headers:{"Content-Type":"application/json",Accept:"application/json"},body:JSON.stringify({email:mail})});var data=await res.json().catch(function(){return {};});
      enCours(btn,false);
      if(res.ok&&data.ok){retour("Lien envoyé à "+mail,{detail:pourCreer?"Ouvre-le pour créer ton mot de passe":"Ouvre-le pour choisir un nouveau mot de passe"});return;}
      if(res.status===429){retour("Trop de demandes : réessaie dans 15 minutes",{type:"ko"});return;}
      rate(echecDe(res,data,"Pas envoyé"));
      }catch(e){enCours(btn,false);rate("Pas envoyé : le serveur ne répond pas");}
    }
    var oubli=document.getElementById("openResetFromAccount");if(oubli)oubli.addEventListener("click",function(){envoyerLien(oubli,false);});
    var creer=document.getElementById("sendPwLink");if(creer)creer.addEventListener("click",function(){envoyerLien(creer,true);});

    // Se connecter avec : lier (vers Google ou Discord, retour ici), delier (apres confirmation)
    accountDrawerContent.querySelectorAll("[data-lier]").forEach(function(a){
      a.addEventListener("click",function(){a.setAttribute("href",lienLier(a.dataset.lier));a.classList.add("est-en-cours");a.textContent="Ouverture…";});
    });
    accountDrawerContent.querySelectorAll("[data-delier]").forEach(function(b){
      b.addEventListener("click",function(){
        if(b.disabled)return;
        var f=b.dataset.delier,ligne=b.closest(".acc-lien");if(!ligne)return;
        var deja=ligne.nextElementSibling;
        if(deja&&deja.classList.contains("acc-conf")){deja.remove();return;}
        var nom=NOMS_F[f],autre=lies.filter(function(x){return x!==f;}).map(function(x){return NOMS_F[x];})[0];
        ligne.insertAdjacentHTML("afterend",'<div class="acc-conf">Délier '+nom+' ? Tu ne pourras plus te connecter avec '+nom+'. '+(aMdp?"Ton e-mail et ton mot de passe restent valables.":"Tu pourras toujours te connecter avec "+autre+".")+
          '<div class="acc-conf__acts"><button class="acc-act" type="button" data-conf-non>Annuler</button><button class="acc-act acc-act--dg" type="button" data-conf-oui>Délier</button></div></div>');
        var conf=ligne.nextElementSibling;
        conf.querySelector("[data-conf-non]").addEventListener("click",function(){conf.remove();});
        var oui=conf.querySelector("[data-conf-oui]");
        oui.addEventListener("click",function(){delier(f,oui);});
      });
    });

    // SESSION 13: brancher les 2 toggles in-app/email du drawer Compte sur l'API
    // Source de vérité = /me/notification-channels (même que page /account/preferences)
    // Une bascule ratee revient a sa place, avec « Reessayer » (patch du 4 novembre 2026).
    brancherBascule("toggleNotif","notificationsEnabled","Notifications sur le site");
    brancherBascule("toggleEmail","emailNotificationsEnabled","Notifications par e-mail");

    document.getElementById("accountLogout")?.addEventListener("click",function(){closeAccountDrawer();authLogout();});
  }
  function brancherBascule(id,champ,libelle){
    var t=document.getElementById(id);if(!t)return;
    t.addEventListener("change",async function(){
      var voulu=t.checked;
      var rate=function(x){retour(x,{type:"ko",detail:"Rien n'a été changé",action:"Réessayer",surAction:function(){if(!t.isConnected)return;t.checked=voulu;t.dispatchEvent(new Event("change"));}});};
      t.disabled=true;
      var body={};body[champ]=voulu;
      try{
        var res=await fetch(authEndpoint("/me/notification-channels"),{method:"PATCH",credentials:"include",headers:{"Content-Type":"application/json",Accept:"application/json"},body:JSON.stringify(body)});
        var d=await res.json().catch(function(){return {};});
        t.disabled=false;
        if(res.ok&&typeof d[champ]==="boolean"){t.checked=d[champ];if(currentUser)currentUser[champ]=d[champ];retour(libelle+(d[champ]?" activées":" coupées"));return;}
        t.checked=!voulu;
        if(res.status===401){sessionFinie();return;}
        rate(echecDe(res,d,"Pas enregistré"));
      }catch(e){t.disabled=false;t.checked=!voulu;rate(MUET);}
    });
  }
  async function delier(f,btn){
    if(!btn||btn.disabled)return;
    var nom=NOMS_F[f];
    var rate=function(t){retour(t,{type:"ko",detail:"Rien n'a été changé",action:"Réessayer",surAction:function(){if(btn.isConnected)delier(f,btn);}});};
    enCours(btn,true);
    try{var res=await fetch(authEndpoint("/auth/identites/"+f+"/delier"),{method:"POST",credentials:"include",headers:{"Content-Type":"application/json",Accept:"application/json"},body:"{}"});var data=await res.json().catch(function(){return {};});
    if(res.ok&&data.ok){majConnexion(data);if(currentUser&&currentUser.avatar===f){currentUser.avatar="avatar_01";}if(currentUser)showUser(currentUser.displayName,currentUser.email,currentUser.avatar,currentUser.isPremium);renderAccountDrawer();retour(nom+" délié",{detail:"Tu ne peux plus te connecter avec "+nom});return;}
    enCours(btn,false);
    if(res.status===401){sessionFinie();return;}
    if(res.status===409){majConnexion(data);renderAccountDrawer();retour(String(data.error||"C'est ta seule façon de te connecter"),{type:"ko"});return;}
    rate(echecDe(res,data,"Pas délié"));
    }catch(e){enCours(btn,false);rate("Pas délié : le serveur ne répond pas");}
  }
  function majConnexion(d){if(!currentUser||!d)return;if(Array.isArray(d.identites))currentUser.identites=d.identites;if(typeof d.motDePasse==="boolean")currentUser.motDePasse=d.motDePasse;}

  function openAccountDrawerFn(){closeDropdown();openDrawer(accountDrawer,accountOverlay);renderAccountDrawer();}
  if(accountDrawerClose)accountDrawerClose.addEventListener("click",function(){fermerTout("accountDrawer");});
  if(accountOverlay)accountOverlay.addEventListener("click",function(){fermerTout("accountDrawer");});
  document.getElementById("openAccountDrawer")?.addEventListener("click",function(){openAccountDrawerFn();marquerTiroir("accountDrawer");});

  // ── NOTIFICATIONS ────────────────────────────────
  var notifPDrawer=document.getElementById("notifPageDrawer"),notifPOverlay=document.getElementById("notifPageOverlay"),notifPClose=document.getElementById("notifPageClose"),notifPContent=document.getElementById("notifPContent"),notifPMeta=document.getElementById("notifPMeta"),notifPReadAll=document.getElementById("notifPReadAll");
  function closeNotifPageDrawer(){closeDrawerEl(notifPDrawer,notifPOverlay);}
  function evIcon(t){
    // Pastille typee : chaque evenement a sa couleur, on identifie sa nature
    // avant de lire. Rendu identique sur tous les appareils, contrairement
    // aux emojis qui changent de dessin selon le systeme.
    var s=String(t||"");
    var d,c;
    if(s.indexOf("platform")!==-1){c="plat";d='<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>';}
    else if(s.indexOf("trailer")!==-1){c="trail";d='<circle cx="12" cy="12" r="9"/><path d="m10 8 6 4-6 4Z"/>';}
    else if(s.indexOf("release_date")!==-1){c="date";d='<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18"/>';}
    else{c="def";d='<path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9M13.7 21a2 2 0 0 1-3.4 0"/>';}
    return '<span class="ev-badge ev-'+c+'"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">'+d+'</svg></span>';
  }
  async function openNotifPageDrawer(){
    closeDropdown();openDrawer(notifPDrawer,notifPOverlay);
    if(notifPContent)notifPContent.innerHTML='<div class="drawer-state">Chargement...</div>';
    try{var res=await fetch(authEndpoint("/notifications/"),{credentials:"include",headers:{Accept:"application/json"}});if(!res.ok)throw new Error("HTTP "+res.status);var data=await res.json();var items=data.items||[];var unread=Number(data.unreadCount||0);
    if(notifPMeta)notifPMeta.textContent=unread>0?unread+" non lue"+(unread>1?"s":""):"Tout est lu";
    if(!items.length){if(notifPContent)notifPContent.innerHTML='<div class="drawer-state">Aucune notification.</div>';return;}
if(notifPContent)notifPContent.innerHTML=items.map(function(item){var p=item.payload||{};var title=p.title||"Mise à jour";var label=p.label||item.eventType;var detail=p.newValue||"";var icon=evIcon(item.eventType);var uc=item.isRead?"":" notif-card--unread";var thumb=p.cover?'<img src="'+p.cover+'" alt="" />':'<span style="font-size:1.3rem;display:flex;align-items:center;justify-content:center;height:100%">'+icon+'</span>';return'<div class="notif-card'+uc+'" data-id="'+item.id+'" data-item-type="'+(item.itemType||"")+'" data-item-id="'+(item.itemId||"")+'" style="cursor:pointer;position:relative"><div class="notif-card__thumb">'+thumb+'</div><div class="notif-card__content"><div class="notif-card__title">'+escapeHtml(label)+' — '+escapeHtml(title)+'</div>'+(detail?'<div class="notif-card__text">'+escapeHtml(detail)+'</div>':'')+'<div class="notif-card__time">'+timeAgo(item.eventAt||item.createdAt)+'</div></div><button class="notif-card__remove" data-notif-id="'+item.id+'" title="Supprimer" type="button">✕</button></div>';}).join("");
    }catch(e){if(notifPContent)notifPContent.innerHTML='<div class="drawer-state">Erreur.</div>';}
  }
  (window).__openNotifPageDrawer=function(){openNotifPageDrawer();};
  if(notifPClose)notifPClose.addEventListener("click",closeNotifPageDrawer);
  if(notifPOverlay)notifPOverlay.addEventListener("click",closeNotifPageDrawer);
  document.getElementById("openNotifPage")?.addEventListener("click",function(){openNotifPageDrawer();});
  if(notifPReadAll)notifPReadAll.addEventListener("click",async function(){try{var res=await fetch(authEndpoint("/notifications/read-all"),{method:"POST",credentials:"include",headers:{"Content-Type":"application/json",Accept:"application/json"},body:JSON.stringify({})});if(res.ok)openNotifPageDrawer();}catch(e){}});
  if(notifPContent)notifPContent.addEventListener("click",async function(e){
    // Cas 1: bouton supprimer
    var rmBtn=e.target.closest(".notif-card__remove");
    if(rmBtn){
      e.stopPropagation();
      var nid=Number(rmBtn.dataset.notifId||0);
      if(nid>0){try{var dr=await fetch(authEndpoint("/notifications/"+nid),{method:"DELETE",credentials:"include"});if(dr.ok){var rc=rmBtn.closest(".notif-card");if(rc)rc.remove();}}catch(x){}}
      return;
    }
    // Cas 2: click sur la card -> marquer lue + ouvrir modal de l'item
    var card=e.target.closest(".notif-card");
    if(!card)return;
    var id=Number(card.dataset.id||0);
    if(id<=0)return;
    var itemType=card.dataset.itemType;
    var itemId=card.dataset.itemId;
    // Marquer comme lue (fire-and-forget)
    try{var res=await fetch(authEndpoint("/notifications/"+id+"/read"),{method:"POST",credentials:"include"});if(res.ok)card.classList.remove("notif-card--unread");}catch(e){}
    // Ouvrir modal de l'item si on a les infos
    if(itemType&&itemId){
      var domain=itemType==="game"?"games":"anime";
      (window).__reopenNotifPageDrawer=true;
      closeNotifPageDrawer();
      if(typeof window.__openItemModal==="function"){
        window.__openItemModal(domain,itemId);
      }else{
        var targetPage=itemType==="anime"?"/anime":"/games";
        window.location.href=targetPage+"#item-"+itemId;
      }
    }
  });

  var moiPret=fetchMe();
  (window).__gnMoi=moiPret;
  moiPret.then(function(u){
    if(!u)return;
    // retour de Google ou de Discord apres « Lier » : Mon compte se rouvre, la pastille dit ce qui s'est passe
    var c=(window).__gnCode;
    if(c&&["lie","deja-lie","annule","echec","email","indisponible","confirmer","trop"].indexOf(c.code)!==-1){openAccountDrawerFn();marquerTiroir("accountDrawer");return;}
    menuDemande();
  });
</script>

