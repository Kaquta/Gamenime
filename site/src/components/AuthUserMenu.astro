---
import NotificationDrawer from "./NotificationDrawer.astro";
const apiBase = import.meta.env.PUBLIC_API_BASE ?? "";
---

<div class="auth-ui" data-api-base={apiBase}>
  <div id="authGuest" class="auth-ui__guest hidden">
    <a href="/signin" class="auth-ui__signin">Sign in</a>
  </div>

  <div id="authUser" class="auth-ui__user hidden">
    <NotificationDrawer />
    <div class="auth-user-menu">
      <button id="authUserButton" class="auth-user-menu__trigger" type="button" aria-label="Menu profil">
        <span class="auth-user-menu__avatar" id="authAvatar"></span>
        <span class="auth-user-menu__name" id="authDisplayName"></span>
      </button>
      <div id="authUserDropdown" class="auth-user-menu__dropdown">
        <button class="auth-user-menu__item mnu" id="openFavDrawer" type="button"><svg class="mnu-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l8.8 8.8 8.8-8.8a5.5 5.5 0 0 0 0-7.8Z"/></svg><span class="mnu-tx">Mes favoris</span></button>
        <!-- Notifications : doublon avec la cloche, qui porte en plus le badge de non-lues.
             Le tiroir reste en place, SectionBlock le rouvre apres fermeture d'un modal. -->
        <a class="auth-user-menu__item mnu" href="/account/preferences"><svg class="mnu-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m13 2-9 12h7l-1 8 9-12h-7l1-8Z"/></svg><span class="mnu-tx">Mes préférences</span></a>
        <button class="auth-user-menu__item mnu" id="openAccountDrawer" type="button"><svg class="mnu-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1A1.7 1.7 0 0 0 4.6 8.6a1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z"/></svg><span class="mnu-tx">Compte</span></button>
        <!-- Premium retire : aucune offre en place -->
        <div class="mnu-sep"></div>
        <button id="authLogoutBtn" class="auth-user-menu__item mnu mnu--dg" type="button"><svg class="mnu-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg><span class="mnu-tx">Déconnexion</span></button>
      </div>
    </div>
  </div>
</div>

<!-- Favoris Drawer -->
<div id="favOverlay" class="drawer-overlay"></div>
<aside id="favDrawer" class="drawer-panel" aria-hidden="true">
  <div class="drawer-panel__header"><button class="drawer-panel__close dp-retour" type="button" aria-label="Retour au menu" title="Retour au menu">←</button><h2><svg class="dp-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l8.8 8.8 8.8-8.8a5.5 5.5 0 0 0 0-7.8Z"/></svg>Mes favoris</h2><button id="favDrawerClose" class="drawer-panel__close" type="button">✕</button></div>
  <div id="favDrawerCount" class="drawer-panel__meta"></div>
  <div class="fav-topbar">
    <button type="button" class="fav-lnk" id="favSelMode">Sélectionner</button>
  </div>
  <div id="favDrawerContent" class="drawer-panel__content"></div>
  <div class="fav-bar">
    <span class="fav-bar-n" id="favBarN">Aucun sélectionné<small>Tape une carte pour la choisir</small></span>
    <button type="button" class="fav-bar-b" id="favAll">Tout</button>
    <button type="button" class="fav-bar-b fav-bar-b--del" id="favDel" disabled>Retirer</button>
  </div>
</aside>

<!-- Compte Drawer -->
<div id="accountOverlay" class="drawer-overlay"></div>
<aside id="accountDrawer" class="drawer-panel" aria-hidden="true">
  <div class="drawer-panel__header"><button class="drawer-panel__close dp-retour" type="button" aria-label="Retour au menu" title="Retour au menu">←</button><h2><svg class="dp-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1A1.7 1.7 0 0 0 4.6 8.6a1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z"/></svg>Mon compte</h2><button id="accountDrawerClose" class="drawer-panel__close" type="button">✕</button></div>
  <div id="accountDrawerContent" class="drawer-panel__content"></div>
</aside>

<!-- Notifications Drawer -->
<div id="notifPageOverlay" class="drawer-overlay"></div>
<aside id="notifPageDrawer" class="drawer-panel" aria-hidden="true">
  <div class="drawer-panel__header"><h2><svg class="dp-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9M13.7 21a2 2 0 0 1-3.4 0"/></svg>Notifications</h2><button id="notifPageClose" class="drawer-panel__close" type="button">✕</button></div>
  <button id="notifPReadAll" class="drawer-panel__readall" type="button">Tout marquer comme lu</button>
  <div id="notifPMeta" class="drawer-panel__meta"></div>
  <div id="notifPContent" class="drawer-panel__content"></div>
</aside>


<script>
  var AVATARS = [
    { id:"avatar_01", name:"Renard", img:"/avatar_01.webp" },
    { id:"avatar_02", name:"Loup", img:"/avatar_02.webp" },
    { id:"avatar_03", name:"Panda", img:"/avatar_03.webp" },
    { id:"avatar_04", name:"Ours", img:"/avatar_04.webp" },
    { id:"avatar_05", name:"Lapin", img:"/avatar_05.webp" },
    { id:"avatar_06", name:"Shiba", img:"/avatar_06.webp" },
    { id:"avatar_07", name:"Raton", img:"/avatar_07.webp" },
    { id:"avatar_08", name:"Hibou", img:"/avatar_08.webp" },
    { id:"avatar_09", name:"Pingouin", img:"/avatar_09.webp" },
    { id:"avatar_10", name:"Koala", img:"/avatar_10.webp" }
  ];
  // les logos des comptes lies (patch du 4 novembre 2026) : le « G » de Google est celui du fichier officiel de Google,
  // pose par le patch ; celui de Discord est celui de l'en-tete
  var LOGO_GOOGLE='<img src="data:image/svg+xml;base64," alt="" width="18" height="18">';
  var LOGO_DISCORD='<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.317 4.37a19.79 19.79 0 0 0-4.885-1.515a.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0a12.64 12.64 0 0 0-.617-1.25a.077.077 0 0 0-.079-.037A19.74 19.74 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057a19.9 19.9 0 0 0 5.993 3.03a.078.078 0 0 0 .084-.028a14.09 14.09 0 0 0 1.226-1.994a.076.076 0 0 0-.041-.106a13.107 13.107 0 0 1-1.872-.892a.077.077 0 0 1-.008-.128a10.2 10.2 0 0 0 .372-.292a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127a12.299 12.299 0 0 1-1.873.892a.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028a19.839 19.839 0 0 0 6.002-3.03a.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.956-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.955-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.946 2.418-2.157 2.418z"/></svg>';
  var NOMS_F={google:"Google",discord:"Discord"};

  var authRoot=document.querySelector(".auth-ui");var authApiBase=authRoot?authRoot.dataset.apiBase||"":"";
  var authGuest=document.getElementById("authGuest"),authUser=document.getElementById("authUser"),authDisplayName=document.getElementById("authDisplayName"),authAvatar=document.getElementById("authAvatar"),authUserButton=document.getElementById("authUserButton"),authDropdown=document.getElementById("authUserDropdown"),authLogoutBtn=document.getElementById("authLogoutBtn");
  var currentUser=null;
  function authEndpoint(p){return authApiBase+p;}
  function getAv(id){for(var i=0;i<AVATARS.length;i++)if(AVATARS[i].id===id)return AVATARS[i];return AVATARS[0];}
  // ── la photo d'un compte lie comme avatar (patch du 5 novembre 2026, copie de la maquette validee) : l'API la garde
  // et la sert au seul titulaire, a /auth/photo/<f>?v=<empreinte> ; sans photo, l'avatar est un animal ──
  function photoDe(u,f){var l=u&&Array.isArray(u.identites)?u.identites:[];for(var i=0;i<l.length;i++)if(l[i]&&l[i].fournisseur===f&&/^[0-9a-f]{16}$/.test(String(l[i].photo||"")))return authEndpoint("/auth/photo/"+f+"?v="+l[i].photo);return null;}
  function avDe(u){var id=(u&&u.avatar)||"avatar_01";if(id==="google"||id==="discord"){var p=photoDe(u,id);return p?{id:id,name:"ta photo "+NOMS_F[id],img:p,photo:true}:AVATARS[0];}return getAv(id);}
  // l'image d'un avatar ; une photo jamais agrandie (les animaux le sont, pour cacher leur bord), et un animal si elle ne vient pas
  function imgAv(av){return av.photo?'<img src="'+escapeHtml(av.img)+'" alt="" class="avatar-img avatar-img--photo" onerror="this.onerror=null;this.classList.remove(\'avatar-img--photo\');this.src=\'/avatar_01.webp\'"/>':'<img src="'+av.img+'" alt="" class="avatar-img"/>';}
  function showGuest(){if(authGuest)authGuest.classList.remove("hidden");if(authUser)authUser.classList.add("hidden");}
  function showUser(name,email,avatar,isPremium){
    if(authGuest)authGuest.classList.add("hidden");if(authUser)authUser.classList.remove("hidden");
    var safeName=name&&String(name).trim()?String(name).trim():email.split("@")[0];
    if(authDisplayName)authDisplayName.textContent=safeName;
    var av=avDe({avatar:avatar,identites:currentUser&&currentUser.identites});
    if(authAvatar){authAvatar.innerHTML=imgAv(av);if(isPremium){authAvatar.classList.add("is-premium");}else{authAvatar.classList.remove("is-premium");}}
    var oldPill=document.getElementById("premiumPill");if(oldPill)oldPill.remove();
    if(isPremium&&authDisplayName){var pill=document.createElement("span");pill.id="premiumPill";pill.className="premium-pill";pill.innerHTML="<svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><polygon points=\"12 2 15 8 22 9 17 14 18 21 12 18 6 21 7 14 2 9 9 8\"/></svg><span class=\"premium-pill__text\">"+escapeHtml(safeName)+"</span>";authDisplayName.after(pill);authDisplayName.style.display="none";}else if(authDisplayName){authDisplayName.style.display="";}
    var premBtn=null; /* Premium desactive (session 33) : pas d'offre en place */
    if(premBtn){premBtn.style.display="none";}
  }
  async function fetchMe(){
    try{var res=await fetch(authEndpoint("/auth/me"),{method:"GET",credentials:"include",headers:{Accept:"application/json"}});
    if(res.status===401){showGuest();return null;}if(!res.ok)throw new Error("HTTP "+res.status);
    var data=await res.json();if(!data.user){showGuest();return null;}
    currentUser=data.user;showUser(data.user.displayName,data.user.email,data.user.avatar,data.user.isPremium);
    return currentUser;
    }catch(e){showGuest();return null;}
  }
  function toggleDropdown(){if(authDropdown)authDropdown.classList.toggle("is-open");}
  function closeDropdown(){if(authDropdown)authDropdown.classList.remove("is-open");}
  async function authLogout(){try{await fetch(authEndpoint("/auth/logout"),{method:"POST",credentials:"include"});closeDropdown();showGuest();if(typeof window.gnRetourPlusTard==="function")window.gnRetourPlusTard("Tu es déconnecté");window.location.reload();}catch(e){retour("Déconnexion impossible : le serveur ne répond pas",{type:"ko",detail:"Tu es toujours connecté",action:"Réessayer",surAction:authLogout});}}
  if(authUserButton)authUserButton.addEventListener("click",function(e){e.stopPropagation();toggleDropdown();});
  if(authLogoutBtn)authLogoutBtn.addEventListener("click",function(){authLogout();});
  document.addEventListener("click",function(e){if(!e.target.closest(".auth-user-menu"))closeDropdown();});
  document.addEventListener("keydown",function(e){if(e.key==="Escape"){closeDropdown();fermerTout("favDrawer");fermerTout("accountDrawer");closeNotifPageDrawer();}});

  function openDrawer(d,o){if(!d||!o)return;d.classList.add("is-open");o.classList.add("is-open");d.setAttribute("aria-hidden","false");document.body.style.overflow="hidden";}
  function closeDrawerEl(d,o){if(!d||!o)return;d.classList.remove("is-open");o.classList.remove("is-open");d.setAttribute("aria-hidden","true");document.body.style.overflow="";}
  function escapeHtml(v){return String(v).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");}
  function timeAgo(s){if(!s)return"";var d=Math.floor((Date.now()-new Date(s).getTime())/1000);if(d<60)return"À l'instant";if(d<3600)return Math.floor(d/60)+" min";if(d<86400)return Math.floor(d/3600)+"h";if(d<604800)return Math.floor(d/86400)+"j";return new Intl.DateTimeFormat("fr-FR",{day:"2-digit",month:"short"}).format(new Date(s));}
  // ── les retours apres une action (patch du 4 novembre 2026, copie de la maquette validee) ──
  // la pastille (public/retour.js) ; sans elle, rien ne casse
  function retour(t,o){if(typeof window.gnRetour==="function")window.gnRetour(t,o||{});}
  var MUET="Pas enregistré : le serveur ne répond pas";
  // le titre d'une pastille quand l'API a refuse : son message s'il est fait pour etre lu, sinon « le serveur ne repond pas »
  function echecDe(res,data,quoi){
    var e=data&&typeof data.error==="string"?data.error.trim():"";
    if(res&&res.status>=400&&res.status<500&&e&&/\s/.test(e))return quoi+" : "+e.charAt(0).toLowerCase()+e.slice(1).replace(/\.$/,"");
    return quoi+" : le serveur ne répond pas";
  }
  function sessionFinie(){retour("Ta session a expiré",{type:"ko",detail:"Reconnecte-toi pour continuer",action:"Se connecter",surAction:function(){window.location.href="/signin?retour="+encodeURIComponent(location.pathname+location.search+location.hash);}});}
  // un bouton qui travaille : il le dit, et ne prend plus de clic
  function enCours(b,oui){if(!b)return;b.classList.toggle("est-en-cours",!!oui);if(b.tagName==="BUTTON")b.disabled=!!oui;}
  // l'erreur sous le champ concerne (sous sa ligne, si le champ partage la ligne d'un bouton)
  function champKo(input,msg,apres){if(!input)return;input.classList.add("champ-ko");var a=apres||input;var p=a.nextElementSibling;if(!p||!p.classList.contains("champ-msg")){p=document.createElement("p");p.className="champ-msg";a.insertAdjacentElement("afterend",p);}p.textContent=msg;}
  function champOk(input,apres){if(!input)return;input.classList.remove("champ-ko");var a=apres||input;var p=a.nextElementSibling;if(p&&p.classList.contains("champ-msg"))p.remove();}
  function lienLier(f){return authEndpoint("/auth/"+f+"?mode=lier&retour="+encodeURIComponent(location.pathname+location.search+location.hash));}
  var verifEnvoyee=false,avatarEnCours=false;

  // ── le retour au menu (patch du 4 novembre 2026) : la fleche de Mes favoris et de Mon compte, et le bouton retour du
  //    telephone, ferment le tiroir et rouvrent le menu ; la croix, le fond et Echap ferment tout, comme avant ──
  var TIROIRS={favDrawer:"favOverlay",accountDrawer:"accountOverlay"};
  function estOuvert(id){var d=document.getElementById(id);return !!(d&&d.classList.contains("is-open"));}
  function tiroirOuvert(){for(var k in TIROIRS)if(estOuvert(k))return k;return null;}
  function etatTiroir(){var st=history.state;return st&&typeof st==="object"&&st.gnTiroir?st.gnTiroir:null;}
  function fermerVisuel(id){closeDrawerEl(document.getElementById(id),document.getElementById(TIROIRS[id]));}
  function ouvrirMenu(){if(authDropdown&&authUser&&!authUser.classList.contains("hidden"))authDropdown.classList.add("is-open");}
  // ouvert depuis le menu : une entree d'historique, que le bouton retour du telephone referme
  function marquerTiroir(id){try{if(etatTiroir()!==id)history.pushState({gnTiroir:id},"");}catch(e){}}
  function fermerTout(id){if(!estOuvert(id))return;fermerVisuel(id);if(etatTiroir()===id){try{history.back();}catch(e){}}}
  // la fleche : le tiroir se ferme tout de suite, le menu se rouvre au retour de l'historique (au plus 600 ms) ; un
  // deuxieme appui rapide ne recule donc pas d'une page de plus
  var retourEnCours=0;
  function retourMenu(id){if(!estOuvert(id)||retourEnCours)return;fermerVisuel(id);if(etatTiroir()===id){retourEnCours=setTimeout(function(){retourEnCours=0;ouvrirMenu();},600);try{history.back();return;}catch(e){}clearTimeout(retourEnCours);retourEnCours=0;}ouvrirMenu();}
  window.addEventListener("popstate",function(){if(retourEnCours){clearTimeout(retourEnCours);retourEnCours=0;ouvrirMenu();return;}var k=tiroirOuvert();if(!k||etatTiroir()===k)return;fermerVisuel(k);ouvrirMenu();});
  document.querySelectorAll(".dp-retour").forEach(function(b){b.addEventListener("click",function(e){e.stopPropagation();var d=b.closest(".drawer-panel");if(d)retourMenu(d.id);});});
  // « ← Retour » de Mes preferences : la page d'avant se rouvre, menu ouvert (une demande de moins de 30 s)
  function menuDemande(){try{var t=Number(sessionStorage.getItem("gn-menu")||0);if(!t)return;sessionStorage.removeItem("gn-menu");if(Date.now()-t<30000)ouvrirMenu();}catch(e){}}
  window.addEventListener("pageshow",function(e){if(!e.persisted||!currentUser)return;menuDemande();if(estOuvert("accountDrawer"))renderAccountDrawer();});

  function simplifyPlatform(p){if(!p)return"";return p.replace(/PC \(Microsoft Windows\)/gi,"PC").replace(/PlayStation 5/gi,"PlayStation").replace(/PlayStation 4/gi,"PlayStation").replace(/Xbox Series X\|S/gi,"Xbox").replace(/Xbox One/gi,"Xbox").replace(/Nintendo Switch/gi,"Nintendo");}

  // ── FAVORIS ──────────────────────────────────────
  var favDrawer=document.getElementById("favDrawer"),favOverlay=document.getElementById("favOverlay"),favDrawerClose=document.getElementById("favDrawerClose"),favDrawerContent=document.getElementById("favDrawerContent"),favDrawerCount=document.getElementById("favDrawerCount");
  function closeFavDrawer(){closeDrawerEl(favDrawer,favOverlay);}
  var sousModal=false;   // Mes favoris ferme le temps d'une fiche ouverte depuis lui
  async function openFavDrawerFn(){
    closeDropdown();openDrawer(favDrawer,favOverlay);
    if(sousModal){sousModal=false;marquerTiroir("favDrawer");}
    if(favDrawerContent)favDrawerContent.innerHTML='<div class="drawer-state">Chargement...</div>';
    try{var res=await fetch(authEndpoint("/favorites/"),{credentials:"include",headers:{Accept:"application/json"}});if(!res.ok)throw new Error("HTTP "+res.status);var data=await res.json();var items=data.items||[];
    if(favDrawerCount)favDrawerCount.textContent=items.length+" favori"+(items.length>1?"s":"");
    if(!items.length){if(favDrawerContent)favDrawerContent.innerHTML='<div class="drawer-state">Aucun favori.<br>Ajoute avec le ♡ !</div>';return;}
    // Favoris : titre devant, pastille de type, et surtout la DATE — elle
    // existait dans les donnees mais n'etait jamais affichee. Sur un site de
    // suivi de sorties, c'est l'information centrale.
    var auj = new Date(); auj.setHours(0,0,0,0);
    function favDate(f){
      if(!f.releaseDate) return { j:"\u2014", c:"", etat:"none" };
      if(f.releasePrecision === "year") return { j:"Pr\u00e9vu", c:String(f.releaseDate).slice(0,4), etat:"vague" };
      if(f.releasePrecision === "month"){
        var M=["janv.","f\u00e9vr.","mars","avr.","mai","juin","juil.","ao\u00fbt","sept.","oct.","nov.","d\u00e9c."];
        var pm=String(f.releaseDate).split("-");
        return { j:M[Number(pm[1])-1]||"", c:pm[0], etat:"vague" };
      }
      var d=new Date(f.releaseDate); d.setHours(0,0,0,0);
      var diff=Math.round((d.getTime()-auj.getTime())/86400000);
