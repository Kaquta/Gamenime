---
import NotificationDrawer from "./NotificationDrawer.astro";
const apiBase = import.meta.env.PUBLIC_API_BASE ?? "";
---

<div class="auth-ui" data-api-base={apiBase}>
  <div id="authGuest" class="auth-ui__guest hidden">
    <a href="/signin" class="auth-ui__signin">Sign in</a>
  </div>

  <div id="authUser" class="auth-ui__user hidden">
    <NotificationDrawer />
    <div class="auth-user-menu">
      <button id="authUserButton" class="auth-user-menu__trigger" type="button" aria-label="Menu profil">
        <span class="auth-user-menu__avatar" id="authAvatar"></span>
        <span class="auth-user-menu__name" id="authDisplayName"></span>
      </button>
      <div id="authUserDropdown" class="auth-user-menu__dropdown">
        <button class="auth-user-menu__item mnu" id="openFavDrawer" type="button"><svg class="mnu-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l8.8 8.8 8.8-8.8a5.5 5.5 0 0 0 0-7.8Z"/></svg><span class="mnu-tx">Mes favoris</span></button>
        <!-- Notifications : doublon avec la cloche, qui porte en plus le badge de non-lues.
             Le tiroir reste en place, SectionBlock le rouvre apres fermeture d'un modal. -->
        <a class="auth-user-menu__item mnu" href="/account/preferences"><svg class="mnu-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m13 2-9 12h7l-1 8 9-12h-7l1-8Z"/></svg><span class="mnu-tx">Mes préférences</span></a>
        <button class="auth-user-menu__item mnu" id="openAccountDrawer" type="button"><svg class="mnu-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1A1.7 1.7 0 0 0 4.6 8.6a1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z"/></svg><span class="mnu-tx">Compte</span></button>
        <!-- Premium retire : aucune offre en place -->
        <div class="mnu-sep"></div>
        <button id="authLogoutBtn" class="auth-user-menu__item mnu mnu--dg" type="button"><svg class="mnu-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg><span class="mnu-tx">Déconnexion</span></button>
      </div>
    </div>
  </div>
</div>

<!-- Favoris Drawer -->
<div id="favOverlay" class="drawer-overlay"></div>
<aside id="favDrawer" class="drawer-panel" aria-hidden="true">
  <div class="drawer-panel__header"><h2><svg class="dp-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l8.8 8.8 8.8-8.8a5.5 5.5 0 0 0 0-7.8Z"/></svg>Mes favoris</h2><button id="favDrawerClose" class="drawer-panel__close" type="button">✕</button></div>
  <div id="favDrawerCount" class="drawer-panel__meta"></div>
  <div class="fav-topbar">
    <button type="button" class="fav-lnk" id="favSelMode">Sélectionner</button>
  </div>
  <div id="favDrawerContent" class="drawer-panel__content"></div>
  <div class="fav-bar">
    <span class="fav-bar-n" id="favBarN">Aucun sélectionné<small>Tape une carte pour la choisir</small></span>
    <button type="button" class="fav-bar-b" id="favAll">Tout</button>
    <button type="button" class="fav-bar-b fav-bar-b--del" id="favDel" disabled>Retirer</button>
  </div>
</aside>

<!-- Compte Drawer -->
<div id="accountOverlay" class="drawer-overlay"></div>
<aside id="accountDrawer" class="drawer-panel" aria-hidden="true">
  <div class="drawer-panel__header"><h2><svg class="dp-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1A1.7 1.7 0 0 0 4.6 8.6a1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z"/></svg>Mon compte</h2><button id="accountDrawerClose" class="drawer-panel__close" type="button">✕</button></div>
  <div id="accountDrawerContent" class="drawer-panel__content"></div>
</aside>

<!-- Notifications Drawer -->
<div id="notifPageOverlay" class="drawer-overlay"></div>
<aside id="notifPageDrawer" class="drawer-panel" aria-hidden="true">
  <div class="drawer-panel__header"><h2><svg class="dp-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9M13.7 21a2 2 0 0 1-3.4 0"/></svg>Notifications</h2><button id="notifPageClose" class="drawer-panel__close" type="button">✕</button></div>
  <button id="notifPReadAll" class="drawer-panel__readall" type="button">Tout marquer comme lu</button>
  <div id="notifPMeta" class="drawer-panel__meta"></div>
  <div id="notifPContent" class="drawer-panel__content"></div>
</aside>

<!-- Reset Password Drawer -->
<div id="resetOverlay" class="drawer-overlay"></div>
<aside id="resetDrawer" class="drawer-panel" aria-hidden="true">
  <div class="drawer-panel__header"><h2><svg class="dp-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>Mot de passe oublié</h2><button id="resetDrawerClose" class="drawer-panel__close" type="button">✕</button></div>
  <div id="resetDrawerContent" class="drawer-panel__content">
    <div id="resetError" class="auth-card__error hidden"></div>
    <div id="resetSuccess" class="account-success hidden"></div>
    <div class="account-field"><label>Email</label><input type="email" id="resetEmail" placeholder="ton@email.com" class="account-input" /></div>
    <div class="account-field"><label>Pseudo</label><input type="text" id="resetPseudo" placeholder="Ton pseudo" class="account-input" /></div>
    <div id="resetNewPwBlock" class="hidden"><div class="account-field"><label>Nouveau mot de passe</label><input type="password" id="resetNewPw" placeholder="8 caractères minimum" class="account-input" /></div></div>
    <button id="resetBtn" class="account-btn" type="button">Vérifier</button>
  </div>
</aside>

<script>
  var AVATARS = [
    { id:"avatar_01", name:"Renard", img:"/avatar_01.webp" },
    { id:"avatar_02", name:"Loup", img:"/avatar_02.webp" },
    { id:"avatar_03", name:"Panda", img:"/avatar_03.webp" },
    { id:"avatar_04", name:"Ours", img:"/avatar_04.webp" },
    { id:"avatar_05", name:"Lapin", img:"/avatar_05.webp" },
    { id:"avatar_06", name:"Raton", img:"/avatar_06.webp" },
    { id:"avatar_07", name:"Panda roux", img:"/avatar_07.webp" },
    { id:"avatar_08", name:"Hibou", img:"/avatar_08.webp" },
    { id:"avatar_09", name:"Pingouin", img:"/avatar_09.webp" },
    { id:"avatar_10", name:"Koala", img:"/avatar_10.webp" }
  ];

  var authRoot=document.querySelector(".auth-ui");var authApiBase=authRoot?authRoot.dataset.apiBase||"":"";
  var authGuest=document.getElementById("authGuest"),authUser=document.getElementById("authUser"),authDisplayName=document.getElementById("authDisplayName"),authAvatar=document.getElementById("authAvatar"),authUserButton=document.getElementById("authUserButton"),authDropdown=document.getElementById("authUserDropdown"),authLogoutBtn=document.getElementById("authLogoutBtn");
  var currentUser=null;
  function authEndpoint(p){return authApiBase+p;}
  function getAv(id){for(var i=0;i<AVATARS.length;i++)if(AVATARS[i].id===id)return AVATARS[i];return AVATARS[0];}
  function showGuest(){if(authGuest)authGuest.classList.remove("hidden");if(authUser)authUser.classList.add("hidden");}
  function showUser(name,email,avatar,isPremium){
    if(authGuest)authGuest.classList.add("hidden");if(authUser)authUser.classList.remove("hidden");
    var safeName=name&&String(name).trim()?String(name).trim():email.split("@")[0];
    if(authDisplayName)authDisplayName.textContent=safeName;
    var av=getAv(avatar||"avatar_01");
    if(authAvatar){authAvatar.innerHTML='<img src="'+av.img+'" alt="" class="avatar-img"/>';if(isPremium){authAvatar.classList.add("is-premium");}else{authAvatar.classList.remove("is-premium");}}
    var oldPill=document.getElementById("premiumPill");if(oldPill)oldPill.remove();
    if(isPremium&&authDisplayName){var pill=document.createElement("span");pill.id="premiumPill";pill.className="premium-pill";pill.innerHTML="<svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><polygon points=\"12 2 15 8 22 9 17 14 18 21 12 18 6 21 7 14 2 9 9 8\"/></svg><span class=\"premium-pill__text\">"+escapeHtml(safeName)+"</span>";authDisplayName.after(pill);authDisplayName.style.display="none";}else if(authDisplayName){authDisplayName.style.display="";}
    var premBtn=null; /* Premium desactive (session 33) : pas d'offre en place */
    if(premBtn){premBtn.style.display="none";}
  }
  async function fetchMe(){
    try{var res=await fetch(authEndpoint("/auth/me"),{method:"GET",credentials:"include",headers:{Accept:"application/json"}});
    if(res.status===401){showGuest();return;}if(!res.ok)throw new Error("HTTP "+res.status);
    var data=await res.json();if(!data.user){showGuest();return;}
    currentUser=data.user;showUser(data.user.displayName,data.user.email,data.user.avatar,data.user.isPremium);
    }catch(e){showGuest();}
  }
  function toggleDropdown(){if(authDropdown)authDropdown.classList.toggle("is-open");}
  function closeDropdown(){if(authDropdown)authDropdown.classList.remove("is-open");}
  async function authLogout(){try{await fetch(authEndpoint("/auth/logout"),{method:"POST",credentials:"include"});closeDropdown();showGuest();window.location.reload();}catch(e){}}
  if(authUserButton)authUserButton.addEventListener("click",function(e){e.stopPropagation();toggleDropdown();});
  if(authLogoutBtn)authLogoutBtn.addEventListener("click",function(){authLogout();});
  document.addEventListener("click",function(e){if(!e.target.closest(".auth-user-menu"))closeDropdown();});
  document.addEventListener("keydown",function(e){if(e.key==="Escape"){closeDropdown();closeFavDrawer();closeAccountDrawer();closeNotifPageDrawer();closeResetDrawer();}});

  function openDrawer(d,o){if(!d||!o)return;d.classList.add("is-open");o.classList.add("is-open");d.setAttribute("aria-hidden","false");document.body.style.overflow="hidden";}
  function closeDrawerEl(d,o){if(!d||!o)return;d.classList.remove("is-open");o.classList.remove("is-open");d.setAttribute("aria-hidden","true");document.body.style.overflow="";}
  function escapeHtml(v){return String(v).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");}
  function timeAgo(s){if(!s)return"";var d=Math.floor((Date.now()-new Date(s).getTime())/1000);if(d<60)return"À l'instant";if(d<3600)return Math.floor(d/60)+" min";if(d<86400)return Math.floor(d/3600)+"h";if(d<604800)return Math.floor(d/86400)+"j";return new Intl.DateTimeFormat("fr-FR",{day:"2-digit",month:"short"}).format(new Date(s));}
  function simplifyPlatform(p){if(!p)return"";return p.replace(/PC \(Microsoft Windows\)/gi,"PC").replace(/PlayStation 5/gi,"PlayStation").replace(/PlayStation 4/gi,"PlayStation").replace(/Xbox Series X\|S/gi,"Xbox").replace(/Xbox One/gi,"Xbox").replace(/Nintendo Switch/gi,"Nintendo");}

  // ── FAVORIS ──────────────────────────────────────
  var favDrawer=document.getElementById("favDrawer"),favOverlay=document.getElementById("favOverlay"),favDrawerClose=document.getElementById("favDrawerClose"),favDrawerContent=document.getElementById("favDrawerContent"),favDrawerCount=document.getElementById("favDrawerCount");
  function closeFavDrawer(){closeDrawerEl(favDrawer,favOverlay);}
  async function openFavDrawerFn(){
    closeDropdown();openDrawer(favDrawer,favOverlay);
    if(favDrawerContent)favDrawerContent.innerHTML='<div class="drawer-state">Chargement...</div>';
    try{var res=await fetch(authEndpoint("/favorites/"),{credentials:"include",headers:{Accept:"application/json"}});if(!res.ok)throw new Error("HTTP "+res.status);var data=await res.json();var items=data.items||[];
    if(favDrawerCount)favDrawerCount.textContent=items.length+" favori"+(items.length>1?"s":"");
    if(!items.length){if(favDrawerContent)favDrawerContent.innerHTML='<div class="drawer-state">Aucun favori.<br>Ajoute avec le ♡ !</div>';return;}
    // Favoris : titre devant, pastille de type, et surtout la DATE — elle
    // existait dans les donnees mais n'etait jamais affichee. Sur un site de
    // suivi de sorties, c'est l'information centrale.
    var auj = new Date(); auj.setHours(0,0,0,0);
    function favDate(f){
      if(!f.releaseDate) return { j:"\u2014", c:"", etat:"none" };
      if(f.releasePrecision === "year") return { j:"Pr\u00e9vu", c:String(f.releaseDate).slice(0,4), etat:"vague" };
      if(f.releasePrecision === "month"){
        var M=["janv.","f\u00e9vr.","mars","avr.","mai","juin","juil.","ao\u00fbt","sept.","oct.","nov.","d\u00e9c."];
        var pm=String(f.releaseDate).split("-");
        return { j:M[Number(pm[1])-1]||"", c:pm[0], etat:"vague" };
      }
      var d=new Date(f.releaseDate); d.setHours(0,0,0,0);
      var diff=Math.round((d.getTime()-auj.getTime())/86400000);
      var M2=["janv.","f\u00e9vr.","mars","avr.","mai","juin","juil.","ao\u00fbt","sept.","oct.","nov.","d\u00e9c."];
      var lib=d.getDate()+" "+M2[d.getMonth()];
      if(diff<0) return { j:lib, c:"sorti", etat:"out" };
      if(diff===0) return { j:lib, c:"aujourd\u0027hui", etat:"soon" };
      if(diff<=60) return { j:lib, c:"dans "+diff+" j", etat:"soon" };
      return { j:lib, c:String(d.getFullYear()), etat:"" };
    }
    function favCard(f){
      var info=simplifyPlatform(f.platform)||f.genre||"";
      var est=f.itemType==="anime";
      var dt=favDate(f);
      var cls = dt.etat==="out" ? " out" : (dt.etat==="soon" ? " soon" : "");
      return '<div class="f-c drawer-card'+cls+'" data-type="'+f.itemType+'" data-id="'+f.itemId+'" data-release-date="'+(f.releaseDate||"")+'">'
        +'<span class="fav-ck"><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg></span>'
        +'<span class="f-th"><span class="cov">'+(f.cover?'<img src="'+f.cover+'" alt="" loading="lazy" />':'\u65b0')+'</span></span>'
        +'<span class="f-b"><span class="f-t">'+escapeHtml(f.title)+'</span>'
        +'<span class="f-m"><span class="f-tag '+(est?"t-anime":"t-game")+'">'+(est?"Anime":"Jeu")+'</span>'
        +(info?'<span class="f-sub">'+escapeHtml(info)+'</span>':'')+'</span></span>'
        +'<span class="f-d"><span class="f-day">'+dt.j+'</span>'+(dt.c?'<span class="f-cd">'+dt.c+'</span>':'')+'</span>'
        +'<button class="f-x drawer-card__remove" data-type="'+f.itemType+'" data-id="'+f.itemId+'" title="Retirer" type="button">\u2715</button>'
        +'</div>';
    }
    var aVenir=items.filter(function(f){ return favDate(f).etat!=="out"; });
    var sortis=items.filter(function(f){ return favDate(f).etat==="out"; });
    var html="";
    if(aVenir.length) html+='<div class="f-sec">\u00c0 venir</div>'+aVenir.map(favCard).join("");
    if(sortis.length) html+='<div class="f-sec">D\u00e9j\u00e0 sortis</div>'+sortis.map(favCard).join("");
    if(favDrawerContent)favDrawerContent.innerHTML=html;
    majFavBar();
    }catch(e){if(favDrawerContent)favDrawerContent.innerHTML='<div class="drawer-state">Erreur.</div>';}
  }
  (window).__openFavDrawer=function(){openFavDrawerFn();};
  if(favDrawerClose)favDrawerClose.addEventListener("click",closeFavDrawer);
  if(favOverlay)favOverlay.addEventListener("click",closeFavDrawer);
  document.getElementById("openFavDrawer")?.addEventListener("click",function(){openFavDrawerFn();});
  if(favDrawerContent)favDrawerContent.addEventListener("click",async function(e){
    // Mode selection : le clic choisit la carte au lieu d'ouvrir le modal.
    if(favSel){
      var pc=e.target.closest(".f-c");
      if(pc){
        e.preventDefault(); e.stopPropagation();
        var cle=pc.dataset.type+":"+pc.dataset.id;
        favPicked[cle]=!favPicked[cle];
        pc.classList.toggle("picked", !!favPicked[cle]);
        majFavBar();
      }
      return;
    }
    // Cas 1: click sur bouton "✕" remove
    var btn=e.target.closest(".drawer-card__remove");
    if(btn){
      e.stopPropagation();
      try{var res=await fetch(authEndpoint("/favorites/"+btn.dataset.type+"/"+btn.dataset.id),{method:"DELETE",credentials:"include",headers:{Accept:"application/json"}});if(res.ok){var card=btn.closest(".drawer-card");if(card)card.remove();document.dispatchEvent(new CustomEvent("favChanged",{detail:{type:btn.dataset.type,id:btn.dataset.id,action:"remove"}}));var rem=favDrawerContent.querySelectorAll(".drawer-card").length;if(favDrawerCount)favDrawerCount.textContent=rem+" favori"+(rem>1?"s":"");if(!rem)favDrawerContent.innerHTML='<div class="drawer-state">Aucun favori.</div>';}}catch(err){}
      return;
    }
    // Cas 2: click sur la card -> fermer drawer + ouvrir modal INSTANTANEMENT
    var card=e.target.closest(".drawer-card");
    if(!card||!card.dataset.id)return;
    var itemType=card.dataset.type;
    var itemId=card.dataset.id;
    var domain=itemType==="game"?"games":"anime";
    (window).__reopenFavDrawer=true;
    closeFavDrawer();
    if(typeof window.__openItemModal==="function"){
      window.__openItemModal(domain,itemId);
    }else{
      // Fallback si SectionBlock pas charge sur la page actuelle
      var targetPage=itemType==="anime"?"/anime":"/games";
      window.location.href=targetPage+"#item-"+itemId;
    }
  });

  // ── Selection multiple des favoris ────────────────────────────────
  // Deux temps volontaires : entrer dans le mode, puis choisir. La croix
  // individuelle disparait pendant — deux façons de supprimer en meme
  // temps preteraient a confusion.
  var favSel = false;
  var favPicked = {};
  var favModeBtn = document.getElementById("favSelMode");
  var favBarN = document.getElementById("favBarN");
  var favAllBtn = document.getElementById("favAll");
  var favDelBtn = document.getElementById("favDel");

  function majFavBar(){
    var n = Object.keys(favPicked).filter(function(k){ return favPicked[k]; }).length;
    var tot = favDrawerContent ? favDrawerContent.querySelectorAll(".f-c").length : 0;
    if(favBarN) favBarN.innerHTML = (n ? n + " s\u00e9lectionn\u00e9" + (n>1?"s":"") : "Aucun s\u00e9lectionn\u00e9")
      + "<small>" + (n ? "Retirer les enl\u00e8ve de tes favoris" : "Tape une carte pour la choisir") + "</small>";
    if(favDelBtn){ favDelBtn.disabled = n===0; favDelBtn.textContent = n ? "Retirer (" + n + ")" : "Retirer"; }
    if(favAllBtn) favAllBtn.textContent = (n>0 && n===tot) ? "Aucun" : "Tout";
  }

  if(favModeBtn) favModeBtn.addEventListener("click", function(){
    favSel = !favSel;
    favPicked = {};
    if(favDrawer) favDrawer.classList.toggle("fav-selecting", favSel);
    favModeBtn.textContent = favSel ? "Annuler" : "S\u00e9lectionner";
    favModeBtn.classList.toggle("on", favSel);
    if(favDrawerContent) favDrawerContent.querySelectorAll(".f-c").forEach(function(c){ c.classList.remove("picked"); });
    majFavBar();
  });

  if(favAllBtn) favAllBtn.addEventListener("click", function(){
    if(!favDrawerContent) return;
    var cards = favDrawerContent.querySelectorAll(".f-c");
    var n = Object.keys(favPicked).filter(function(k){ return favPicked[k]; }).length;
    favPicked = {};
    if(n !== cards.length){
      cards.forEach(function(c){
        favPicked[c.dataset.type + ":" + c.dataset.id] = true;
        c.classList.add("picked");
      });
    } else {
      cards.forEach(function(c){ c.classList.remove("picked"); });
    }
    majFavBar();
  });

  if(favDelBtn) favDelBtn.addEventListener("click", async function(){
    var cles = Object.keys(favPicked).filter(function(k){ return favPicked[k]; });
    if(!cles.length) return;
    favDelBtn.disabled = true;
    favDelBtn.textContent = "Suppression\u2026";
    for(var i=0;i<cles.length;i++){
      var parts = cles[i].split(":");
      try{
        await fetch(authEndpoint("/favorites/" + parts[0] + "/" + parts[1]), { method:"DELETE", credentials:"include", headers:{ Accept:"application/json" } });
        document.dispatchEvent(new CustomEvent("favChanged",{ detail:{ type:parts[0], id:parts[1], action:"remove" } }));
      }catch(e){}
    }
    favPicked = {};
    favSel = false;
    if(favDrawer) favDrawer.classList.remove("fav-selecting");
    if(favModeBtn){ favModeBtn.textContent = "S\u00e9lectionner"; favModeBtn.classList.remove("on"); }
    openFavDrawer();
  });

  // ── COMPTE ───────────────────────────────────────
  var accountDrawer=document.getElementById("accountDrawer"),accountOverlay=document.getElementById("accountOverlay"),accountDrawerClose=document.getElementById("accountDrawerClose"),accountDrawerContent=document.getElementById("accountDrawerContent");
  function closeAccountDrawer(){closeDrawerEl(accountDrawer,accountOverlay);}

  function renderAccountDrawer(){
    if(!currentUser||!accountDrawerContent)return;
    var u=currentUser;var av=getAv(u.avatar||"avatar_01");

    accountDrawerContent.innerHTML=
      // En-tete : avatar cliquable (crayon en pastille), pseudo, email + etat
      '<div class="acc-head"><button type="button" class="acc-av" id="accAvDisp" title="Changer d\'avatar"><img src="'+av.img+'" alt="" class="avatar-img"/></button>'+
      '<div class="acc-hb"><div class="acc-name" id="accNameDisp">'+escapeHtml(u.displayName||u.email.split("@")[0])+(u.isPremium?' <span class="premium-text-badge">PREMIUM</span>':'')+'</div>'+
      '<div class="acc-mailrow"><span class="acc-mail">'+escapeHtml(u.email)+'</span>'+
      (u.emailVerified===false
        ? '<button type="button" id="emailUnverifiedBtn" class="acc-chip acc-chip--ko"><i></i>À confirmer</button>'
        : '<span class="acc-chip acc-chip--ok"><i></i>Vérifié</span>')+
      '</div>'+
      // Bouton libelle plutot qu'un badge colle sur le cercle : la vignette
      // reste propre et l'action est explicite, au clic comme au doigt.
      '<button type="button" class="acc-pen" data-toggle="avatarForm"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>Changer d\'avatar</button>'+
      '</div></div>'+

      '<div id="avatarForm" class="account-subform hidden"><div class="avatar-grid">'+AVATARS.map(function(a){var sel=(u.avatar||"avatar_01")===a.id?" avatar-pick--selected":"";return'<button class="avatar-pick'+sel+'" data-avatar="'+a.id+'" type="button" title="'+a.name+'"><img src="'+a.img+'" alt="" class="avatar-img"/></button>';}).join("")+'</div></div>'+

      '<div class="acc-sec">Profil</div>'+
      '<button class="acc-row" data-toggle="pseudoForm" type="button"><svg class="acc-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg><span class="acc-rb"><span class="acc-rt">Pseudo</span><span class="acc-rs">'+escapeHtml(u.displayName||"Non défini")+'</span></span><span class="acc-chev">\u203a</span></button>'+
      '<div id="pseudoForm" class="account-subform hidden"><div class="account-field-row"><input type="text" id="accountPseudo" value="'+escapeHtml(u.displayName||"")+'" placeholder="Ton pseudo" class="account-input" /><button id="savePseudo" class="account-btn-sm" type="button">Sauver</button></div><div id="pseudoMsg" class="account-msg hidden"></div></div>'+

      '<div class="acc-sec">Sécurité</div>'+
      '<button class="acc-row" data-toggle="pwForm" type="button"><svg class="acc-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg><span class="acc-rb"><span class="acc-rt">Mot de passe</span><span class="acc-rs">Modifier ou réinitialiser</span></span><span class="acc-chev">\u203a</span></button>'+
      '<div id="pwForm" class="account-subform hidden"><div class="account-field"><input type="password" id="currentPw" placeholder="Mot de passe actuel" class="account-input" /></div><div class="account-field"><input type="password" id="newPw" placeholder="Nouveau (8 car. min)" class="account-input" /></div><button id="savePw" class="account-btn-sm" type="button">Changer</button><div id="pwMsg" class="account-msg hidden"></div>'+
      // Sortie de secours : sans l\'ancien mot de passe, le formulaire ci-dessus
      // est inutilisable. Le lien reste donc a portee, mais dans son contexte.
      '<button type="button" id="openResetFromAccount" class="acc-forgot">Mot de passe oublié ?</button></div>'+

      '<div class="acc-sec">Notifications</div>'+
      '<label class="acc-tog"><span class="acc-tb">Sur le site<small>Cloche et badges</small></span><input type="checkbox" id="toggleNotif" '+(u.notificationsEnabled?'checked':'')+' /><span class="acc-sw"></span></label>'+
      '<label class="acc-tog"><span class="acc-tb">Par email<small>Rappels de sortie</small></span><input type="checkbox" id="toggleEmail" '+(u.emailNotificationsEnabled?'checked':'')+' /><span class="acc-sw"></span></label>'+

      (u.isPremium?'<div class="acc-sec">Abonnement</div><a href="/account" class="acc-row acc-row--prem"><svg class="acc-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 2 3 6.5 7 1-5 5 1.2 7L12 18l-6.2 3.5L7 14.5l-5-5 7-1Z"/></svg><span class="acc-rb"><span class="acc-rt">Gérer mon abonnement</span><span class="acc-rs">Premium actif</span></span><span class="acc-chev">\u203a</span></a>':'')+

      '<button class="acc-out" id="accountLogout" type="button"><svg class="acc-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>Se déconnecter</button>';
    // Toggle sections
    accountDrawerContent.querySelectorAll("[data-toggle]").forEach(function(btn){
      btn.addEventListener("click",function(){var target=document.getElementById(btn.dataset.toggle);if(target)target.classList.toggle("hidden");});
    });
    // Email verification - resend link on click
    var unverifiedBtn=document.getElementById("emailUnverifiedBtn");
    if(unverifiedBtn){
      unverifiedBtn.addEventListener("click",async function(){
        if(unverifiedBtn.classList.contains("account-email-unverified--sent"))return;
        var originalText=unverifiedBtn.textContent;
        unverifiedBtn.textContent="Envoi…";
        unverifiedBtn.disabled=true;
        try{
          var res=await fetch(authEndpoint("/auth/resend-verification"),{method:"POST",headers:{"Content-Type":"application/json",Accept:"application/json"},body:JSON.stringify({email:currentUser.email})});
          var data=await res.json();
          if(res.ok&&data.ok){
            unverifiedBtn.textContent="✅ Email envoyé, vérifie ta boîte";
            unverifiedBtn.classList.add("account-email-unverified--sent");
          }else if(res.status===429){
            unverifiedBtn.textContent="Trop de tentatives, réessaie plus tard";
            setTimeout(function(){unverifiedBtn.textContent=originalText;unverifiedBtn.disabled=false;},5000);
          }else{
            unverifiedBtn.textContent="Erreur, réessaie";
            setTimeout(function(){unverifiedBtn.textContent=originalText;unverifiedBtn.disabled=false;},3000);
          }
        }catch(e){
          unverifiedBtn.textContent="Erreur réseau";
          setTimeout(function(){unverifiedBtn.textContent=originalText;unverifiedBtn.disabled=false;},3000);
        }
      });
    }

    // Avatar picker
    accountDrawerContent.querySelectorAll(".avatar-pick").forEach(function(btn){
      btn.addEventListener("click",async function(){
        var avId=btn.dataset.avatar;
        try{var res=await fetch(authEndpoint("/auth/profile"),{method:"PATCH",credentials:"include",headers:{"Content-Type":"application/json",Accept:"application/json"},body:JSON.stringify({avatar:avId})});
        if(res.ok){var data=await res.json();currentUser=data.user;showUser(currentUser.displayName,currentUser.email,currentUser.avatar,currentUser.isPremium);
        accountDrawerContent.querySelectorAll(".avatar-pick").forEach(function(b){b.classList.remove("avatar-pick--selected");});btn.classList.add("avatar-pick--selected");
        var disp=document.getElementById("accAvDisp");if(disp)var _gv=getAv(avId);disp.innerHTML='<img src="'+_gv.img+'" alt="" class="avatar-img"/>';}}catch(e){}
      });
    });

    // Save pseudo
    document.getElementById("savePseudo")?.addEventListener("click",async function(){
      var input=document.getElementById("accountPseudo"),msg=document.getElementById("pseudoMsg"),name=input?input.value.trim():"";if(!name)return;
      try{var res=await fetch(authEndpoint("/auth/profile"),{method:"PATCH",credentials:"include",headers:{"Content-Type":"application/json",Accept:"application/json"},body:JSON.stringify({displayName:name})});var data=await res.json();
      if(res.ok){currentUser=data.user;showUser(currentUser.displayName,currentUser.email,currentUser.avatar,currentUser.isPremium);var nd=document.getElementById("accNameDisp");if(nd)nd.textContent=name;if(msg){msg.textContent="✅ Pseudo mis à jour";msg.classList.remove("hidden","account-msg--error");}}
      else{if(msg){msg.textContent="❌ "+(data.error||"Erreur");msg.classList.remove("hidden");msg.classList.add("account-msg--error");}}}catch(e){if(msg){msg.textContent="❌ Erreur";msg.classList.remove("hidden");msg.classList.add("account-msg--error");}}
    });

    // Change password
    document.getElementById("savePw")?.addEventListener("click",async function(){
      var cur=document.getElementById("currentPw"),nw=document.getElementById("newPw"),msg=document.getElementById("pwMsg");
      if(!cur||!nw||!cur.value||!nw.value)return;if(nw.value.length<8){if(msg){msg.textContent="❌ 8 caractères minimum";msg.classList.remove("hidden");msg.classList.add("account-msg--error");}return;}
      try{var res=await fetch(authEndpoint("/auth/password"),{method:"PATCH",credentials:"include",headers:{"Content-Type":"application/json",Accept:"application/json"},body:JSON.stringify({currentPassword:cur.value,newPassword:nw.value})});var data=await res.json();
      if(res.ok){cur.value="";nw.value="";if(msg){msg.textContent="✅ Mot de passe changé";msg.classList.remove("hidden","account-msg--error");}}
      else{if(msg){msg.textContent="❌ "+(data.error||"Erreur");msg.classList.remove("hidden");msg.classList.add("account-msg--error");}}}catch(e){if(msg){msg.textContent="❌ Erreur";msg.classList.remove("hidden");msg.classList.add("account-msg--error");}}
    });
    // SESSION 13: brancher les 2 toggles in-app/email du drawer Compte sur l'API
    // Source de vérité = /me/notification-channels (même que page /account/preferences)
    document.getElementById("toggleNotif")?.addEventListener("change", async function(){
      var t = this;
      try {
        var res = await fetch(authEndpoint("/me/notification-channels"), {
          method: "PATCH", credentials: "include",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify({ notificationsEnabled: t.checked })
        });
        if (res.ok) {
          var d = await res.json();
          if (currentUser) { currentUser.notificationsEnabled = d.notificationsEnabled; }
          t.checked = d.notificationsEnabled;
        } else {
          t.checked = !t.checked; // rollback visuel si erreur
        }
      } catch(e) { t.checked = !t.checked; }
    });
    document.getElementById("toggleEmail")?.addEventListener("change", async function(){
      var t = this;
      try {
        var res = await fetch(authEndpoint("/me/notification-channels"), {
          method: "PATCH", credentials: "include",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify({ emailNotificationsEnabled: t.checked })
        });
        if (res.ok) {
          var d = await res.json();
          if (currentUser) { currentUser.emailNotificationsEnabled = d.emailNotificationsEnabled; }
          // Backend peut forcer à false si user pas Premium — refléter dans l'UI
          t.checked = d.emailNotificationsEnabled;
        } else {
          t.checked = !t.checked;
        }
      } catch(e) { t.checked = !t.checked; }
    });

    document.getElementById("accountLogout")?.addEventListener("click",function(){closeAccountDrawer();authLogout();});
    document.getElementById("openResetFromAccount")?.addEventListener("click",function(){closeAccountDrawer();openResetDrawerFn();});
  }

  function openAccountDrawerFn(){closeDropdown();openDrawer(accountDrawer,accountOverlay);renderAccountDrawer();}
  if(accountDrawerClose)accountDrawerClose.addEventListener("click",closeAccountDrawer);
  if(accountOverlay)accountOverlay.addEventListener("click",closeAccountDrawer);
  document.getElementById("openAccountDrawer")?.addEventListener("click",function(){openAccountDrawerFn();});

  // ── RESET PASSWORD ───────────────────────────────
  var resetDrawer=document.getElementById("resetDrawer"),resetOverlay=document.getElementById("resetOverlay"),resetDrawerClose=document.getElementById("resetDrawerClose");
  function closeResetDrawer(){closeDrawerEl(resetDrawer,resetOverlay);}
  function openResetDrawerFn(){openDrawer(resetDrawer,resetOverlay);}
  if(resetDrawerClose)resetDrawerClose.addEventListener("click",closeResetDrawer);
  if(resetOverlay)resetOverlay.addEventListener("click",closeResetDrawer);
  document.getElementById("resetBtn")?.addEventListener("click",async function(){
    var email=document.getElementById("resetEmail"),pseudo=document.getElementById("resetPseudo"),newPwBlock=document.getElementById("resetNewPwBlock"),newPw=document.getElementById("resetNewPw"),errDiv=document.getElementById("resetError"),successDiv=document.getElementById("resetSuccess"),btn=document.getElementById("resetBtn");
    if(!email||!pseudo)return;
    if(newPwBlock&&!newPwBlock.classList.contains("hidden")){
      if(!newPw||newPw.value.length<8){if(errDiv){errDiv.textContent="8 caractères minimum";errDiv.classList.remove("hidden");}return;}
      try{var res=await fetch(authEndpoint("/auth/reset-password"),{method:"POST",credentials:"include",headers:{"Content-Type":"application/json",Accept:"application/json"},body:JSON.stringify({email:email.value.trim(),displayName:pseudo.value.trim(),newPassword:newPw.value})});var data=await res.json();
      if(res.ok){if(errDiv)errDiv.classList.add("hidden");if(successDiv){successDiv.textContent="✅ Mot de passe réinitialisé !";successDiv.classList.remove("hidden");}if(btn)btn.classList.add("hidden");}
      else{if(errDiv){errDiv.textContent=data.error||"Erreur";errDiv.classList.remove("hidden");}}}catch(e){if(errDiv){errDiv.textContent="Erreur serveur";errDiv.classList.remove("hidden");}}
      return;
    }
    if(!email.value.trim()||!pseudo.value.trim()){if(errDiv){errDiv.textContent="Remplis email et pseudo";errDiv.classList.remove("hidden");}return;}
    if(errDiv)errDiv.classList.add("hidden");if(newPwBlock)newPwBlock.classList.remove("hidden");if(btn)btn.textContent="Réinitialiser";
  });

  // ── NOTIFICATIONS ────────────────────────────────
  var notifPDrawer=document.getElementById("notifPageDrawer"),notifPOverlay=document.getElementById("notifPageOverlay"),notifPClose=document.getElementById("notifPageClose"),notifPContent=document.getElementById("notifPContent"),notifPMeta=document.getElementById("notifPMeta"),notifPReadAll=document.getElementById("notifPReadAll");
  function closeNotifPageDrawer(){closeDrawerEl(notifPDrawer,notifPOverlay);}
  function evIcon(t){
    // Pastille typee : chaque evenement a sa couleur, on identifie sa nature
    // avant de lire. Rendu identique sur tous les appareils, contrairement
    // aux emojis qui changent de dessin selon le systeme.
    var s=String(t||"");
    var d,c;
    if(s.indexOf("platform")!==-1){c="plat";d='<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>';}
    else if(s.indexOf("trailer")!==-1){c="trail";d='<circle cx="12" cy="12" r="9"/><path d="m10 8 6 4-6 4Z"/>';}
    else if(s.indexOf("release_date")!==-1){c="date";d='<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18"/>';}
    else{c="def";d='<path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9M13.7 21a2 2 0 0 1-3.4 0"/>';}
    return '<span class="ev-badge ev-'+c+'"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">'+d+'</svg></span>';
  }
  async function openNotifPageDrawer(){
    closeDropdown();openDrawer(notifPDrawer,notifPOverlay);
    if(notifPContent)notifPContent.innerHTML='<div class="drawer-state">Chargement...</div>';
    try{var res=await fetch(authEndpoint("/notifications/"),{credentials:"include",headers:{Accept:"application/json"}});if(!res.ok)throw new Error("HTTP "+res.status);var data=await res.json();var items=data.items||[];var unread=Number(data.unreadCount||0);
    if(notifPMeta)notifPMeta.textContent=unread>0?unread+" non lue"+(unread>1?"s":""):"Tout est lu";
    if(!items.length){if(notifPContent)notifPContent.innerHTML='<div class="drawer-state">Aucune notification.</div>';return;}
if(notifPContent)notifPContent.innerHTML=items.map(function(item){var p=item.payload||{};var title=p.title||"Mise à jour";var label=p.label||item.eventType;var detail=p.newValue||"";var icon=evIcon(item.eventType);var uc=item.isRead?"":" notif-card--unread";var thumb=p.cover?'<img src="'+p.cover+'" alt="" />':'<span style="font-size:1.3rem;display:flex;align-items:center;justify-content:center;height:100%">'+icon+'</span>';return'<div class="notif-card'+uc+'" data-id="'+item.id+'" data-item-type="'+(item.itemType||"")+'" data-item-id="'+(item.itemId||"")+'" style="cursor:pointer;position:relative"><div class="notif-card__thumb">'+thumb+'</div><div class="notif-card__content"><div class="notif-card__title">'+escapeHtml(label)+' — '+escapeHtml(title)+'</div>'+(detail?'<div class="notif-card__text">'+escapeHtml(detail)+'</div>':'')+'<div class="notif-card__time">'+timeAgo(item.eventAt||item.createdAt)+'</div></div><button class="notif-card__remove" data-notif-id="'+item.id+'" title="Supprimer" type="button">✕</button></div>';}).join("");
    }catch(e){if(notifPContent)notifPContent.innerHTML='<div class="drawer-state">Erreur.</div>';}
  }
  (window).__openNotifPageDrawer=function(){openNotifPageDrawer();};
  if(notifPClose)notifPClose.addEventListener("click",closeNotifPageDrawer);
  if(notifPOverlay)notifPOverlay.addEventListener("click",closeNotifPageDrawer);
  document.getElementById("openNotifPage")?.addEventListener("click",function(){openNotifPageDrawer();});
  if(notifPReadAll)notifPReadAll.addEventListener("click",async function(){try{var res=await fetch(authEndpoint("/notifications/read-all"),{method:"POST",credentials:"include",headers:{"Content-Type":"application/json",Accept:"application/json"},body:JSON.stringify({})});if(res.ok)openNotifPageDrawer();}catch(e){}});
  if(notifPContent)notifPContent.addEventListener("click",async function(e){
    // Cas 1: bouton supprimer
    var rmBtn=e.target.closest(".notif-card__remove");
    if(rmBtn){
      e.stopPropagation();
      var nid=Number(rmBtn.dataset.notifId||0);
      if(nid>0){try{var dr=await fetch(authEndpoint("/notifications/"+nid),{method:"DELETE",credentials:"include"});if(dr.ok){var rc=rmBtn.closest(".notif-card");if(rc)rc.remove();}}catch(x){}}
      return;
    }
    // Cas 2: click sur la card -> marquer lue + ouvrir modal de l'item
    var card=e.target.closest(".notif-card");
    if(!card)return;
    var id=Number(card.dataset.id||0);
    if(id<=0)return;
    var itemType=card.dataset.itemType;
    var itemId=card.dataset.itemId;
    // Marquer comme lue (fire-and-forget)
    try{var res=await fetch(authEndpoint("/notifications/"+id+"/read"),{method:"POST",credentials:"include"});if(res.ok)card.classList.remove("notif-card--unread");}catch(e){}
    // Ouvrir modal de l'item si on a les infos
    if(itemType&&itemId){
      var domain=itemType==="game"?"games":"anime";
      (window).__reopenNotifPageDrawer=true;
      closeNotifPageDrawer();
      if(typeof window.__openItemModal==="function"){
        window.__openItemModal(domain,itemId);
      }else{
        var targetPage=itemType==="anime"?"/anime":"/games";
        window.location.href=targetPage+"#item-"+itemId;
      }
    }
  });

  fetchMe();
</script>

<style>
.avatar-img{width:100%;height:100%;object-fit:cover;border-radius:50%;display:block;}
.avatar-pick .avatar-img{width:100%;height:100%;}
.drawer-panel__header h2{display:flex;align-items:center;gap:10px}
.dp-ic{flex:none;width:19px;height:19px;color:#ffb066;opacity:.9}
.mnu{display:flex!important;align-items:center;gap:12px;text-align:left}
.mnu-ic{flex:none;width:17px;height:17px;color:#ffb066;opacity:.82;transition:opacity 150ms ease}
.mnu:hover .mnu-ic{opacity:1}
.mnu-tx{flex:1;min-width:0}
.mnu-sep{height:1px;margin:7px 10px;background:rgba(255,171,93,.22)}
.mnu-prem{display:flex!important;align-items:center;gap:12px;text-align:left;background:linear-gradient(90deg,rgba(255,217,138,.15),rgba(255,255,255,.02))!important;border:1px solid rgba(255,217,138,.3)!important;color:#ffd98a!important;font-weight:700}
.mnu-prem:hover{background:linear-gradient(90deg,rgba(255,217,138,.24),rgba(255,255,255,.03))!important}
.mnu-prem .mnu-ic{color:#ffd98a;opacity:1}
.mnu-prem small{display:block;font-size:.7rem;font-weight:500;color:rgba(255,217,138,.62);margin-top:1px}
.mnu--dg .mnu-ic{color:#f08b7f;opacity:.8}
</style>
