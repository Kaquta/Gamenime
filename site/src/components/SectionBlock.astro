---
interface Props {
  title: string;
  source: "anime" | "games" | "upcoming" | "anime-upcoming" | "games-upcoming" | "top-anime" | "top-games";
  limit?: number;
  href?: string;
  /* Onglets Anime / Film — decoupage EXCLUSIF par le format : un film va
     dans "Film", tout le reste dans "Anime" ("Serie" sur A venir).
     "anime"    : Anime / Film
     "upcoming" : Serie / Film
     Plus d'onglet "Sorti JP" (10 octobre 2026) : un anime sorti sans
     plateforme EU reste dans son onglet, sa carte le dit
     (« Sortie Japon · EU a confirmer »). */
  kinds?: boolean | "anime" | "upcoming";
  /* Mise en page de l'accueil (session 34). Les cartes ne changent pas :
     "slider" = fenetre glissante, une carte a la fois, la suivante qui depasse
     "rang"   = liste de classement compacte, les 25 visibles
     Sans variant, le bloc garde la grille de cartes d'origine. */
  variant?: "slider" | "rang";
  taille?: "haute" | "basse";
  duree?: number;
  /* retard au demarrage du defilement : deux fenetres cote a cote qui
     tournent en meme temps donnent le tournis. */
  decal?: number;
}
import { renderCard, renderCardDerniers, renderRangTop } from "../lib/fiche";

const { title, source, limit, href, kinds, variant, taille, duree, decal } = Astro.props;

// Les cartes sont rendues ICI, au build, et plus seulement en JavaScript.
// Sans ca le HTML livre ne contient aucun lien vers les fiches : c'est la
// cause pour laquelle 935 pages restaient en « detectee, non indexee ».
// Le script plus bas recharge ensuite les memes zones, donc le catalogue
// reste vivant.
const API = "https://gamenime.fr/api";

async function feed(dom: "anime" | "games", params: Record<string, string>) {
  const r = await fetch(`${API}/feed/${dom}?${new URLSearchParams(params)}`);
  if (!r.ok) throw new Error(`/feed/${dom} a repondu ${r.status}`);
  const d = await r.json();
  return Array.isArray(d.items) ? d.items : [];
}

// Les pages de fiches ne sont generees que pour les items dont le synopsis
// atteint 150 caracteres (filtre de /feed/slugs). Un item sans page ne doit
// donc PAS recevoir de lien : l'URL n'existerait pas, et nginx y repond par
// la page d'accueil en 200 — Google indexerait un doublon de l'accueil.
const rSlugs = await fetch(`${API}/feed/slugs?type=all`);
if (!rSlugs.ok) throw new Error(`/feed/slugs a repondu ${rSlugs.status}`);
const avecPage = new Set<string>(
  ((await rSlugs.json()).items || []).map((i: any) => i.slug).filter(Boolean)
);
// renderCard ne pose un lien que si item.slug existe : on le neutralise pour
// les items sans page, et la carte redevient du texte simple.
const lisible = (i: any) => (i.slug && avecPage.has(i.slug) ? i : { ...i, slug: null });

// L'accueil a ses propres corps de carte (maquette du 3 octobre). La
// coquille .item-card ne change pas : les ecouteurs delegues (survol
// bande-annonce, clic modale, favoris) et le lien interne vers la fiche
// restent exactement les memes. Le Top 25, lui, devient une ligne de
// classement : un <a> entier, pas une carte.
// carteDe() dans le <script> plus bas doit rester son jumeau exact, sinon
// l'accueil changerait d'allure au premier rechargement client.
const carte = (i: any, dom: string, rang?: number) =>
  variant === "rang" ? renderRangTop(lisible(i), dom, rang)
  : variant === "slider" ? renderCardDerniers(lisible(i), dom)
  : renderCard(lisible(i), dom, rang);

// Correspondance STRICTEMENT identique a loadSection() dans le <script>.
// Toute divergence se verrait a l'oeil : les cartes changeraient au
// chargement de la page.
let cartes = "";
try {
  if (source === "anime" || source === "games") {
    const it = await feed(source, { status: "released", limit: "150", orderBy: "date" });
    cartes = (limit ? it.slice(0, limit) : it).map((i: any) => carte(i, source)).join("");
  } else if (source === "anime-upcoming" || source === "games-upcoming") {
    const dom = source === "anime-upcoming" ? "anime" : "games";
    const it = await feed(dom, { status: "upcoming", limit: "300", orderBy: "date" });
    cartes = (limit ? it.slice(0, limit) : it).map((i: any) => carte(i, dom)).join("");
  } else if (source === "top-anime" || source === "top-games") {
    const dom = source === "top-anime" ? "anime" : "games";
    const it = await feed(dom, { status: "released", limit: "25" });
    cartes = (limit ? it.slice(0, limit) : it).map((i: any, k: number) => carte(i, dom, k + 1)).join("");
  } else {
    const [a, g] = await Promise.all([
      feed("anime", { status: "upcoming", limit: "50", orderBy: "date" }),
      feed("games", { status: "upcoming", limit: "50", orderBy: "date" }),
    ]);
    const tout = [
      ...a.map((i: any) => ({ ...i, _d: "anime" })),
      ...g.map((i: any) => ({ ...i, _d: "games" })),
    ].sort((x: any, y: any) =>
      (x.releaseDate ? new Date(x.releaseDate).getTime() : 0) -
      (y.releaseDate ? new Date(y.releaseDate).getTime() : 0));
    cartes = (limit ? tout.slice(0, limit) : tout).map((i: any) => carte(i, i._d)).join("");
  }
} catch (e) {
  // Echec volontaire : construire la page sans ces liens reproduirait
  // silencieusement le bug qu'on corrige.
  throw new Error(`SectionBlock (${source}) : rendu au build impossible — ${e}`);
}
---

<section class="section-block container" data-source={source} data-limit={limit}
         data-variant={variant}
         data-taille={variant === "slider" ? (taille || "basse") : undefined}
         data-duree={variant === "slider" ? String(duree || 6000) : undefined}
         data-decal={variant === "slider" ? String(decal || 0) : undefined}>
  <div class="section-head">
    <h2>{title}</h2>
    {kinds ? (
      <div class="kind-pills" data-mode={kinds === "upcoming" ? "upcoming" : "anime"}>
        {kinds === "upcoming" ? (
          <>
            <button type="button" class="kind-pill on" data-kind="anime">Série <span class="kn"></span></button>
            <button type="button" class="kind-pill" data-kind="film">Film <span class="kn"></span></button>
          </>
        ) : (
          <>
            <button type="button" class="kind-pill on" data-kind="anime">Anime <span class="kn"></span></button>
            <button type="button" class="kind-pill" data-kind="film">Film <span class="kn"></span></button>
          </>
        )}
      </div>
    ) : (href && <a class="see-more" href={href}>Voir plus</a>)}
  </div>
  {variant === "slider" ? (
    <div class="sl">
      <div class="items-row sl-track" set:html={cartes || '<p class="section-loading">Chargement…</p>'}
           tabindex="0"></div>
      <button type="button" class="sl-fl g" aria-label="Précédent">‹</button>
      <button type="button" class="sl-fl d" aria-label="Suivant">›</button>
      <div class="sl-pied"><span class="sl-cpt"></span></div>
    </div>
  ) : (
    <div class="items-row" set:html={cartes || '<p class="section-loading">Chargement…</p>'}></div>
  )}
</section>

<div class="detail-modal" id="detailModal">
  <div class="detail-backdrop"></div>
  <div class="detail-content">
    <button class="detail-close" aria-label="Fermer">✕</button>
    <div class="detail-inner" id="detailInner"></div>
  </div>
</div>

<script>
import { getAnimeItems, getGameItems, getFeedAnime, getFeedGames, getItemDetail, postVote, displayTitle } from "../lib/api";
import { monterFenetre } from "../lib/slider";
import type { ContentItem } from "../lib/api";
// Cartes et fiche (modal) : une seule source, lib/fiche. La page de l'item
// (/games/slug/, /anime/slug/) rend la meme fiche.
import { renderCard, renderCardDerniers, renderRangTop, ficheHtml, brancherFiche } from "../lib/fiche";
// Le modal a la couleur de sa jaquette (Vitre · Cameleon, maquette « B » validee le 11 octobre 2026) : les
// couleurs --ep-* posees sur le modal seul (lib/teinte), comme la page de l'item. A l'ouverture, il fige la
// couleur qu'a la page a cet instant (les pages qui changent de couleur toutes les 6 s ne la changent pas
// pendant la lecture) ; sans teinte de jaquette, il la garde. Couleur deja connue : posee d'emblee ;
// calculee apres coup : en fondu (ep-pret).
import { teinteImage, teinter, deteinter, couleurs, poser } from "../lib/teinte";
var gnOuverture = 0, gnPage: Record<string, string> | null = null;
function figerModal(m: HTMLElement) { gnPage = couleurs(document.documentElement); poser(m, gnPage); }
function teinterModal(m: HTMLElement, cover: string | null | undefined) {
  var n = ++gnOuverture, tout = true;
  var fin = function(h: number | null) {
    if (n !== gnOuverture || !m.classList.contains("active")) return;   // une autre fiche a pris la place
    if (!tout) m.classList.add("ep-pret");
    if (h !== null) teinter(m, h); else if (gnPage) poser(m, gnPage);
  };
  if (!cover) { fin(null); return; }
  teinteImage(cover, fin);
  tout = false;
}

// Jumeau exact de carte() dans le frontmatter. Sans lui, loadSection()
// redessinerait des cartes de catalogue par-dessus la mise en page de
// l'accueil des le premier rechargement.
function carteDe(section, item, domain, rang) {
  var v = section && section.dataset ? section.dataset.variant : "";
  if (v === "rang") return renderRangTop(item, domain, rang);
  if (v === "slider") return renderCardDerniers(item, domain);
  return renderCard(item, domain, rang);
}

// Les cartes et la fiche viennent de lib/fiche (importees plus haut) : ce
// <script> en gardait une copie mot pour mot (renderCard, dateBox, platChips,
// detailPlatforms…), qu'il fallait corriger deux fois. Retirees le 10 octobre 2026.

var hoverTimer = null;
var activeCard = null;
var slideInterval = null;

function killHover(card) {
  if (hoverTimer) { clearTimeout(hoverTimer); hoverTimer = null; }
  if (slideInterval) { clearInterval(slideInterval); slideInterval = null; }
  var vid = card.querySelector(".item-hover-video");
  if (vid) { vid.innerHTML = ""; vid.classList.remove("active"); }
  var slides = card.querySelector(".item-hover-slides");
  if (slides) { slides.innerHTML = ""; slides.classList.remove("active"); }
  if (activeCard === card) activeCard = null;
}

function setupHoverTrailer() {
  document.addEventListener("mouseover", function(e) {
    var card = (e.target as HTMLElement).closest(".item-card");
    if (!card || card === activeCard) return;
    if (activeCard) killHover(activeCard);
    var videoId = (card as HTMLElement).dataset.yt;
    var screensRaw = (card as HTMLElement).dataset.screens;
    if (!videoId && !screensRaw) return;
    activeCard = card;
    if (videoId) {
      var box = card.querySelector(".item-hover-video");
      if (!box) return;
      hoverTimer = setTimeout(function() {
        box.innerHTML = '<iframe src="https://www.youtube.com/embed/' + videoId + '?autoplay=1&mute=1&controls=0&loop=1&playlist=' + videoId + '&modestbranding=1&rel=0&showinfo=0&iv_load_policy=3&disablekb=1" frameborder="0" allow="autoplay" allowfullscreen></iframe>';
        box.classList.add("active");
      }, 500);
    } else if (screensRaw) {
      var sbox = card.querySelector(".item-hover-slides");
      if (!sbox) return;
      try {
        var screens = JSON.parse(screensRaw);
        if (screens.length === 0) return;
        var idx = 0;
        sbox.innerHTML = '<img src="' + screens[0] + '" alt="screenshot" />';
        sbox.classList.add("active");
        if (screens.length > 1) {
          slideInterval = setInterval(function() {
            idx = (idx + 1) % screens.length;
            sbox.innerHTML = '<img src="' + screens[idx] + '" alt="screenshot" />';
          }, 2000);
        }
      } catch(ex) {}
    }
  });

  document.addEventListener("mouseout", function(e) {
    var card = (e.target as HTMLElement).closest(".item-card");
    if (!card) return;
    var related = (e as MouseEvent).relatedTarget;
    if (related && card.contains(related as Node)) return;
    killHover(card);
  });
}

function setupDetailModal() {
  var modal = document.getElementById("detailModal");
  var inner = document.getElementById("detailInner");
  var backdrop = modal ? modal.querySelector(".detail-backdrop") : null;
  var closeBtn = modal ? modal.querySelector(".detail-close") : null;

  // URL de la fiche a pousser dans l'historique, posee par le clic sur un titre.
  // Les autres points d'entree (tiroirs favoris/notifs, liens #item- des emails)
  // la laissent nulle : pour eux l'URL ne bouge pas.
  var urlFiche: string | null = null;
  (window as any).__gnUrlFiche = function(u: string | null) { urlFiche = u; };

  // Fermeture reelle du modal, sans toucher a l'historique.
  function fermerModal() {
    if (!modal || !inner) return;
    inner.innerHTML = "";
    modal.classList.remove("active");
    gnOuverture++;
    gnPage = null;
    modal.classList.remove("ep-pret");
    deteinter(modal as HTMLElement);
    document.body.style.overflow = "";
    // Re-ouvrir le drawer d'ou on venait (notif cloche, favoris, ou notif menu)
    var w = (window as any);
    if (w.__reopenNotifDrawer) {
      w.__reopenNotifDrawer = false;
      if (typeof w.__openNotifDrawer === "function") w.__openNotifDrawer();
    } else if (w.__reopenFavDrawer) {
      w.__reopenFavDrawer = false;
      if (typeof w.__openFavDrawer === "function") w.__openFavDrawer();
    } else if (w.__reopenNotifPageDrawer) {
      w.__reopenNotifPageDrawer = false;
      if (typeof w.__openNotifPageDrawer === "function") w.__openNotifPageDrawer();
    }
  }

  // Action utilisateur (fond, croix, Echap). Si une URL de fiche a ete poussee,
  // on revient en arriere et c'est popstate qui fermera — sinon on fermerait
  // deux fois et l'URL resterait bloquee sur la fiche.
  function close() {
    if (!modal || !modal.classList.contains("active")) return;
    if (history.state && (history.state as any).gnModal) history.back();
    else fermerModal();
  }

  // Bouton Retour du navigateur : ferme sans retoucher l'historique.
  window.addEventListener("popstate", function() {
    if (modal && modal.classList.contains("active")) fermerModal();
  });

  if (backdrop) backdrop.addEventListener("click", close);
  if (closeBtn) closeBtn.addEventListener("click", close);
  document.addEventListener("keydown", function(e) { if (e.key === "Escape") close(); });

  // Expose la fonction d'ouverture globale (pour drawer Favoris/Notifs)
  (window as any).__openItemModal = async function(domain: string, id: string) {
    if (!modal || !inner) return;
    if (activeCard) killHover(activeCard);
    // L'URL suit l'item tant que le modal est ouvert. replaceState si un modal
    // etait deja ouvert : passer de fiche en fiche ne doit pas empiler dix
    // entrees d'historique et rendre le bouton Retour inutilisable.
    if (urlFiche && location.pathname !== urlFiche) {
      var dejaOuvert = modal.classList.contains("active") && history.state && (history.state as any).gnModal;
      if (dejaOuvert) history.replaceState({ gnModal: true }, "", urlFiche);
      else history.pushState({ gnModal: true }, "", urlFiche);
    }
    urlFiche = null;
    if (!modal.classList.contains("active")) figerModal(modal as HTMLElement);
    modal.classList.add("active");
    document.body.style.overflow = "hidden";
    inner.innerHTML = '<p class="detail-loading">Chargement…</p>';

    try {
      var item = await getItemDetail(domain as any, id);
      // Meme fiche que la page de l'item (lib/fiche : ficheHtml, brancherFiche).
      inner.innerHTML = ficheHtml(item, domain, "modal");
      brancherFiche(inner, domain, id);
      teinterModal(modal as HTMLElement, item && item.cover);
    } catch (err) {
      inner.innerHTML = '<p class="detail-loading">Erreur de chargement.</p>';
    }
  };

  // Detection tactile : sur mobile, clic carte = trailer ; sur desktop = modale
  var GN_isTouch = ("ontouchstart" in window) || navigator.maxTouchPoints > 0;
  // Handler click : desktop ouvre la modale, mobile lance le trailer
  document.addEventListener("click", function(e) {
    // Le titre est un vrai lien : on annule la navigation AVANT les sorties
    // ci-dessous, pour que le modal s'ouvre au lieu de changer de page.
    if ((e.target as HTMLElement).closest("a.item-link")) e.preventDefault();
    // L'URL doit suivre l'item quel que soit l'endroit clique sur la carte : le
    // titre est le seul <a> (pour Google), mais le modal s'ouvre aussi depuis la
    // jaquette. Le slug est donc lu sur la carte, pas sur le lien.
    var carteUrl = (e.target as HTMLElement).closest(".item-card") as HTMLElement | null;
    if (carteUrl && typeof (window as any).__gnUrlFiche === "function") {
      var sl = carteUrl.getAttribute("data-slug");
      var dm = carteUrl.getAttribute("data-domain") || "anime";
      (window as any).__gnUrlFiche(
        sl ? "/" + (dm.indexOf("anime") !== -1 ? "anime" : "games") + "/" + sl + "/" : null
      );
    }
    if ((e.target as HTMLElement).closest(".trailer-band")) return; // bande geree separement
    if ((e.target as HTMLElement).closest(".fav-heart")) return;
    var card = (e.target as HTMLElement).closest(".item-card");
    if (!card) {
      // Clic ailleurs -> ferme le trailer (mobile)
      if (GN_isTouch && activeCard) killHover(activeCard);
      return;
    }
    var id = (card as HTMLElement).dataset.id;
    var domain = (card as HTMLElement).dataset.domain;
    if (!id || !domain) return;
    // Au doigt, un appui sur une carte lance la bande-annonce, et c'est ensuite
    // une bande du trailer qui ouvre la fiche. Sur l'accueil ces bandes
    // n'existent plus : sans cette exception, une carte avec bande-annonce y
    // devient inatteignable au doigt — le premier appui lance la video, les
    // suivants ne font plus rien. Sur l'accueil, l'appui ouvre donc la fiche,
    // ce qui est aussi la regle demandee : « si je clique, j'ouvre le modal ».
    // Le Top 25 (.acc-bas) aussi, depuis le 6 octobre 2026 : ses lignes n'ont pas
    // de bandes et la video y est masquee au telephone, l'appui ne faisait rien.
    if (GN_isTouch && !(card as HTMLElement).closest(".acc-haut, .acc-bas")) {
      // MOBILE : clic carte = lance le trailer (le glow des bandes sert d'indice pour la modale)
      if (activeCard !== card) {
        var videoId = (card as HTMLElement).dataset.yt;
        if (videoId) {
          if (activeCard) killHover(activeCard);
          var box = card.querySelector(".item-hover-video");
          if (box) {
            box.innerHTML = '<iframe src="https://www.youtube.com/embed/' + videoId + '?autoplay=1&mute=1&controls=0&loop=1&playlist=' + videoId + '&modestbranding=1&rel=0&showinfo=0&iv_load_policy=3&disablekb=1" frameborder="0" allow="autoplay" allowfullscreen></iframe>';
            box.classList.add("active");
            activeCard = card;
          }
        } else {
          // Pas de trailer sur cette carte -> ouvre directement la modale
          (window as any).__openItemModal(domain, id);
        }
      }
    } else {
      // DESKTOP : clic carte = modale
      (window as any).__openItemModal(domain, id);
    }
  });
  // Scroll -> ferme le trailer (mobile)
  window.addEventListener("scroll", function() {
    if (GN_isTouch && activeCard) killHover(activeCard);
  }, { passive: true });
  // Clic sur les bandes du trailer -> ouvre la modale
  document.addEventListener("click", function(e) {
    var band = (e.target as HTMLElement).closest(".trailer-band");
    if (!band) return;
    e.stopPropagation();
    var id = (band as HTMLElement).dataset.bandId;
    var domain = (band as HTMLElement).dataset.bandDomain;
    if (id && domain) (window as any).__openItemModal(domain, id);
  });
}

function updateCountdowns() {
  document.querySelectorAll(".item-countdown").forEach(function(el) {
    var rel = new Date((el as HTMLElement).dataset.release);
    var ms = rel.getTime() - Date.now();
    var timer = el.querySelector(".countdown-timer");
    if (!timer) return;
    if (ms <= 0) { timer.textContent = "Disponible !"; el.classList.add("countdown-done"); return; }
    var days = Math.floor(ms / 86400000);
    var hrs = Math.floor(ms / 3600000);
    if (days >= 2) { timer.textContent = days + "j " + (hrs % 24) + "h"; }
    else { timer.textContent = hrs + "h " + Math.floor((ms%3600000)/60000) + "m " + Math.floor((ms%60000)/1000) + "s"; }
  });
}

async function loadSection(section) {
  var source = section.dataset.source;
  var limit = section.dataset.limit ? parseInt(section.dataset.limit) : undefined;
  var row = section.querySelector(".items-row");
  if (!row) return;
  try {
    var items;
    var domain = "anime";
    var isTop = false;
    if (source === "anime") {
      items = await getFeedAnime({ status: "released", limit: 150, orderBy: "date" }); domain = "anime";
    } else if (source === "games") {
      items = await getFeedGames({ status: "released", limit: 150, orderBy: "date" }); domain = "games";
    } else if (source === "anime-upcoming") {
      items = await getFeedAnime({ status: "upcoming", limit: 300, orderBy: "date" }); domain = "anime";
    } else if (source === "games-upcoming") {
      items = await getFeedGames({ status: "upcoming", limit: 300, orderBy: "date" }); domain = "games";
    } else if (source === "top-anime") {
      items = await getFeedAnime({ status: "released", limit: 25 }); domain = "anime"; isTop = true;
    } else if (source === "top-games") {
      items = await getFeedGames({ status: "released", limit: 25 }); domain = "games"; isTop = true;
    } else {
      var a = await getFeedAnime({ status: "upcoming", limit: 50, orderBy: "date" });
      var g = await getFeedGames({ status: "upcoming", limit: 50, orderBy: "date" });
      var all = []
        .concat(a.map(function(i) { return Object.assign({}, i, { _d: "anime" }); }))
        .concat(g.map(function(i) { return Object.assign({}, i, { _d: "games" }); }))
        .sort(function(x, y) {
          var at = x.releaseDate ? new Date(x.releaseDate).getTime() : 0;
          var bt = y.releaseDate ? new Date(y.releaseDate).getTime() : 0;
          return at - bt;
        });
      if (limit) all.splice(limit);
      row.innerHTML = all.length ? all.map(function(i) { return carteDe(section, i, i._d); }).join("") : '<p class="section-empty">Aucun contenu.</p>';
      return;
    }
    if (limit) items = items.slice(0, limit);
    row.innerHTML = items.length
      ? items.map(function(i, idx) { return carteDe(section, i, domain, isTop ? idx + 1 : undefined); }).join("")
      : '<p class="section-empty">Aucun contenu pour le moment.</p>';
  } catch (err) {
    console.error("Erreur " + source + ":", err);
    // Les cartes rendues au build sont deja la : on n'efface que s'il n'y a
    // rien a perdre. Sans ce garde, une API momentanement muette effacerait
    // du contenu parfaitement valide.
    if (!row.querySelector(".item-card")) {
      row.innerHTML = '<p class="section-empty">Impossible de charger les données.</p>';
    }
  }
}

document.addEventListener("applyFilters", async function(e) {
  var extra = (e as CustomEvent).detail;
  var sections = document.querySelectorAll(".section-block[data-source]");
  for (var i = 0; i < sections.length; i++) {
    var section = sections[i] as HTMLElement;
    var source = section.dataset.source;
    if (source.startsWith("top-")) continue;
    var row = section.querySelector(".items-row");
    if (!row) continue;
    var items;
    var domain = "anime";
    // Parse les filtres de la string extra (genre/platform/search/dates)
    var fp = new URLSearchParams(extra || "");
    var fo = {
      genre: fp.get("genre") || undefined,
      platform: fp.get("platform") || undefined,
      search: fp.get("search") || undefined,
      releasedAfter: fp.get("releasedAfter") || undefined,
      releasedBefore: fp.get("releasedBefore") || undefined,
    };
    try {
      // Utilise /feed/* (fenetre glissante 2 ans + applyFeedFilters) comme le chargement normal
      if (source === "anime") { items = await getFeedAnime(Object.assign({ status: "released", limit: 150, orderBy: "date" }, fo)); domain = "anime"; }
      else if (source === "games") { items = await getFeedGames(Object.assign({ status: "released", limit: 150, orderBy: "date" }, fo)); domain = "games"; }
      else if (source === "anime-upcoming") { items = await getFeedAnime(Object.assign({ status: "upcoming", limit: 300, orderBy: "date" }, fo)); domain = "anime"; }
      else if (source === "games-upcoming") { items = await getFeedGames(Object.assign({ status: "upcoming", limit: 300, orderBy: "date" }, fo)); domain = "games"; }
      else { continue; }
      row.innerHTML = items.length
        ? items.map(function(it) { return carteDe(section, it, domain); }).join("")
        : '<p class="section-empty">Aucun résultat pour ces filtres.</p>';
    } catch (err) { row.innerHTML = '<p class="section-empty">Erreur.</p>'; }
  }
});

// Fenetres glissantes de l'accueil. On ne monte que les blocs rendus par ce
// composant : « Cette semaine » monte la sienne, ses cartes arrivant plus tard.
var gnFenetres = new Map();
document.querySelectorAll('.section-block[data-variant="slider"][data-source]').forEach(function(b) {
  var sl = (b as HTMLElement).querySelector(".sl") as HTMLElement | null;
  if (!sl) return;
  var api = monterFenetre(sl, {
    duree: Number((b as HTMLElement).dataset.duree || 6000),
    decal: Number((b as HTMLElement).dataset.decal || 0),
  });
  if (api) gnFenetres.set(b, api);
});

document.querySelectorAll(".section-block[data-source]").forEach(function(s) {
  // loadSection reecrit .items-row : la fenetre doit recompter ses cartes,
  // sinon elle continue de pointer sur celles du build.
  loadSection(s).then(function() {
    var f = gnFenetres.get(s);
    if (f) f.recompter(false);
  });
});
setInterval(updateCountdowns, 1000);
setupHoverTrailer();
setupDetailModal();
setupFavorites();
autoOpenFromHash();
// SESSION 12.7+: ouvre automatiquement le modal d'un item si l'URL contient #item-{id}
// Utilisé pour les CTA "Voir la fiche" / "Découvrir" des emails Premium.
function autoOpenFromHash() {
  // Deux formes acceptees : #item-123 (ancienne, sans type) et
  // #item-anime-123 / #item-game-123 (nouvelle). Les mails deja envoyes
  // continuent de fonctionner.
  var match = window.location.hash.match(/^#item-(?:(anime|game)-)?(\d+)$/);
  if (!match) return;
  var typeUrl = match[1];
  var itemId = match[2];
  // On appelle directement l'API plutot que de chercher une carte dans le DOM :
  // la page n'affiche que 200 items, donc un titre plus bas dans le classement
  // ou masque par un sous-onglet n'avait aucune carte a cliquer — et le lien
  // "Voir la fiche" des emails tombait dans le vide.
  var dom = typeUrl === "game" ? "games"
    : typeUrl === "anime" ? "anime"
    : (window.location.pathname.indexOf("/games") === 0 ? "games" : "anime");
  var ouvrir = function() {
    var fn = (window as any).__openItemModal;
    if (typeof fn === "function") {
      fn(dom, itemId);
      window.scrollTo({ top: 0, behavior: "smooth" });
      return true;
    }
    return false;
  };
  if (ouvrir()) return;
  // Le script du modal peut ne pas etre encore initialise au chargement.
  var essais = 0;
  var attendre = function() {
    essais++;
    if (ouvrir()) return;
    if (essais < 25) setTimeout(attendre, 200);
  };
  setTimeout(attendre, 200);
}
window.addEventListener("hashchange", autoOpenFromHash);

function setupFavorites() {
  var favApiBase = "/api";
  var favCache = {};
  var isLoggedIn = false;

  function hideAllHearts() {
    document.body.classList.remove("is-authenticated");
  }

  function showAllHearts() {
    document.body.classList.add("is-authenticated");
  }

  async function checkAuthAndLoadFavorites() {
    hideAllHearts();
    try {
      var authRes = await fetch(favApiBase + "/auth/me", { credentials: "include", headers: { Accept: "application/json" } });
      if (authRes.status === 401 || !authRes.ok) {
        isLoggedIn = false;
        hideAllHearts();
        return;
      }
      isLoggedIn = true;
      var favRes = await fetch(favApiBase + "/favorites/", { credentials: "include", headers: { Accept: "application/json" } });
      if (favRes.ok) {
        var data = await favRes.json();
        if (data.items) {
          data.items.forEach(function(f) { favCache[f.itemType + ":" + f.itemId] = true; });
        }
      }
      updateAllHearts();
      showAllHearts();
    } catch(e) { isLoggedIn = false; hideAllHearts(); }
  }

  function updateAllHearts() {
    document.querySelectorAll(".fav-heart").forEach(function(btn) {
      var key = (btn.dataset.favType === "anime" ? "anime" : "game") + ":" + btn.dataset.favId;
      if (favCache[key]) { btn.textContent = "\u2665"; btn.classList.add("is-fav"); }
      else { btn.textContent = "\u2661"; btn.classList.remove("is-fav"); }
    });
  }

  document.addEventListener("click", async function(e) {
    var btn = e.target.closest(".fav-heart");
    if (!btn) return;
    e.stopPropagation();
    e.preventDefault();
    if (!isLoggedIn) { window.location.href = "/signin"; return; }
    var id = btn.dataset.favId;
    var type = btn.dataset.favType === "anime" ? "anime" : "game";
    var key = type + ":" + id;
    var isFav = !!favCache[key];
    try {
      if (isFav) {
        var res = await fetch(favApiBase + "/favorites/" + type + "/" + id, { method: "DELETE", credentials: "include", headers: { Accept: "application/json" } });
        if (res.ok) { delete favCache[key]; updateAllHearts(); }
      } else {
        var res2 = await fetch(favApiBase + "/favorites/", { method: "POST", credentials: "include", headers: { "Content-Type": "application/json", Accept: "application/json" }, body: JSON.stringify({ itemType: type, itemId: Number(id) }) });
        if (res2.ok) { favCache[key] = true; updateAllHearts(); }
        else if (res2.status === 401) { window.location.href = "/signin"; }
      }
    } catch(err) { console.error("Favori error:", err); }
  });

  checkAuthAndLoadFavorites();
  document.addEventListener("favChanged", function(e) { var d = e.detail; if (d && d.action === "remove") { var key = (d.type === "anime" ? "anime" : "game") + ":" + d.id; delete favCache[key]; updateAllHearts(); } else { checkAuthAndLoadFavorites(); } });
}
</script>

<script>
// ── Onglets Anime / Film (session 33 ; « Sorti JP » retire le 10 octobre 2026) ──
// Filtrage cote client sur les items deja charges : aucun appel API en plus.
// Decoupage EXCLUSIF par le format. Un anime sorti sans plateforme EU reste
// dans "Anime" ou "Film" : sa carte affiche « Sortie Japon · EU a confirmer ».
(function () {
  function kindOf(card) {
    return (card.getAttribute("data-format") || "").toUpperCase() === "MOVIE" ? "film" : "anime";
  }

  function apply(section, kind) {
    var cards = section.querySelectorAll(".item-card");
    var counts = { anime: 0, film: 0 };
    for (var i = 0; i < cards.length; i++) {
      var k = kindOf(cards[i]);
      counts[k]++;
      cards[i].style.display = (k === kind) ? "" : "none";
    }
    var pills = section.querySelectorAll(".kind-pill");
    for (var j = 0; j < pills.length; j++) {
      var pk = pills[j].getAttribute("data-kind");
      var n = pills[j].querySelector(".kn");
      if (n) n.textContent = counts[pk];
      pills[j].classList.toggle("on", pk === kind);
      pills[j].hidden = counts[pk] === 0;
    }
  }

  function watch() {
    var sections = document.querySelectorAll(".section-block");
    for (var i = 0; i < sections.length; i++) {
      (function (section) {
        if (!section.querySelector(".kind-pills")) return;
        if (section.getAttribute("data-kw")) return;
        section.setAttribute("data-kw", "1");
        section.addEventListener("click", function (e) {
          var b = e.target.closest(".kind-pill");
          if (b) apply(section, b.getAttribute("data-kind"));
        });
        var row = section.querySelector(".items-row");
        if (!row) return;
        new MutationObserver(function () {
          if (row.querySelector(".item-card")) apply(section, "anime");
        }).observe(row, { childList: true });
        if (row.querySelector(".item-card")) apply(section, "anime");
      })(sections[i]);
    }
  }

  watch();
  document.addEventListener("astro:page-load", watch);
})();
</script>
